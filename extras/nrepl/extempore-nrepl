#!/usr/bin/env python3
"""Command-line client for Extempore's nREPL server (usage:
docs/src/content/docs/guides/nrepl.md).

`--editor` puts everything on stdout and exits 0 because helix shows a failed
command's stderr in its status line, not its popup. Standard library only; the
tests in tests/nrepl import this file for its bencode codec and Client.
"""

from __future__ import annotations

import argparse
import itertools
import os
import socket
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Iterator

DEFAULT_PORT = 7888

# --- bencode ---------------------------------------------------------------


def bencode(value: object) -> bytes:
    if isinstance(value, bool):
        raise TypeError("bencode has no booleans")
    if isinstance(value, int):
        return b"i%de" % value
    if isinstance(value, str):
        value = value.encode()
    if isinstance(value, bytes):
        return b"%d:%s" % (len(value), value)
    if isinstance(value, (list, tuple)):
        return b"l" + b"".join(bencode(v) for v in value) + b"e"
    if isinstance(value, dict):
        items = sorted(
            (k.encode() if isinstance(k, str) else k, v) for k, v in value.items()
        )
        return b"d" + b"".join(bencode(k) + bencode(v) for k, v in items) + b"e"
    raise TypeError(f"can't bencode {type(value).__name__}")


class Incomplete(Exception):
    """The buffer ends before the value does."""


def bdecode(data: bytes, pos: int = 0) -> tuple[object, int]:
    """Decode one value at pos; return it and the position after it.

    Byte strings come back as str where they are valid UTF-8."""
    if pos >= len(data):
        raise Incomplete
    c = data[pos : pos + 1]
    if c == b"i":
        end = data.find(b"e", pos)
        if end < 0:
            raise Incomplete
        return int(data[pos + 1 : end]), end + 1
    if c.isdigit():
        colon = data.find(b":", pos)
        if colon < 0:
            raise Incomplete
        n = int(data[pos:colon])
        start, end = colon + 1, colon + 1 + n
        if end > len(data):
            raise Incomplete
        raw = data[start:end]
        try:
            return raw.decode(), end
        except UnicodeDecodeError:
            return raw, end
    if c in (b"l", b"d"):
        items: list[object] = []
        pos += 1
        while True:
            if pos >= len(data):
                raise Incomplete
            if data[pos : pos + 1] == b"e":
                pos += 1
                break
            item, pos = bdecode(data, pos)
            items.append(item)
        if c == b"l":
            return items, pos
        return dict(zip(items[::2], items[1::2])), pos
    raise ValueError(f"bad bencode at byte {pos}: {c!r}")


# --- connection ------------------------------------------------------------


class Client:
    """One connection to the server. Requests get ids; responses to other
    requests are kept until asked for."""

    def __init__(
        self,
        host: str = "127.0.0.1",
        port: int = DEFAULT_PORT,
        timeout: float | None = None,
    ):
        self.sock = socket.create_connection((host, port), timeout=timeout)
        self.buffer = b""
        self.pending: list[dict] = []
        self.ids = itertools.count(1)

    def close(self) -> None:
        self.sock.close()

    def __enter__(self) -> Client:
        return self

    def __exit__(self, *_: object) -> None:
        self.close()

    def send(self, **msg: object) -> str:
        msg.setdefault("id", f"c{next(self.ids)}")
        self.sock.sendall(bencode(msg))
        return str(msg["id"])

    def read(self) -> dict:
        """The next response, whichever request it answers."""
        if self.pending:
            return self.pending.pop(0)
        while True:
            try:
                msg, end = bdecode(self.buffer)
                self.buffer = self.buffer[end:]
                assert isinstance(msg, dict)
                return msg
            except Incomplete:
                chunk = self.sock.recv(65536)
                if not chunk:
                    raise ConnectionError("extempore closed the connection") from None
                self.buffer += chunk

    def responses(self, id: str) -> Iterator[dict]:
        """Responses to request id, up to and including its done."""
        kept: list[dict] = []
        try:
            while True:
                msg = self.read()
                if msg.get("id") != id:
                    kept.append(msg)
                    continue
                yield msg
                if "done" in msg.get("status", []):
                    return
        finally:
            self.pending = kept + self.pending

    def request(self, **msg: object) -> list[dict]:
        return list(self.responses(self.send(**msg)))


# --- finding the form at a position ----------------------------------------


def top_level_forms(text: str) -> Iterator[tuple[int, int]]:
    """(start, end) offsets of each top-level list, skipping strings, comments
    and character literals. An unterminated last form runs to the end."""
    i, n, depth, start = 0, len(text), 0, 0
    while i < n:
        c = text[i]
        if c == ";":
            nl = text.find("\n", i)
            i = n if nl < 0 else nl
        elif c == '"':
            i += 1
            while i < n and text[i] != '"':
                i += 2 if text[i] == "\\" else 1
        elif text.startswith("#|", i):
            close = text.find("|#", i + 2)
            i = n if close < 0 else close + 1
        elif text.startswith("#\\", i):
            i += 2  # the character after #\ is never a delimiter
        elif c == "(":
            if depth == 0:
                start = i
            depth += 1
        elif c == ")" and depth > 0:
            depth -= 1
            if depth == 0:
                yield start, i + 1
        i += 1
    if depth > 0:
        yield start, n


def offset_of(text: str, line: int, column: int) -> int:
    """Offset of 1-based line and column."""
    lines = text.split("\n")
    line = max(1, min(line, len(lines)))
    return sum(len(l) + 1 for l in lines[: line - 1]) + min(
        max(column, 1) - 1, len(lines[line - 1])
    )


def form_at(text: str, line: int, column: int) -> tuple[str, int] | None:
    """The top-level form at line and column (enclosing it, else the nearest
    before it, else the first after it) and the line it starts on."""
    offset = offset_of(text, line, column)
    forms = list(top_level_forms(text))
    if not forms:
        return None
    before = [f for f in forms if f[0] <= offset]
    start, end = next(
        (f for f in forms if f[0] <= offset < f[1]), before[-1] if before else forms[0]
    )
    return text[start:end], text.count("\n", 0, start) + 1


# --- the command line ------------------------------------------------------


def find_port(given: int | None, near: Path | None) -> int:
    if given is not None:
        return given
    if os.environ.get("EXTEMPORE_NREPL_PORT"):
        return int(os.environ["EXTEMPORE_NREPL_PORT"])
    start = (near.parent if near else Path.cwd()).resolve()
    for d in (start, *start.parents):
        f = d / ".nrepl-port"
        if f.is_file():
            return int(f.read_text().strip())
    return DEFAULT_PORT


@dataclass
class Result:
    out: list[str] = field(default_factory=list)
    values: list[str] = field(default_factory=list)
    err: list[str] = field(default_factory=list)
    status: set[str] = field(default_factory=set)


def collect(responses: Iterator[dict]) -> Result:
    result = Result()
    for msg in responses:
        if "out" in msg:
            result.out.append(msg["out"])
        if "value" in msg:
            result.values.append(msg["value"])
        if "err" in msg:
            result.err.append(msg["err"])
        result.status.update(msg.get("status", []))
    return result


def wait_for_save(file: Path, timeout: float = 1.0) -> None:
    """Wait until file was written a moment ago and has stopped changing. An
    editor that saves asynchronously (helix's :write) may run this command
    before the save it queued just ahead of it has landed, or while it is
    still writing."""
    started = time.time()
    last = None
    while time.time() - started < timeout:
        try:
            st = file.stat()
            now = (st.st_mtime_ns, st.st_size)
            if st.st_mtime >= started - 0.25 and now == last:
                return
            last = now
        except FileNotFoundError:
            last = None
        time.sleep(0.03)


def cmd_eval(args: argparse.Namespace) -> int:
    file = Path(args.file) if args.file else None
    msg: dict[str, object] = {"op": "eval"}
    if file and args.line:
        if args.wait_for_save:
            wait_for_save(file)
        text = file.read_text()
        found = form_at(text, args.line, args.column or 1)
        if not found:
            return report(args, error=f"no form in {file}\n")
        msg["code"], msg["line"] = found
    elif args.code is not None:
        msg["code"] = args.code
    else:
        msg["code"] = sys.stdin.read()
    if file:
        msg["file"] = str(file.resolve())
    port = find_port(args.port, file)
    try:
        with Client(args.host, port) as client:
            result = collect(client.responses(client.send(**msg)))
    except OSError as e:
        return report(
            args,
            error=f"can't reach extempore's nREPL server at {args.host}:{port} ({e})\n",
        )
    return report(args, result=result)


def report(
    args: argparse.Namespace, result: Result | None = None, error: str = ""
) -> int:
    """Print a result. Exit status 1 for an eval error, 2 when there was no
    eval at all; always 0 with --editor."""
    out = sys.stdout
    errout = sys.stdout if args.editor else sys.stderr
    if error:
        errout.write(error)
        return 0 if args.editor else 2
    assert result is not None
    out.write("".join(result.out))
    if result.err:
        errout.write("".join(result.err).strip("\n") + "\n")
    elif "interrupted" in result.status:
        errout.write("interrupted\n")
    else:
        for v in result.values:
            out.write(f"=> {v}\n" if args.editor else f"{v}\n")
    failed = bool(result.err) or bool(
        result.status & {"eval-error", "interrupted", "error"}
    )
    return 0 if args.editor or not failed else 1


def cmd_describe(args: argparse.Namespace) -> int:
    port = find_port(args.port, None)
    with Client(args.host, port) as client:
        (msg,) = client.request(op="describe")
    versions = msg.get("versions", {})
    print(
        f"extempore {versions.get('extempore', {}).get('version-string', '?')} at {args.host}:{port}"
    )
    print("processes:", " ".join(msg.get("aux", {}).get("extempore/processes", [])))
    for op, info in sorted(msg.get("ops", {}).items()):
        print(f"  {op:12} {info.get('doc', '')}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="extempore-nrepl", description=__doc__.split("\n\n")[0]
    )
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int)
    sub = parser.add_subparsers(dest="command", required=True)
    ev = sub.add_parser("eval", help="evaluate code and print the results")
    ev.add_argument("code", nargs="?", help="code to evaluate (default: stdin)")
    ev.add_argument("--file", help="evaluate the form at --line/--column of this file")
    ev.add_argument("--line", type=int)
    ev.add_argument("--column", type=int)
    ev.add_argument("--editor", action="store_true", help="format for an editor popup")
    ev.add_argument(
        "--wait-for-save",
        action="store_true",
        help="wait (up to 1 s) for --file to be written, for editors that save asynchronously",
    )
    ev.set_defaults(func=cmd_eval)
    de = sub.add_parser("describe", help="show the server's version, processes and ops")
    de.set_defaults(func=cmd_describe)
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
