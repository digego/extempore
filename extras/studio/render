#!/usr/bin/env bash
# Render an .xtm file to a WAV file, offline, and describe the result.
#
#   extras/studio/render <file.xtm> <out.wav> <seconds>
#
# Also writes <out>.png (a spectrogram), <out>.mp3 and <out>.log (what
# extempore said). The exit status is 1 if anything in the file raised an error.
set -euo pipefail

if [ $# -lt 3 ]; then
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
fi

root=$(cd "$(dirname "$0")/../.." && pwd)
file=$(realpath "$1")
wav=$(realpath -m "$2")
seconds=$3
log="${wav%.wav}.log"

cd "$root"
status=0
build/extempore render "$file" -o "$wav" --duration "$seconds" >"$log" 2>&1 || status=$?
if [ "$status" -ne 0 ]; then
    echo "PROBLEM: the render had errors --- see $log"
    # xtlang compile errors say "Error"; Scheme errors are lines which start
    # with a semicolon
    grep -n -i -E -B2 -A6 "error|^;" "$log" | head -60 || true
fi
[ -f "$wav" ] || exit 1
ffmpeg -loglevel error -y -i "$wav" -codec:a libmp3lame -q:a 4 "${wav%.wav}.mp3"
"$root/extras/studio/analyse.py" "$wav" --png "${wav%.wav}.png"
exit "$status"
