;;; xtmdoc-export.xtm -- write the docstrings and types of the main libraries as JSON

;; Run by the xtmdoc build target:
;;
;;   extempore exec extras/xtmdoc-export.xtm -- --out=/tmp/xtmdoc.json

(for-each sys:load
          '("libs/core/audio_dsp.xtm"
            "libs/core/instruments.xtm"
            "libs/core/math.xtm"
            "libs/base/base.xtm"
            "libs/core/fft.xtm"
            "libs/core/audiofile.xtm"
            "libs/core/png.xtm"
            "libs/external/glfw3.xtm"
            "libs/core/instruments_ext.xtm"
            "libs/external/webgpu.xtm"))

(xtmdoc-export-caches-to-json (or (sys:cmdarg "out") "xtmdoc.json") #f)
