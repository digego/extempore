;;; tests/studio/api.xtm -- tests for the studio's tracks, parameters and scores

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; Tests run without an audio device, so nothing calls the studio's DSP
;; callback. run_studio does it by hand, which is enough to move the studio's
;; clock on and have it apply the events which have been queued.

;;; Code:

(sys:load "libs/studio/studio.xtm" 'quiet)

(bind-func run_studio
  "run the studio's DSP for some seconds, and return the loudest sample it made"
  (lambda (seconds:double)
    (let ((frames:i64 (convert (* seconds (convert SRf double))))
          (start (now))
          (peak:SAMPLE 0.0)
          (x:SAMPLE 0.0)
          (i:i64 0))
      (dotimes (i frames)
        (set! x (studio_dsp 0.0 (+ start i) 0 null))
        (if (> (fabs x) peak) (set! peak (fabs x)))
        (studio_dsp 0.0 (+ start i) 1 null))
      peak)))

;; a score holds the clock still until score-end, so that queued events and
;; the frames we run line up
(score-begin)

;;;;;;;;;;;;
;; tracks ;;
;;;;;;;;;;;;

(xtmtest-result (track 'bass 'acid) 'bass "track-loads-an-instrument")
(xtmtest-result (studio:track-index 'bass) 0 "the-first-track-is-track-0")
(xtmtest-result (studio:track-instrument 'bass) 'acid "track-knows-its-instrument")
(xtmtest-result (track 'bass 'acid) 'bass "track-can-be-evaluated-again")
(xtmtest-result (studio:track-index 'bass) 0 "and-stays-where-it-was")
(xtmtest-result (track 'lead 'acid 'squelchy) 'lead "track-with-a-preset")
(xtmtest-result (studio:track-index 'lead) 1 "a-second-track")
(xtmtest-result (track 'nope 'no-such-instrument) #f "an-unknown-instrument-is-refused")
(xtmtest-result (list? (member 'squelchy (presets 'bass))) #t "presets-are-listed")

;;;;;;;;;;;;;;;;
;; parameters ;;
;;;;;;;;;;;;;;;;

(xtmtest-result (studio:param-value 'bass 'cutoff) 320.0 "a-parameter-starts-at-its-default")
(ctl 'bass 'cutoff 900 'pan 0.25)
(master 'reverb-size 0.5)
(studio_release)
(run_studio 0.01)
(xtmtest-result (studio:param-value 'bass 'cutoff) 900.0 "ctl-sets-an-instrument-parameter")
(xtmtest-result (studio:param-value 'bass 'pan) 0.25 "ctl-sets-a-mixer-parameter")
(xtmtest-result (studio:param-value 'master 'reverb-size) 0.5 "master-sets-a-master-parameter")
(xtmtest-result (studio:param-value 'lead 'cutoff) 220.0 "the-preset-was-applied")
(xtmtest-result (ctl 'bass 'no-such-parameter 1.0) 'bass "an-unknown-parameter-is-reported-not-fatal")
(xtmtest-result (studio:find-param 'bass 'no-such-parameter) #f "and-is-not-found")

(preset 'bass 'rubber)
(run_studio 0.01)
(xtmtest-result (studio:param-value 'bass 'wave) 1.0 "preset-sets-what-it-names")
(xtmtest-result (studio:param-value 'bass 'tune) 0.0 "and-resets-the-rest-to-their-defaults")

;;;;;;;;;;;
;; notes ;;
;;;;;;;;;;;

(xtmtest-result (< (run_studio 0.2) 0.0001) #t "silence-before-any-note")
(note-on 'bass 36 0.8 0.1)
(xtmtest-result (> (run_studio 0.2) 0.05) #t "a-note-makes-sound")
(run_studio 2.0)
(ctl 'bass 'mute 1.0)
(run_studio 0.1) ;; the mute fades in over a few milliseconds
(note-on 'bass 36 0.8 0.1)
(xtmtest-result (< (run_studio 0.2) 0.0001) #t "a-muted-track-is-silent")
(ctl 'bass 'mute 0.0)
(run_studio 1.0)

;;;;;;;;;;;;;;
;; patterns ;;
;;;;;;;;;;;;;;

(xtmtest-result (studio:resolve-sound 'bass) '(0 . #f) "a-track-name-is-a-sound")
(once (note '(c2 c3)) (sound 'bass))
(xtmtest-result (> (run_studio 0.5) 0.05) #t "a-pattern-plays-its-track")
(run_studio 3.0)

(xtmtest-result (untrack 'lead) 'lead "untrack")
(xtmtest-result (studio:track-index 'lead) #f "the-track-has-gone")
(xtmtest-result (reload 'bass) 'bass "reload-makes-a-new-instance")
(note-on 'bass 36 0.8 0.1)
(xtmtest-result (> (run_studio 0.2) 0.05) #t "which-plays")

;; a track which takes over a slot doesn't inherit the last one's mixer strip
(track 'old 'acid)
(ctl 'old 'mute 1.0 'lpf 300)
(run_studio 0.05)
(untrack 'old)
(track 'new 'acid)
(xtmtest-result (studio:param-value 'new 'mute) 0.0 "a-reused-slot-is-unmuted")
(xtmtest-result (studio:param-value 'new 'lpf) 20000.0 "a-reused-slot-has-a-clean-strip")

;; hush forgets what was queued, and the studio carries on afterwards
(note-on 'bass 36 0.8 0.1)
(hush)
(xtmtest-result (< (run_studio 0.3) 0.01) #t "hush-forgets-queued-notes")
(note-on 'bass 36 0.8 0.1)
(xtmtest-result (> (run_studio 0.2) 0.05) #t "notes-play-again-after-hush")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; a note's own parameters   ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; a pattern's pan and gain belong to its notes, and leave the track's alone
(run_studio 2.0)
(ctl 'bass 'pan 0.5 'gain 1.0)
(once (note '(c2 c3)) (sound 'bass) (pan 0.1) (gain 0.5) (param 'cutoff 700))
(xtmtest-result (> (run_studio 0.6) 0.01) #t "a-pattern-with-pan-and-gain-plays")
(xtmtest-result (studio:param-value 'bass 'pan) 0.5 "its-pan-is-not-the-track's")
(xtmtest-result (studio:param-value 'bass 'gain) 1.0 "nor-is-its-gain")
(xtmtest-result (studio:param-value 'bass 'cutoff) 700.0 "an-instrument-parameter-reaches-the-instrument-too")
(xtmtest-result (studio:find-note-param 'bass 'lpf) (studio:find-param 'bass 'lpf) "the-strip's-filter-is-the-track's")
(run_studio 2.0)

;; note-on can carry parameters, and can hold a note until its note-off
(note-on 'bass 36 0.8 0.1 'cutoff 450)
(run_studio 0.3)
(xtmtest-result (studio:param-value 'bass 'cutoff) 450.0 "note-on-with-a-parameter")
(run_studio 2.0)
(note-on 'bass 36 0.8)
(run_studio 2.0)
(xtmtest-result (> (run_studio 0.2) 0.05) #t "a-note-without-a-length-is-held")
(note-off 'bass 36)
(run_studio 2.0)
(xtmtest-result (< (run_studio 0.2) 0.0001) #t "until-its-note-off")

;;;;;;;;;;;;;;;;;
;; bad samples ;;
;;;;;;;;;;;;;;;;;

;; an instrument whose every sample is not-a-number while `bad` is up
(def-instrument nantest
  "a test instrument which goes wrong on request"
  (params (bad 0.0 "above 0.5: put out not-a-number")))

(bind-func nantest_voice_c
  (lambda (p:SAMPLE*)
    (let ((zero:SAMPLE 0.0)
          (level:SAMPLE 0.125))
      (lambda (v:Voice* out:SAMPLE*)
        (frame_add out (if (> (nantest_bad p) 0.5) (/ zero zero) level))
        (if (< (voice_gate v) 0.5) (voice_done v))
        void))))

(bind-func nantest_make
  (lambda ()
    (let ((inst (inst_make "nantest" 1 (nantest_nparams))))
      (nantest_defaults (inst_params inst))
      (inst_set_voice inst 0 (nantest_voice_c (inst_params inst)))
      inst)))

(run_studio 2.0)
(track 'broken 'nantest)
(ctl 'broken 'bad 1.0 'reverb 0.5 'delay 0.5)
(note-on 'broken 60 0.8 0.2)
(xtmtest-result (< (run_studio 0.5) 0.0001) #t "a-track-putting-out-NaN-is-silenced")
(xtmtest-result (> (studio_track_bad_frames (studio:track-index 'broken)) 0) #t "and-its-bad-frames-are-counted")
(note-on 'bass 36 0.8 0.1)
(xtmtest-result (> (run_studio 0.2) 0.05) #t "and-the-rest-of-the-mix-plays-on")
(run_studio 2.0)
(ctl 'broken 'bad 0.0)
(note-on 'broken 60 0.8 0.2)
(xtmtest-result (> (run_studio 0.2) 0.05) #t "as-does-the-track-once-it-recovers")

;;;;;;;;;;
;; solo ;;
;;;;;;;;;;

;; (the last note went to the delay and the reverb: let them die away)
(run_studio 15.0)
(solo 'bass)
(run_studio 0.1)
(note-on 'new 36 0.8 0.1)
(xtmtest-result (< (run_studio 0.3) 0.0001) #t "a-track-which-isn't-soloed-is-silent")
(note-on 'bass 36 0.8 0.1)
(xtmtest-result (> (run_studio 0.3) 0.05) #t "the-soloed-track-plays")
(unsolo)
(run_studio 2.0)
(note-on 'new 36 0.8 0.1)
(xtmtest-result (> (run_studio 0.3) 0.05) #t "unsolo-brings-the-rest-back")
(xtmtest-result (solo 'nope) #f "solo-of-an-unknown-track-is-refused")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; the echo's time, in beats   ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(bpm 120)
(delay-beats 3/4)
(run_studio 0.01)
(xtmtest-result (studio:param-value 'master 'delay-time) 0.375 "delay-beats-sets-the-delay-time")
(bpm 90)
(run_studio 0.01)
(xtmtest-result (studio:param-value 'master 'delay-time) 0.5 "and-follows-the-tempo")
(master 'delay-time 0.25)
(bpm 120)
(run_studio 0.01)
(xtmtest-result (studio:param-value 'master 'delay-time) 0.25 "until-the-time-is-set-in-seconds")
