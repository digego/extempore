;;; png.xtm:tests -- tests for the PNG library

;; Author: Ben Swift
;; Keywords: extempore
;; Required dylibs:

;;; Commentary:

;; Tests for libs/core/png.xtm.
;;
;; The fixtures in tests/assets/png are a subset of PngSuite (2017jul19,
;; http://www.schaik.com/pngsuite/; licence in PngSuite.LICENSE there). They
;; cover every colour type and bit depth, palettes and tRNS, interlacing, the
;; five filters, odd sizes, zlib streams from stored to maximum compression,
;; split IDATs, and the deliberately corrupt x*.png files.
;;
;; Each fixture's expected value is a 32-bit FNV-1a hash over everything
;; libstb_image 2.30 returned for it: stbi_info_from_memory (x and y as four
;; little-endian bytes each, then comp, or the byte #xEE on failure), then
;; stbi_is_16_bit_from_memory, then stbi_load_from_memory and
;; stbi_load_16_from_memory with desired_channels 0 to 4 (x, y, comp and the
;; pixel bytes, or #xEE on failure). pngtest_hash_mem computes the same thing,
;; so a match means this library agrees with stb_image byte for byte.

;;; Code:

(sys:load "libs/core/png.xtm")

(define *pngtest-dir* "tests/assets/png/")

;;;;;;;;;;;;;
;; helpers ;;
;;;;;;;;;;;;;

(bind-func pngtest_slurp
  "read a whole file into a buffer of exactly its length"
  (lambda (path:i8* lenptr:i64*)
    (let ((fp (fopen path "rb"))
          (len 0)
          (buf:i8* null))
      (if (null? fp)
          null
          (begin
            (fseek fp 0 2)
            (set! len (ftell fp))
            (fseek fp 0 0)
            (set! buf (malloc len))
            (fread buf 1 len fp)
            (fclose fp)
            (pset! lenptr 0 len)
            buf)))))

(bind-macro
  (pngtest_mix v)
  `(set! h (& (* (^ h (& ,v 255)) 16777619) #xFFFFFFFF)))

(bind-macro
  (pngtest_mix32 v)
  `(begin (pngtest_mix ,v) (pngtest_mix (>> ,v 8)) (pngtest_mix (>> ,v 16)) (pngtest_mix (>> ,v 24)) void))

(bind-func pngtest_hash_mem
  "the hash described in the commentary, of the LEN bytes of PNG at BUF"
  (lambda (buf:i8* len:i64)
    (let ((h 2166136261)
          (x:i32* (salloc 1)) (y:i32* (salloc 1)) (c:i32* (salloc 1))
          (bits 8) (req 0) (p:i8* null) (n 0) (i 0) (v 0))
      (if (= (stbi_info_from_memory buf (convert len i32) x y c) 1)
          (begin
            (set! v (convert (pref x 0) i64))
            (pngtest_mix32 v)
            (set! v (convert (pref y 0) i64))
            (pngtest_mix32 v)
            (pngtest_mix (convert (pref c 0) i64))
            void)
          (begin (pngtest_mix #xEE) void))
      (pngtest_mix (convert (stbi_is_16_bit_from_memory buf (convert len i32)) i64))
      (while (<= bits 16)
        (set! req 0)
        (while (<= req 4)
          (set! p (if (= bits 8)
                      (stbi_load_from_memory buf (convert len i32) x y c (convert req i32))
                      (cast (stbi_load_16_from_memory buf (convert len i32) x y c (convert req i32)) i8*)))
          (if (null? p)
              (begin (pngtest_mix #xEE) void)
              (begin
                (set! v (convert (pref x 0) i64))
                (pngtest_mix32 v)
                (set! v (convert (pref y 0) i64))
                (pngtest_mix32 v)
                (pngtest_mix (convert (pref c 0) i64))
                (set! n (* (convert (pref x 0) i64) (convert (pref y 0) i64)
                           (if (= req 0) (convert (pref c 0) i64) req) (/ bits 8)))
                (set! i 0)
                (while (< i n)
                  (pngtest_mix (i8toui64 (pref p i)))
                  (set! i (+ i 1)))
                (stbi_image_free p)
                void))
          (set! req (+ req 1)))
        (set! bits (+ bits 8)))
      h)))

(bind-func pngtest_hash_file
  (lambda (path:i8*)
    (let ((lenptr:i64* (salloc 1))
          (buf (pngtest_slurp path lenptr))
          (h -1))
      (if (not (null? buf))
          (begin
            (set! h (pngtest_hash_mem buf (pref lenptr 0)))
            (free buf)
            void))
      h)))

