;;; pcg-rng.xtm:tests -- tests for the PCG random number generator

;; Author: Ben Swift
;; Keywords: extempore
;; Required dylibs:

;;; Commentary:

;; Tests for libs/core/pcg-rng.xtm. Two kinds of check: the structural ones (a
;; seed fixes the whole sequence, different seeds give different sequences, a
;; bounded draw stays inside its bound), and bit-exactness against the reference
;; implementation this is a port of --- pcg_basic.c from
;; https://github.com/imneme/pcg-c-basic, compiled with gcc to produce the
;; expected values below.

;;; Code:

(sys:load "libs/core/pcg-rng.xtm")

;; a draw widened to i64 without sign extension, so it can be compared against
;; the reference's uint32_t output written as a hex literal
(bind-func pcgtest_draw_u32
  (lambda (state:PCG_RNG_State*)
    (& (convert (xt_pcg32_random_r state) i64) #xffffffff)))

(bind-func pcgtest_seq
  "fill OUT with N draws from a generator freshly seeded with SEED/STREAM"
  (lambda (out:i32* n:i64 seed:i64 stream:i64)
    (let ((state (PCG_RNG_State 0 0)))
      (xt_pcg32_srandom_r state seed stream)
      (doloop (i n) (pset! out i (xt_pcg32_random_r state)))
      void)))

(bind-func static pcgtest_matches
  (lambda (a:i32* b:i32* n:i64)
    (let ((same 0))
      (doloop (i n) (if (= (pref a i) (pref b i)) (set! same (+ same 1))))
      same)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; determinism from a seed ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; the same seed and stream give the same sequence, every time
(bind-func test_pcg_deterministic
  (lambda ()
    (let ((a:i32* (salloc 16))
          (b:i32* (salloc 16)))
      (pcgtest_seq a 16 42 54)
      (pcgtest_seq b 16 42 54)
      (pcgtest_matches a b 16))))
(xtmtest-result (test_pcg_deterministic) 16)

;; a different seed gives a different sequence (a collision on any one draw is
;; possible, so this asks only that they aren't the same sequence)
(bind-func test_pcg_seed_changes_sequence
  (lambda ()
    (let ((a:i32* (salloc 16))
          (b:i32* (salloc 16)))
      (pcgtest_seq a 16 42 54)
      (pcgtest_seq b 16 43 54)
      (< (pcgtest_matches a b 16) 16))))
(xtmtest-result (test_pcg_seed_changes_sequence) 1)

;; so does a different stream on the same seed
(bind-func test_pcg_stream_changes_sequence
  (lambda ()
    (let ((a:i32* (salloc 16))
          (b:i32* (salloc 16)))
      (pcgtest_seq a 16 42 54)
      (pcgtest_seq b 16 42 55)
      (< (pcgtest_matches a b 16) 16))))
(xtmtest-result (test_pcg_stream_changes_sequence) 1)

;; reseeding an in-use generator rewinds it to the start of the sequence
(bind-func test_pcg_reseed_rewinds
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (a:i32* (salloc 8))
          (b:i32* (salloc 8)))
      (xt_pcg32_srandom_r state 7 1)
      (doloop (i 8) (pset! a i (xt_pcg32_random_r state)))
      (xt_pcg32_srandom_r state 7 1)
      (doloop (i 8) (pset! b i (xt_pcg32_random_r state)))
      (pcgtest_matches a b 8))))
(xtmtest-result (test_pcg_reseed_rewinds) 8)

;; the global generator behaves the same way through its wrapper functions
(bind-func test_pcg_global_deterministic
  (lambda ()
    (let ((a:i32* (salloc 8))
          (b:i32* (salloc 8)))
      (xt_pcg32_srandom 99 3)
      (doloop (i 8) (pset! a i (xt_pcg32_random)))
      (xt_pcg32_srandom 99 3)
      (doloop (i 8) (pset! b i (xt_pcg32_random)))
      (pcgtest_matches a b 8))))
(xtmtest-result (test_pcg_global_deterministic) 8)

;; a generator that isn't reseeded keeps moving
(bind-func test_pcg_advances
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (a:i32* (salloc 8))
          (b:i32* (salloc 8)))
      (xt_pcg32_srandom_r state 11 2)
      (doloop (i 8) (pset! a i (xt_pcg32_random_r state)))
      (doloop (i 8) (pset! b i (xt_pcg32_random_r state)))
      (< (pcgtest_matches a b 8) 8))))
(xtmtest-result (test_pcg_advances) 1)

;;;;;;;;;;;;;;;;;;;
;; range bounds  ;;
;;;;;;;;;;;;;;;;;;;

;; every bounded draw lands in [0, bound)
(bind-func test_pcg_bounded_in_range
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (r 0:i32)
          (ok #t))
      (xt_pcg32_srandom_r state 42 54)
      (doloop (i 2000)
        (set! r (pcg32_boundedrand_r state 10))
        (if (or (< r 0:i32) (>= r 10:i32)) (set! ok #f)))
      ok)))
(xtmtest-result (test_pcg_bounded_in_range) 1)

;; and over enough draws every value in the range shows up
(bind-func test_pcg_bounded_covers_range
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (seen:|10,i64|* (salloc))
          (missing 0))
      (doloop (i 10) (aset! seen i 0))
      (xt_pcg32_srandom_r state 42 54)
      (doloop (i 2000)
        (aset! seen (convert (pcg32_boundedrand_r state 10) i64) 1))
      (doloop (i 10) (if (= (aref seen i) 0) (set! missing (+ missing 1))))
      missing)))
(xtmtest-result (test_pcg_bounded_covers_range) 0)

;; a bound of one leaves only the one answer
(bind-func test_pcg_bounded_one
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (ok #t))
      (xt_pcg32_srandom_r state 1 1)
      (doloop (i 100)
        (if (<> (pcg32_boundedrand_r state 1) 0:i32) (set! ok #f)))
      ok)))
(xtmtest-result (test_pcg_bounded_one) 1)

;; the bounded draw is seeded the same way the raw one is
(bind-func test_pcg_bounded_deterministic
  (lambda ()
    (let ((a (PCG_RNG_State 0 0))
          (b (PCG_RNG_State 0 0))
          (same 0))
      (xt_pcg32_srandom_r a 42 54)
      (xt_pcg32_srandom_r b 42 54)
      (doloop (i 32)
        (if (= (pcg32_boundedrand_r a 1000) (pcg32_boundedrand_r b 1000))
            (set! same (+ same 1))))
      same)))
(xtmtest-result (test_pcg_bounded_deterministic) 32)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; bit-exactness with pcg_basic.c ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; the first eight draws from seed (42, 54), the seed pcg_basic's own demo uses
(bind-func test_pcg_reference_stream
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (expected:|8,i64|* (salloc))
          (same 0))
      (aset! expected 0 #xa15c02b7)
      (aset! expected 1 #x7b47f409)
      (aset! expected 2 #xba1d3330)
      (aset! expected 3 #x83d2f293)
      (aset! expected 4 #xbfa4784b)
      (aset! expected 5 #xcbed606e)
      (aset! expected 6 #xbfc6a3ad)
      (aset! expected 7 #x812fff6d)
      (xt_pcg32_srandom_r state 42 54)
      (doloop (i 8)
        (if (= (pcgtest_draw_u32 state) (aref expected i)) (set! same (+ same 1))))
      same)))
(xtmtest-result (test_pcg_reference_stream) 8)

;; the bounded draw matches too. bound 7 is the discriminating case for the
;; rejection threshold: 2^32 % 7 is 4, so a threshold computed over the wrong
;; word width rejects a different set of draws and the streams part company.
(bind-func pcgtest_bounded_matches
  (lambda (expected:i64* n:i64 bound:i32)
    (let ((state (PCG_RNG_State 0 0))
          (same 0))
      (xt_pcg32_srandom_r state 42 54)
      (doloop (i n)
        (if (= (convert (pcg32_boundedrand_r state bound) i64) (pref expected i))
            (set! same (+ same 1))))
      same)))

(bind-func test_pcg_reference_bounded_10
  (lambda ()
    (let ((expected:|8,i64|* (salloc)))
      (aset! expected 0 3) (aset! expected 1 7)
      (aset! expected 2 4) (aset! expected 3 5)
      (aset! expected 4 5) (aset! expected 5 6)
      (aset! expected 6 5) (aset! expected 7 5)
      (pcgtest_bounded_matches (aref-ptr expected 0) 8 10))))
(xtmtest-result (test_pcg_reference_bounded_10) 8)

(bind-func test_pcg_reference_bounded_7
  (lambda ()
    (let ((expected:|8,i64|* (salloc)))
      (aset! expected 0 4) (aset! expected 1 4)
      (aset! expected 2 6) (aset! expected 3 0)
      (aset! expected 4 3) (aset! expected 5 2)
      (aset! expected 6 5) (aset! expected 7 1)
      (pcgtest_bounded_matches (aref-ptr expected 0) 8 7))))
(xtmtest-result (test_pcg_reference_bounded_7) 8)

(bind-func test_pcg_reference_bounded_6364
  (lambda ()
    (let ((expected:|8,i64|* (salloc)))
      (aset! expected 0 5279) (aset! expected 1 369)
      (aset! expected 2 4680) (aset! expected 3 3583)
      (aset! expected 4 511)  (aset! expected 5 618)
      (aset! expected 6 6077) (aset! expected 7 6237)
      (pcgtest_bounded_matches (aref-ptr expected 0) 8 6364))))
(xtmtest-result (test_pcg_reference_bounded_6364) 8)

;; a bound that isn't a factor of 2^32 still lands in range over many draws --
;; the raw draw is signed, so this also pins down that the bounded wrapper
;; never lets a negative through
(bind-func test_pcg_bounded_odd_in_range
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (r 0:i32)
          (ok #t))
      (xt_pcg32_srandom_r state 42 54)
      (doloop (i 5000)
        (set! r (pcg32_boundedrand_r state 7))
        (if (or (< r 0:i32) (>= r 7:i32)) (set! ok #f)))
      ok)))
(xtmtest-result (test_pcg_bounded_odd_in_range) 1)
