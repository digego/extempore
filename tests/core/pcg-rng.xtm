;;; pcg-rng.xtm:tests -- tests for the PCG random number generator

;; Author: Ben Swift
;; Keywords: extempore
;; Required dylibs:

;;; Commentary:

;; Tests for libs/core/pcg-rng.xtm. A PRNG's contract is that a seed fixes the
;; whole sequence, that different seeds give different sequences, and that the
;; bounded draw stays inside its bound -- so that's what these check, rather
;; than any particular set of numbers.

;;; Code:

(sys:load "libs/core/pcg-rng.xtm")

(bind-func pcgtest_seq
  "fill OUT with N draws from a generator freshly seeded with SEED/STREAM"
  (lambda (out:i32* n:i64 seed:i64 stream:i64)
    (let ((state (PCG_RNG_State 0 0)))
      (xt_pcg32_srandom_r state seed stream)
      (doloop (i n) (pset! out i (xt_pcg32_random_r state)))
      void)))

(bind-func static pcgtest_matches
  (lambda (a:i32* b:i32* n:i64)
    (let ((same 0))
      (doloop (i n) (if (= (pref a i) (pref b i)) (set! same (+ same 1))))
      same)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; determinism from a seed ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; the same seed and stream give the same sequence, every time
(bind-func test_pcg_deterministic
  (lambda ()
    (let ((a:i32* (salloc 16))
          (b:i32* (salloc 16)))
      (pcgtest_seq a 16 42 54)
      (pcgtest_seq b 16 42 54)
      (pcgtest_matches a b 16))))
(xtmtest-result (test_pcg_deterministic) 16)

;; a different seed gives a different sequence (a collision on any one draw is
;; possible, so this asks only that they aren't the same sequence)
(bind-func test_pcg_seed_changes_sequence
  (lambda ()
    (let ((a:i32* (salloc 16))
          (b:i32* (salloc 16)))
      (pcgtest_seq a 16 42 54)
      (pcgtest_seq b 16 43 54)
      (< (pcgtest_matches a b 16) 16))))
(xtmtest-result (test_pcg_seed_changes_sequence) 1)

;; so does a different stream on the same seed
(bind-func test_pcg_stream_changes_sequence
  (lambda ()
    (let ((a:i32* (salloc 16))
          (b:i32* (salloc 16)))
      (pcgtest_seq a 16 42 54)
      (pcgtest_seq b 16 42 55)
      (< (pcgtest_matches a b 16) 16))))
(xtmtest-result (test_pcg_stream_changes_sequence) 1)

;; reseeding an in-use generator rewinds it to the start of the sequence
(bind-func test_pcg_reseed_rewinds
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (a:i32* (salloc 8))
          (b:i32* (salloc 8)))
      (xt_pcg32_srandom_r state 7 1)
      (doloop (i 8) (pset! a i (xt_pcg32_random_r state)))
      (xt_pcg32_srandom_r state 7 1)
      (doloop (i 8) (pset! b i (xt_pcg32_random_r state)))
      (pcgtest_matches a b 8))))
(xtmtest-result (test_pcg_reseed_rewinds) 8)

;; the global generator behaves the same way through its wrapper functions
(bind-func test_pcg_global_deterministic
  (lambda ()
    (let ((a:i32* (salloc 8))
          (b:i32* (salloc 8)))
      (xt_pcg32_srandom 99 3)
      (doloop (i 8) (pset! a i (xt_pcg32_random)))
      (xt_pcg32_srandom 99 3)
      (doloop (i 8) (pset! b i (xt_pcg32_random)))
      (pcgtest_matches a b 8))))
(xtmtest-result (test_pcg_global_deterministic) 8)

;; a generator that isn't reseeded keeps moving
(bind-func test_pcg_advances
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (a:i32* (salloc 8))
          (b:i32* (salloc 8)))
      (xt_pcg32_srandom_r state 11 2)
      (doloop (i 8) (pset! a i (xt_pcg32_random_r state)))
      (doloop (i 8) (pset! b i (xt_pcg32_random_r state)))
      (< (pcgtest_matches a b 8) 8))))
(xtmtest-result (test_pcg_advances) 1)

;;;;;;;;;;;;;;;;;;;
;; range bounds  ;;
;;;;;;;;;;;;;;;;;;;

;; every bounded draw lands in [0, bound)
(bind-func test_pcg_bounded_in_range
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (r 0:i32)
          (ok #t))
      (xt_pcg32_srandom_r state 42 54)
      (doloop (i 2000)
        (set! r (pcg32_boundedrand_r state 10))
        (if (or (< r 0:i32) (>= r 10:i32)) (set! ok #f)))
      ok)))
(xtmtest-result (test_pcg_bounded_in_range) 1)

;; and over enough draws every value in the range shows up
(bind-func test_pcg_bounded_covers_range
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (seen:|10,i64|* (salloc))
          (missing 0))
      (doloop (i 10) (aset! seen i 0))
      (xt_pcg32_srandom_r state 42 54)
      (doloop (i 2000)
        (aset! seen (convert (pcg32_boundedrand_r state 10) i64) 1))
      (doloop (i 10) (if (= (aref seen i) 0) (set! missing (+ missing 1))))
      missing)))
(xtmtest-result (test_pcg_bounded_covers_range) 0)

;; a bound of one leaves only the one answer
(bind-func test_pcg_bounded_one
  (lambda ()
    (let ((state (PCG_RNG_State 0 0))
          (ok #t))
      (xt_pcg32_srandom_r state 1 1)
      (doloop (i 100)
        (if (<> (pcg32_boundedrand_r state 1) 0:i32) (set! ok #f)))
      ok)))
(xtmtest-result (test_pcg_bounded_one) 1)

;; the bounded draw is seeded the same way the raw one is
(bind-func test_pcg_bounded_deterministic
  (lambda ()
    (let ((a (PCG_RNG_State 0 0))
          (b (PCG_RNG_State 0 0))
          (same 0))
      (xt_pcg32_srandom_r a 42 54)
      (xt_pcg32_srandom_r b 42 54)
      (doloop (i 32)
        (if (= (pcg32_boundedrand_r a 1000) (pcg32_boundedrand_r b 1000))
            (set! same (+ same 1))))
      same)))
(xtmtest-result (test_pcg_bounded_deterministic) 32)
