;;; tests/core/scheme-compat.xtm -- TinyScheme->s7 compatibility shims

;; Author: Ben Swift
;; Keywords: extempore
;; Required dylibs:

;;; Commentary:

;; src/SchemeS7.cpp and runtime/init.xtm re-provide the builtins and the
;; behaviour that the old TinyScheme-derived interpreter offered but s7 does
;; not. These tests pin the shims that aren't exercised elsewhere, so a
;; regression (or an s7 upgrade that shadows them) fails loudly here.
;;
;; put/get are TinyScheme's symbol property lists (its USE_PLIST builtins, a
;; MacLisp/Common-Lisp-heritage extension -- not part of any RnRS). They went
;; missing in v0.9.0 when the interpreter moved to s7, so (put 'a 'b 10) raised
;; "Unbound variable put" (reported on the mailing list by Minoru, June 2026).
;; The shim backs them with a hash table keyed by (sym . key).

;;; Code:

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; put/get -- symbol property lists

;; the canonical round-trip from Minoru's report
(xtmtest-result (begin (put 'a 'b 10) (get 'a 'b)) 10 "put-get-round-trip")

;; put reports success with #t, like TinyScheme
(xtmtest-result (put 'put-ok 'k 1) #t "put-returns-true")

;; a re-put on the same (sym . key) overwrites in place rather than shadowing
(xtmtest-result (begin (put 'upd 'k 1) (put 'upd 'k 2) (get 'upd 'k)) 2 "put-updates-in-place")

;; an absent property is #f (false), not '() -- '() is true under s7, so #f is
;; what keeps (if (get ...) ...) behaving as TinyScheme code expects
(xtmtest-result (get 'never 'set) #f "get-missing-is-false")

;; distinct keys coexist on the one symbol, and values need not be numbers
(xtmtest-result (begin (put 'sym 'k1 'v1) (put 'sym 'k2 'v2) (list (get 'sym 'k1) (get 'sym 'k2)))
                '(v1 v2)
                "distinct-keys-per-symbol")
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; make-string -- s7's own, with no special case for a zero length

;; the compiler's IR buffers are made by xtc:emit:new-buffer, so a zero-length
;; make-string is the plain empty string R7RS says it is
(xtmtest-result (string? (make-string 0)) #t "make-string-zero-is-string")
(xtmtest-result (string=? "" (make-string 0)) #t "make-string-zero-is-empty")
(xtmtest-result (string-length (make-string 0)) 0 "make-string-zero-length")
(xtmtest-result (string-append "a" (make-string 0) "b") "ab" "make-string-zero-appends")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; print-length -- write must round-trip, not elide

;; s7 drops list and vector elements past (*s7* 'print-length) and writes a
;; literal "..." in their place; TinyScheme never truncated. Extempore
;; serialises with `write` (instrument presets, the AOT cache), so s7's default
;; of 40 silently corrupted anything longer: a saved preset read back as a list
;; whose tail was the symbol ... (reported on the mailing list by George,
;; September 2026). SchemeS7.cpp raises the limit at startup.

(xtmtest-result (> (*s7* 'print-length) 1000) #t "print-length-raised")

(xtmtest-result (let ((port (open-output-string)))
                  (write (range 0 200) port)
                  (equal? (with-input-from-string (get-output-string port) read)
                          (range 0 200)))
                #t
                "write-long-list-round-trips")

;; the shape an instrument preset is saved in: an alist well past the old limit
(xtmtest-result (let* ((alist (map (lambda (i)
                                     (cons (string->symbol (string-append "k" (number->string i)))
                                           (* i 1.0)))
                                   (range 0 100)))
                       (port (open-output-string)))
                  (write alist port)
                  (equal? (with-input-from-string (get-output-string port) read) alist))
                #t
                "write-long-alist-round-trips")
