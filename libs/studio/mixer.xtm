;;; mixer.xtm -- the studio's tracks, send effects, master bus and DSP callback

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; The mixer has STUDIO_TRACKS tracks. Each one holds an instrument and a
;; channel strip, and can send some of its signal to a shared delay and a
;; shared reverb. Everything meets at the master bus, which has a compressor
;; and a limiter.
;;
;;   track 0: instrument -> strip --+--> master: compressor -> gain -> limiter
;;   track 1: instrument -> strip --+        ^
;;   ...                            |        |
;;                                  +-> delay -> reverb
;;
;; studio_dsp is the audio callback. Once per frame it applies the events
;; which are due, then runs the signal path above.

;;; Code:

(sys:load "libs/studio/aot.xtm" 'quiet)
(studio:aot-load "studio_mixer"
                 '("libs/studio/mixer.xtm"
                   "libs/studio/engine.xtm"
                   "libs/studio/fx.xtm"
                   "libs/studio/hall.xtm"
                   "libs/studio/dsp.xtm"))
(sys:load-preload-check 'studio_mixer)
(define *xtmlib-studio_mixer-loaded* #t)

(xtc:aot:suppress-aot-do
 (sys:load "libs/core/midi.xtm")
 (sys:load "libs/studio/engine.xtm")
 (sys:load "libs/studio/fx.xtm")
 (sys:load "libs/studio/hall.xtm"))
(xtc:aot:insert-forms
 (sys:load "libs/core/midi.xtm" 'quiet)
 (sys:load "libs/studio/engine.xtm" 'quiet)
 (sys:load "libs/studio/fx.xtm" 'quiet)
 (sys:load "libs/studio/hall.xtm" 'quiet))

(xtc:aot:insert-header "xtmstudio_mixer")
(xtc:aot:import-ll "xtmstudio_mixer")

(bind-val STUDIO_TRACKS i64 16)

;; the master bus parameters
(bind-val MASTER_GAIN i64 0)            ;; linear gain (1.0 is unity)
(bind-val MASTER_REVERB_LEVEL i64 1)    ;; reverb return level
(bind-val MASTER_REVERB_SIZE i64 2)     ;; 0.0 to 1.0
(bind-val MASTER_REVERB_DAMPING i64 3)  ;; 0.0 to 1.0
(bind-val MASTER_REVERB_PREDELAY i64 4) ;; seconds
(bind-val MASTER_DELAY_LEVEL i64 5)     ;; delay return level
(bind-val MASTER_DELAY_TIME i64 6)      ;; seconds
(bind-val MASTER_DELAY_FEEDBACK i64 7)  ;; 0.0 to 0.95
(bind-val MASTER_DELAY_TONE i64 8)      ;; 0.0 (bright echoes) to 1.0 (dark)
(bind-val MASTER_DELAY_CROSS i64 9)     ;; 0.0 (stereo) to 1.0 (ping-pong)
(bind-val MASTER_DELAY_REVERB i64 10)   ;; how much of the delay feeds the reverb
(bind-val MASTER_COMP_THRESHOLD i64 11) ;; dB
(bind-val MASTER_COMP_RATIO i64 12)     ;; 1.0 turns the compressor off
(bind-val MASTER_COMP_ATTACK i64 13)    ;; milliseconds
(bind-val MASTER_COMP_RELEASE i64 14)   ;; milliseconds
(bind-val MASTER_COMP_MAKEUP i64 15)    ;; dB
(bind-val MASTER_CEILING i64 16)        ;; the limiter's ceiling (1.0 is full scale)
(bind-val MASTER_REVERB_TYPE i64 17)    ;; 0.0: the plate reverb, 1.0: the hall
(bind-val MASTER_NPARAMS i64 18)

;; 0 instrument (null for an empty track)
;; 1 channel strip parameters (see the STRIP_ constants in fx.xtm)
;; 2 channel strip
;; 3 peak level since it was last read
;; 4 the sum of its squared samples, and
;; 5 the number of frames, since the RMS level was last read
;; 6 the number of frames which were silenced for holding a bad sample (see
;;   sample_bad), since that was last read
(bind-type Track <Inst*,SAMPLE*,[void,SAMPLE*,SAMPLE*]*,SAMPLE,double,i64,i64> (printer? . #f))

(bind-val studio_tracks Track* 0)
(bind-val studio_master SAMPLE* 0)
(bind-val studio_master_peak SAMPLE 0.0)
(bind-val studio_gain_reduction SAMPLE 0.0)
;; notes which arrived after the time they were meant to start
(bind-val studio_late_notes i64 0)

;; The studio keeps its own clock, so that a render can queue up a whole piece
;; before time starts. It runs in frames and matches (now) unless it has been
;; held.
(bind-val studio_time_offset i64 0)
(bind-val studio_held i64 0)
(bind-val studio_frozen_time i64 0)

(bind-func studio_now
  "the studio's time, in frames"
  (lambda ()
    (if (> studio_held 0)
        studio_frozen_time
        (- (now) studio_time_offset))))

(bind-func studio_hold
  "stop the studio's clock: it goes silent, and queued events wait"
  (lambda ()
    (if (= studio_held 0)
        (begin
          (set! studio_frozen_time (- (now) studio_time_offset))
          (set! studio_held 1)))
    void))

(bind-func studio_release
  "restart the studio's clock from where it stopped"
  (lambda ()
    (if (> studio_held 0)
        (begin
          (set! studio_time_offset (- (now) studio_frozen_time))
          (set! studio_held 0)))
    void))

(bind-func static studio_master_defaults
  (lambda (p:SAMPLE*)
    (pset! p MASTER_GAIN 1.0)
    (pset! p MASTER_REVERB_LEVEL 1.0)
    (pset! p MASTER_REVERB_SIZE 0.5)
    (pset! p MASTER_REVERB_DAMPING 0.35)
    (pset! p MASTER_REVERB_PREDELAY 0.015)
    (pset! p MASTER_DELAY_LEVEL 1.0)
    (pset! p MASTER_DELAY_TIME 0.375)
    (pset! p MASTER_DELAY_FEEDBACK 0.45)
    (pset! p MASTER_DELAY_TONE 0.45)
    (pset! p MASTER_DELAY_CROSS 1.0)
    (pset! p MASTER_DELAY_REVERB 0.2)
    ;; gentle: a couple of dB off the loudest moments of a full mix
    (pset! p MASTER_COMP_THRESHOLD -10.0)
    (pset! p MASTER_COMP_RATIO 2.0)
    (pset! p MASTER_COMP_ATTACK 25.0)
    (pset! p MASTER_COMP_RELEASE 250.0)
    (pset! p MASTER_COMP_MAKEUP 2.0)
    (pset! p MASTER_CEILING 0.9)
    (pset! p MASTER_REVERB_TYPE 0.0)
    void))

(bind-func studio_set_instrument
  "put an instrument on a track (null empties it)"
  (lambda (track:i64 inst:Inst*)
    (if (and (>= track 0) (< track STUDIO_TRACKS) (not (null? studio_tracks)))
        (tset! (pref-ptr studio_tracks track) 0 inst))
    void))

(bind-func studio_reset_strip
  "put a track's mixer strip back to its defaults"
  (lambda (track:i64)
    (if (and (>= track 0) (< track STUDIO_TRACKS) (not (null? studio_tracks)))
        (strip_defaults (tref (pref-ptr studio_tracks track) 1)))
    void))

(bind-func studio_clock_offset
  "how far the studio's clock is behind (now), in frames"
  (lambda ()
    studio_time_offset))

(bind-func studio_clear_track
  "take the instrument off a track"
  (lambda (track:i64)
    (studio_set_instrument track null)))

(bind-func studio_get_instrument
  (lambda (track:i64)
    (if (and (>= track 0) (< track STUDIO_TRACKS) (not (null? studio_tracks)))
        (tref (pref-ptr studio_tracks track) 0)
        null)))

(bind-func studio_track_param
  "read a track's mixer parameter"
  (lambda (track:i64 idx:i64)
    (if (and (>= track 0) (< track STUDIO_TRACKS) (>= idx 0) (< idx STRIP_NPARAMS)
             (not (null? studio_tracks)))
        (pref (tref (pref-ptr studio_tracks track) 1) idx)
        0.0)))

(bind-func studio_inst_param
  "read a parameter of the instrument on a track"
  (lambda (track:i64 idx:i64)
    (let ((inst (studio_get_instrument track)))
      (if (null? inst)
          0.0
          (inst_get_param inst idx)))))

(bind-func studio_master_param
  (lambda (idx:i64)
    (if (and (>= idx 0) (< idx MASTER_NPARAMS) (not (null? studio_master)))
        (pref studio_master idx)
        0.0)))

(bind-func studio_track_peak
  "the track's peak level since this was last called"
  (lambda (track:i64)
    (if (and (>= track 0) (< track STUDIO_TRACKS) (not (null? studio_tracks)))
        (let ((trk (pref-ptr studio_tracks track))
              (peak:SAMPLE (tref trk 3)))
          (tset! trk 3 0.0)
          peak)
        0.0)))

(bind-func studio_track_rms
  "the track's RMS level since this was last called"
  (lambda (track:i64)
    (if (and (>= track 0) (< track STUDIO_TRACKS) (not (null? studio_tracks)))
        (let ((trk (pref-ptr studio_tracks track))
              (frames (tref trk 5))
              (rms:double (if (> frames 0) (sqrt (/ (tref trk 4) (convert frames double))) 0.0)))
          (tset! trk 4 0.0)
          (tset! trk 5 0)
          (convert rms SAMPLE))
        0.0)))

(bind-func studio_track_bad_frames
  "how many of the track's frames have been silenced for holding a NaN or an
infinity, since this was last called"
  (lambda (track:i64)
    (if (and (>= track 0) (< track STUDIO_TRACKS) (not (null? studio_tracks)))
        (let ((trk (pref-ptr studio_tracks track))
              (count (tref trk 6)))
          (tset! trk 6 0)
          count)
        0)))

(bind-func studio_late_note_count
  (lambda ()
    studio_late_notes))

(bind-func studio_dropped_event_count
  (lambda ()
    studio_events_dropped))

(bind-func studio_gain_reduction_db
  "how hard the master compressor is working, in dB (negative)"
  (lambda ()
    studio_gain_reduction))

(bind-func studio_peak
  "the master bus's peak level since this was last called"
  (lambda ()
    (let ((peak studio_master_peak))
      (set! studio_master_peak 0.0)
      peak)))

;; is a parameter waiting on some track for its note? (see EVT_NOTE_PARAM)
(bind-val studio_note_params_waiting i64 0)

(bind-func static studio_apply_event
  (lambda (evt:StudioEvent*)
    (let ((kind (tref evt 2))
          (track (tref evt 3))
          (i (tref evt 4))
          (x (tref evt 5))
          (y (tref evt 6))
          (trk:Track* null)
          (inst:Inst* null))
      (if (and (= kind EVT_MASTER_PARAM) (>= i 0) (< i MASTER_NPARAMS))
          (pset! studio_master i x))
      (if (and (>= track 0) (< track STUDIO_TRACKS) (<> kind EVT_MASTER_PARAM))
          (begin
            (set! trk (pref-ptr studio_tracks track))
            (set! inst (tref trk 0))
            (if (and (= kind EVT_TRACK_PARAM) (>= i 0) (< i STRIP_NPARAMS))
                (pset! (tref trk 1) i x))
            (if (not (null? inst))
                (begin
                  (if (= kind EVT_NOTE_ON) (inst_note_on inst x y i))
                  (if (= kind EVT_NOTE_OFF) (inst_note_off inst x))
                  (if (= kind EVT_INST_PARAM) (inst_set_param inst i x))
                  (if (= kind EVT_NOTE_PARAM)
                      (begin
                        (inst_note_param inst i x)
                        (set! studio_note_params_waiting 1)))
                  (if (= kind EVT_ALL_OFF) (inst_all_off inst))
                  void))
            void))
      void)))

;;;;;;;;;;
;; MIDI ;;
;;;;;;;;;;

;; The ports the midi instrument plays (libs/studio/instruments/midi.xtm). A
;; track's `port` parameter is a slot in this table, because a parameter is a
;; number.
(bind-val STUDIO_MIDI_PORTS i64 64)
(bind-val studio_midi_ports |64,MidiPort*|)

(bind-func studio_midi_add_port
  "the port's slot in the table of ports, putting it there if need be (-1 if the
table is full)"
  (lambda (port:MidiPort*)
    (let ((slot:i64 -1) (i:i64 0))
      (dotimes (i STUDIO_MIDI_PORTS)
        (if (= (cast (aref studio_midi_ports i) i8*) (cast port i8*))
            (set! slot i)))
      (dotimes (i STUDIO_MIDI_PORTS)
        (if (and (< slot 0) (null? (aref studio_midi_ports i)))
            (begin (aset! studio_midi_ports i port)
                   (set! slot i))))
      slot)))

(bind-func studio_midi_port
  "the port in a slot of the table of ports, or null"
  (lambda (slot:i64)
    (if (and (> slot -1) (< slot STUDIO_MIDI_PORTS))
        (aref studio_midi_ports slot)
        (cast null MidiPort*))))

;; Routes: a MIDI input which plays a track. The audio thread reads a routed
;; port itself (so nothing else may: a port has one reader) and turns what
;; arrives into events for the track.
;;
;; a route: the port (null for a free slot), the track, and the MIDI channel
;; it listens to (0-15, or -1 for all of them)
(bind-type StudioMidiRoute <MidiPort*,i64,i64> (printer? . #f))
;; a controller which sets a parameter: the port (null for a free slot), the
;; controller, the event's kind, track and parameter index, and the values the
;; parameter takes at 0 and at 127
(bind-type StudioMidiMap <MidiPort*,i64,i64,i64,i64,SAMPLE,SAMPLE> (printer? . #f))

(bind-val STUDIO_MIDI_ROUTES i64 16)
(bind-val STUDIO_MIDI_MAPS i64 64)

(bind-func static studio_midi_alloc_routes
  (lambda ()
    (let ((routes:StudioMidiRoute* (halloc STUDIO_MIDI_ROUTES)) (i:i64 0))
      (dotimes (i STUDIO_MIDI_ROUTES)
        (tfill! (pref-ptr routes i) null 0 -1))
      routes)))

(bind-func static studio_midi_alloc_maps
  (lambda ()
    (let ((maps:StudioMidiMap* (halloc STUDIO_MIDI_MAPS)) (i:i64 0))
      (dotimes (i STUDIO_MIDI_MAPS)
        (tfill! (pref-ptr maps i) null 0 0 0 0 0.0 1.0))
      maps)))

(bind-val studio_midi_routes StudioMidiRoute* (studio_midi_alloc_routes))
(bind-val studio_midi_maps StudioMidiMap* (studio_midi_alloc_maps))
(bind-val studio_midi_routed i64 0) ;; how many routes are in use

(bind-func static studio_midi_count_routes
  (lambda ()
    (let ((n:i64 0) (i:i64 0))
      (dotimes (i STUDIO_MIDI_ROUTES)
        (if (not (null? (tref (pref-ptr studio_midi_routes i) 0))) (set! n (+ n 1))))
      (set! studio_midi_routed n)
      void)))

(bind-func studio_midi_route
  "play track with what arrives at port on channel (0-15, or -1 for any).
Returns #f if every route is in use."
  (lambda (port:MidiPort* track:i64 channel:i64)
    (let ((r:StudioMidiRoute* null) (done:i1 #f) (i:i64 0))
      (dotimes (i STUDIO_MIDI_ROUTES)
        (set! r (pref-ptr studio_midi_routes i))
        (if (and (not done) (null? (tref r 0)))
            (begin
              ;; the port last: it's what the audio thread looks at
              (tset! r 1 track)
              (tset! r 2 channel)
              (tset! r 0 port)
              (set! done #t))))
      (studio_midi_count_routes)
      done)))

(bind-func studio_midi_unroute
  "stop port playing anything, and forget its controllers"
  (lambda (port:MidiPort*)
    (let ((i:i64 0))
      (dotimes (i STUDIO_MIDI_ROUTES)
        (if (= (cast (tref (pref-ptr studio_midi_routes i) 0) i8*) (cast port i8*))
            (tset! (pref-ptr studio_midi_routes i) 0 null)))
      (dotimes (i STUDIO_MIDI_MAPS)
        (if (= (cast (tref (pref-ptr studio_midi_maps i) 0) i8*) (cast port i8*))
            (tset! (pref-ptr studio_midi_maps i) 0 null)))
      (studio_midi_count_routes)
      void)))

(bind-func studio_midi_map
  "have a controller of port's set a parameter: kind is the event's
(EVT_INST_PARAM, EVT_TRACK_PARAM or EVT_MASTER_PARAM), and lo and hi the values
at 0 and at 127. Returns #f if every map is in use."
  (lambda (port:MidiPort* controller:i64 kind:i64 track:i64 idx:i64 lo:SAMPLE hi:SAMPLE)
    (let ((m:StudioMidiMap* null) (done:i1 #f) (i:i64 0))
      (dotimes (i STUDIO_MIDI_MAPS)
        (set! m (pref-ptr studio_midi_maps i))
        (if (and (not done) (null? (tref m 0)))
            (begin
              (tfill! m null controller kind track idx lo hi)
              (tset! m 0 port)
              (set! done #t))))
      done)))

;; A message is given the frame a block after the one it arrived in, so that
;; what is played has a steady delay and doesn't snap to the start of a block.
(bind-func studio_midi_poll
  "turn what has arrived at the routed ports into events. For the audio thread;
time_now is the studio's time, in frames."
  (lambda (time_now:i64)
    (let ((msg:MidiMsg* (salloc))
          (r:StudioMidiRoute* null)
          (m:StudioMidiMap* null)
          (port:MidiPort* null)
          (block_frame (- (now) (- studio_frame time_now)))
          (block_time (+ (audio_clock_now) (clock_offset)))
          (when:i64 0)
          (kind:i32 0)
          (i:i64 0)
          (j:i64 0))
      (dotimes (i STUDIO_MIDI_ROUTES)
        (set! r (pref-ptr studio_midi_routes i))
        (set! port (tref r 0))
        (if (not (null? port))
            (while (midi_receive port msg)
              (set! kind (& (tref msg 1) #xF0))
              (if (and (< (tref msg 1) #xF0)
                       (or (= (tref r 2) -1)
                           (= (tref r 2) (convert (& (tref msg 1) #x0F) i64))))
                  (begin
                    (set! when (+ block_frame FRAMES
                                  (convert (* (- (tref msg 0) block_time) (convert SR double)) i64)))
                    (if (< when time_now) (set! when time_now))
                    (cond ((and (= kind MIDI_NOTE_ON) (> (tref msg 3) 0))
                           (studio_push_event when EVT_NOTE_ON (tref r 1) 0
                                              (convert (tref msg 2) SAMPLE)
                                              (/ (convert (tref msg 3) SAMPLE) 127.0))
                           void)
                          ((or (= kind MIDI_NOTE_ON) (= kind MIDI_NOTE_OFF))
                           (studio_push_event when EVT_NOTE_OFF (tref r 1) 0
                                              (convert (tref msg 2) SAMPLE) 0.0)
                           void)
                          ((= kind MIDI_CONTROL_CHANGE)
                           (dotimes (j STUDIO_MIDI_MAPS)
                             (set! m (pref-ptr studio_midi_maps j))
                             (if (and (= (cast (tref m 0) i8*) (cast port i8*))
                                      (= (tref m 1) (convert (tref msg 2) i64)))
                                 (studio_push_event
                                  when (tref m 2) (tref m 3) (tref m 4)
                                  (+ (tref m 5)
                                     (* (- (tref m 6) (tref m 5))
                                        (/ (convert (tref msg 3) SAMPLE) 127.0)))
                                  0.0)))
                           void)
                          (else void)))))))
      void)))

;; xtlang's comparisons of floats are unordered: one with a not-a-number
;; operand is true. So the first test below catches not-a-number as well as
;; infinity; the second is the same test for a compiler whose comparisons are
;; ordered, where it is the one which catches it.
(bind-macro
  "is the sample x not a number, infinite, or far too large to be audio?"
  (sample_bad x)
  `(let ((bad_x:SAMPLE (fabs ,x)))
     (or (> bad_x 1000.0) (not (< bad_x 1000.0)))))

(bind-func studio_dsp:DSP 16000000
  (let ((tracks:Track* (zalloc STUDIO_TRACKS))
        (master:SAMPLE* (zalloc MASTER_NPARAMS))
        (frame:SAMPLE* (zalloc 2))
        (mix:SAMPLE* (zalloc 2))
        (delay_in:SAMPLE* (zalloc 2))
        (delay_out:SAMPLE* (zalloc 2))
        (reverb_in:SAMPLE* (zalloc 2))
        (reverb_out:SAMPLE* (zalloc 2))
        (evt:StudioEvent* (zalloc))
        (delay (stereo_delay_c 4.0))
        (plate (plate_reverb_c))
        (hall (hall_reverb_c))
        (compressor (compressor_c))
        (limiter (limiter_c))
        (trk:Track* null)
        (inst:Inst* null)
        (strip:SAMPLE* null)
        (time_now:i64 0)
        (peak:SAMPLE 0.0)
        (power:SAMPLE 0.0)
        (i:i64 0))
    (dotimes (i STUDIO_TRACKS)
      (let ((params:SAMPLE* (zalloc STRIP_NPARAMS)))
        (strip_defaults params)
        (tfill! (pref-ptr tracks i) null params (strip_c) 0.0 0.0 0 0)))
    (studio_master_defaults master)
    (set! studio_tracks tracks)
    (set! studio_master master)
    (lambda (in time chan dat)
      (if (= chan 0)
          (begin
            (studio_drain_inbox)
            (pfill! mix 0.0 0.0)
            (set! studio_frame time)
            (if (= studio_held 0)
                (begin
                  (set! time_now (- time studio_time_offset))
                  (if (and (> studio_midi_routed 0) (= (% time 64) 0))
                      (studio_midi_poll time_now))
                  ;; apply every event which is due
                  (while (and (> studio_heap_size 0)
                              (<= (tref studio_heap 0) time_now))
                    (studio_heap_pop evt)
                    (if (and (= (tref evt 2) EVT_NOTE_ON) (< (tref evt 0) (- time_now 2048)))
                        (set! studio_late_notes (+ studio_late_notes 1)))
                    (studio_apply_event evt))
                  ;; A note's parameters arrive just before it, at the same
                  ;; time. Any still waiting now have no note to go with, and
                  ;; mustn't be left for some later one.
                  (if (> studio_note_params_waiting 0)
                      (begin
                        (set! studio_note_params_waiting 0)
                        (dotimes (i STUDIO_TRACKS)
                          (set! inst (tref (pref-ptr tracks i) 0))
                          (if (not (null? inst)) (inst_clear_note_params inst)))))
                  ;; the tracks
                  (pfill! delay_in 0.0 0.0)
                  (pfill! reverb_in 0.0 0.0)
                  (dotimes (i STUDIO_TRACKS)
                    (set! trk (pref-ptr tracks i))
                    (set! inst (tref trk 0))
                    (if (not (null? inst))
                        (begin
                          (set! strip (tref trk 1))
                          (inst_tick inst frame)
                          ;; One infinite or not-a-number sample would stay
                          ;; in the strip's filters, the send effects and the
                          ;; compressor for good, so a frame with one in it
                          ;; is silenced before it reaches any of them.
                          (if (or (sample_bad (pref frame 0)) (sample_bad (pref frame 1)))
                              (begin
                                (pfill! frame 0.0 0.0)
                                (tset! trk 6 (+ (tref trk 6) 1))))
                          ((tref trk 2) frame strip)
                          (set! peak (max (fabs (pref frame 0)) (fabs (pref frame 1))))
                          (if (> peak (tref trk 3)) (tset! trk 3 peak))
                          (set! power (* 0.5 (+ (* (pref frame 0) (pref frame 0))
                                                (* (pref frame 1) (pref frame 1)))))
                          (tset! trk 4 (+ (tref trk 4) (convert power double)))
                          (tset! trk 5 (+ (tref trk 5) 1))
                          (frame_add_stereo mix (pref frame 0) (pref frame 1))
                          (frame_add_stereo delay_in
                                            (* (pref strip STRIP_DELAY) (pref frame 0))
                                            (* (pref strip STRIP_DELAY) (pref frame 1)))
                          (frame_add_stereo reverb_in
                                            (* (pref strip STRIP_REVERB) (pref frame 0))
                                            (* (pref strip STRIP_REVERB) (pref frame 1))))))
                  ;; the send effects. Some of the delay feeds the reverb,
                  ;; which sits the echoes back in the mix.
                  (delay delay_in delay_out
                         (pref master MASTER_DELAY_TIME)
                         (pref master MASTER_DELAY_FEEDBACK)
                         (pref master MASTER_DELAY_TONE)
                         (pref master MASTER_DELAY_CROSS))
                  (frame_add_stereo reverb_in
                                    (* (pref master MASTER_DELAY_REVERB) (pref delay_out 0))
                                    (* (pref master MASTER_DELAY_REVERB) (pref delay_out 1)))
                  ;; only the reverb which is in use runs: the other keeps
                  ;; whatever tail it had, so switch between them in a quiet
                  ;; moment
                  (if (> (pref master MASTER_REVERB_TYPE) 0.5)
                      (hall reverb_in reverb_out
                            (pref master MASTER_REVERB_SIZE)
                            (pref master MASTER_REVERB_DAMPING)
                            (pref master MASTER_REVERB_PREDELAY))
                      (plate reverb_in reverb_out
                             (pref master MASTER_REVERB_SIZE)
                             (pref master MASTER_REVERB_DAMPING)
                             (pref master MASTER_REVERB_PREDELAY)))
                  (frame_add_stereo mix
                                    (* (pref master MASTER_DELAY_LEVEL) (pref delay_out 0))
                                    (* (pref master MASTER_DELAY_LEVEL) (pref delay_out 1)))
                  (frame_add_stereo mix
                                    (* (pref master MASTER_REVERB_LEVEL) (pref reverb_out 0))
                                    (* (pref master MASTER_REVERB_LEVEL) (pref reverb_out 1)))
                  ;; the master bus. The same check again, to keep a bad
                  ;; sample from the send effects out of the compressor and
                  ;; the limiter.
                  (if (sample_bad (pref mix 0)) (pset! mix 0 0.0))
                  (if (sample_bad (pref mix 1)) (pset! mix 1 0.0))
                  (set! studio_gain_reduction
                        (compressor mix
                                    (pref master MASTER_COMP_THRESHOLD)
                                    (pref master MASTER_COMP_RATIO)
                                    (pref master MASTER_COMP_ATTACK)
                                    (pref master MASTER_COMP_RELEASE)
                                    (pref master MASTER_COMP_MAKEUP)))
                  (pset! mix 0 (* (pref master MASTER_GAIN) (pref mix 0)))
                  (pset! mix 1 (* (pref master MASTER_GAIN) (pref mix 1)))
                  (limiter mix (pref master MASTER_CEILING) 120.0)
                  (set! peak (max (fabs (pref mix 0)) (fabs (pref mix 1))))
                  (if (> peak studio_master_peak) (set! studio_master_peak peak))
                  void))))
      (if (< chan 2)
          (pref mix chan)
          0.0))))

(xtc:aot:insert-footer "xtmstudio_mixer")
