;;; studio.xtm -- instruments, a mixer and a pattern language, ready to play

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; Load this file to get the whole studio:
;;
;;   (sys:load "libs/studio/studio.xtm")
;;   (studio:start)
;;   (track 'bass 'acid)
;;   (note-on 'bass 36 0.8 0.5)
;;
;; The instruments are in libs/studio/instruments, one to a file, and each is
;; loaded the first time you put it on a track. examples/studio is the place
;; to start.

;;; Code:

(sys:load "libs/studio/api.xtm")
(sys:load "libs/studio/pattern.xtm")
(sys:load "libs/studio/midi.xtm")
