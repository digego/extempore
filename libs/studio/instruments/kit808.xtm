;;; kit808.xtm -- a synthesised drum machine in the style of the TR-808

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; A drum kit in the style of the Roland TR-808, where every sound is
;; synthesised, as it was in the original. Each sound has its own voice, and
;; the notes follow General MIDI: 36 kick, 38 snare, 42 closed hat and so on
;; (the sounds clause below lists them all).
;;
;; The 808 makes its sounds from a few circuits, and this file follows them:
;;
;; - The kick, toms, congas, rim shot and claves are *struck resonators*. In
;;   the hardware these are bridged-T filters tuned close to oscillation, and
;;   a short trigger pulse sets them ringing. A struck resonator rings as a
;;   sine wave which dies away exponentially, so here each one is a sine
;;   oscillator with an exponential envelope, which is cheaper and easier to
;;   tune than the filter itself.
;; - The snare is two of those resonators (the drum's two lowest modes) plus
;;   filtered white noise for the snares.
;; - The clap is bandpassed noise, opened three times in quick succession and
;;   then left to fade, which sounds like several people clapping at once.
;; - The hi-hats, cymbal and cowbell share a bank of six square-wave
;;   oscillators at unrelated frequencies. Summed, they make a dense,
;;   clangorous spectrum, and bandpass filters pick out the part each sound
;;   needs.
;;
;; Velocity sets the level of every sound, and on most it also sets the tone:
;; a harder kick has more click, a harder snare or clap is brighter.
;;
;; The closed and open hi-hats share one voice, so either one cuts the other
;; off, as on the original.
;;
;; This is an original implementation, built from published descriptions of
;; the 808's circuits and its sound.

;;; Code:

(sys:load-preload-check 'studio-kit808)
(define *xtmlib-studio-kit808-loaded* #t)

(sys:load "libs/studio/api.xtm")

(def-instrument kit808
  "a synthesised drum machine in the style of the TR-808"
  (params
   (bd-tune 50.0 "kick pitch in Hz")
   (bd-decay 0.9 "seconds for the kick to die away")
   (bd-tone 0.35 "kick click, 0.0 (soft) to 1.0 (hard)")
   (bd-drive 0.0 "kick saturation, 0.0 to 1.0")
   (bd-level 0.7 "kick level, 0.0 to 1.0")
   (sd-tune 185.0 "snare pitch in Hz (the lower of its two tones)")
   (sd-tone 0.5 "snare brightness, 0.0 to 1.0")
   (sd-snappy 0.55 "how loud the snares are against the drum, 0.0 to 1.0")
   (sd-level 0.7 "snare level, 0.0 to 1.0")
   (rs-level 0.7 "rim shot level, 0.0 to 1.0")
   (cp-decay 0.3 "seconds for the clap's tail to die away")
   (cp-level 0.7 "clap level, 0.0 to 1.0")
   (hh-decay 0.09 "seconds for the closed hi-hat to die away")
   (hh-level 0.7 "closed hi-hat level, 0.0 to 1.0")
   (oh-decay 0.5 "seconds for the open hi-hat to die away")
   (oh-level 0.7 "open hi-hat level, 0.0 to 1.0")
   (cr-decay 1.6 "seconds for the cymbal to die away")
   (cr-tone 0.5 "cymbal brightness, 0.0 to 1.0")
   (cr-level 0.7 "cymbal level, 0.0 to 1.0")
   (tom-decay 0.5 "seconds for the toms to die away")
   (lt-tune 90.0 "low tom pitch in Hz")
   (lt-level 0.7 "low tom level, 0.0 to 1.0")
   (mt-tune 130.0 "mid tom pitch in Hz")
   (mt-level 0.7 "mid tom level, 0.0 to 1.0")
   (ht-tune 175.0 "high tom pitch in Hz")
   (ht-level 0.7 "high tom level, 0.0 to 1.0")
   (conga-decay 0.25 "seconds for the congas to die away")
   (lc-tune 165.0 "low conga pitch in Hz")
   (lc-level 0.7 "low conga level, 0.0 to 1.0")
   (mc-tune 250.0 "mid conga pitch in Hz")
   (mc-level 0.7 "mid conga level, 0.0 to 1.0")
   (hc-tune 370.0 "high conga pitch in Hz")
   (hc-level 0.7 "high conga level, 0.0 to 1.0")
   (cb-level 0.7 "cowbell level, 0.0 to 1.0")
   (cl-level 0.7 "claves level, 0.0 to 1.0")
   (ma-level 0.7 "maracas level, 0.0 to 1.0"))
  (presets
   (classic)
   (boomy (bd-tune 45.0) (bd-decay 2.6) (bd-tone 0.15) (sd-tone 0.35) (hh-decay 0.12))
   (tight (bd-tune 55.0) (bd-decay 0.35) (bd-tone 0.55) (sd-snappy 0.7) (sd-tone 0.7)
          (cp-decay 0.15) (hh-decay 0.045) (oh-decay 0.25) (tom-decay 0.25) (conga-decay 0.15))
   (trap (bd-tune 43.0) (bd-decay 2.2) (bd-tone 0.4) (bd-drive 0.6) (sd-tune 200.0)
         (sd-snappy 0.75) (sd-tone 0.75) (cp-decay 0.4) (hh-decay 0.05) (hh-level 0.6))
   (electro (bd-tune 56.0) (bd-decay 0.6) (bd-tone 0.8) (bd-drive 0.25) (sd-tune 205.0)
            (sd-snappy 0.65) (sd-tone 0.65) (cr-tone 0.7) (lt-tune 100.0) (mt-tune 145.0)
            (ht-tune 195.0))
   (dusty (bd-tune 48.0) (bd-decay 1.1) (bd-tone 0.1) (sd-tune 170.0) (sd-tone 0.15)
          (sd-snappy 0.4) (cp-decay 0.22) (hh-decay 0.07) (oh-decay 0.35) (cr-tone 0.2)
          (hh-level 0.55) (oh-level 0.55)))
  (sounds
   (bd 36) (rs 37) (sd 38) (cp 39) (hh 42) (lt 45) (oh 46) (mt 47) (cr 49) (ht 50)
   (cb 56) (hc 62) (mc 63) (lc 64) (ma 70) (cl 75)))

;;;;;;;;;;;;;;;;;;;;;
;; building blocks ;;
;;;;;;;;;;;;;;;;;;;;;

;; The filters, white noise, sine table, band-limited pulse and decay
;; multipliers are dsp.xtm's. What follows is what is particular to this kit.

(bind-macro
  "one frame of a square wave from the oscillator whose phase is number i of
the array ph, at freq Hz: -1.0 to 1.0, band-limited by blep_pulse. The
oscillators run freely from note to note, as the 808's do, so no two hits start
from quite the same place."
  (kit808_square ph i freq)
  `(let ((sq_inc:SAMPLE (/ ,freq SRf)))
     (let ((sq_phase:SAMPLE (+ (pref ,ph ,i) sq_inc)))
       (if (>= sq_phase 1.0) (set! sq_phase (- sq_phase 1.0)))
       (pset! ,ph ,i sq_phase)
       (blep_pulse sq_phase sq_inc 0.5))))

(bind-func kit808_metal_make
  "the six phases of the metal bank, each starting somewhere different"
  (lambda ()
    (let ((ph:SAMPLE* (zalloc 6)))
      (pset! ph 0 0.0) (pset! ph 1 0.31) (pset! ph 2 0.57)
      (pset! ph 3 0.13) (pset! ph 4 0.79) (pset! ph 5 0.44)
      ph)))

(bind-func static kit808_metal
  "the 808's metallic source: six square waves at unrelated frequencies,
summed. Their harmonics land everywhere, so the sum is a dense, clangorous
spectrum rather than a chord. ph is from kit808_metal_make."
  (lambda (ph:SAMPLE*)
    (* 0.1667 (+ (kit808_square ph 0 205.3) (kit808_square ph 1 304.4)
                 (kit808_square ph 2 369.6) (kit808_square ph 3 522.7)
                 (kit808_square ph 4 540.0) (kit808_square ph 5 800.0)))))

;;;;;;;;;;
;; kick ;;
;;;;;;;;;;

;; A sine, struck at full level, which dies away over as long as a couple of
;; seconds: that long, pure boom is the 808 kick. Its pitch starts a few
;; semitones sharp and settles within about 50 ms, as the hardware
;; resonator's does when the trigger pulse first hits it; a harder hit
;; starts further sharp, as it does in the circuit. On top sits the
;; click: the trigger pulse itself, leaking through a lowpass filter which the
;; tone control opens.
;;
;; A kick can be retriggered while the last one is still sounding. The last
;; output value is carried into the new note and faded out over a few
;; milliseconds (`carry`), so the jump doesn't click.

(bind-func kit808_bd_c
  (lambda (p:SAMPLE*)
    (let ((phase:SAMPLE 0.0)
          (amp:SAMPLE 0.0)
          (amp_coeff:SAMPLE 0.999)
          (sweep:SAMPLE 0.0)
          (sweep_coeff (decay_mult 0.15))
          (click:SAMPLE 0.0)
          (click_coeff:SAMPLE 0.5)
          (pulse_frames:i64 (convert (/ SRf 1600.0) i64))
          (vel:SAMPLE 0.0)
          (pre:SAMPLE 1.0) (pre_norm:SAMPLE 1.0)
          (sigh:SAMPLE 0.5)
          (y:SAMPLE 0.0)
          (last:SAMPLE 0.0)
          (carry:SAMPLE 0.0)
          (carry_coeff (decay_mult 0.02)))
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin
              (set! carry last)
              (set! phase 0.0)
              (set! amp 1.0)
              (set! sweep 1.0)
              (set! vel (voice_vel v))
              (set! sigh (+ 0.2 (* 0.3 vel)))))
        (if (= (% (voice_age v) 32) 0)
            (begin
              (set! amp_coeff (decay_mult (clampf (kit808_bd_decay p) 0.002 100.0)))
              ;; the tone control opens the click's lowpass from 600 Hz to 8 kHz
              (set! click_coeff (onepole_coeff (+ 600.0 (* 7400.0 (kit808_bd_tone p) vel))))
              (set! pre (+ 1.0 (* 5.0 (kit808_bd_drive p))))
              (set! pre_norm (/ 1.0 (tanh_fast pre)))))
        ;; the resonator
        (set! phase (+ phase (/ (* (kit808_bd_tune p) (+ 1.0 (* sigh sweep))) SRf)))
        (if (>= phase 1.0) (set! phase (- phase 1.0)))
        (set! y (* amp (sine_at phase)))
        (set! amp (* amp amp_coeff))
        (set! sweep (* sweep sweep_coeff))
        ;; the click: a 0.6 ms pulse through a one-pole lowpass. Its level goes
        ;; up with velocity as well as tone, so harder hits are clickier.
        (onepole_lp click click_coeff (if (< (voice_age v) pulse_frames) 1.0 0.0))
        (set! y (+ y (* (+ 0.1 (* 0.9 (kit808_bd_tone p))) vel click)))
        ;; drive: saturate, then scale back so that the peak stays put. The
        ;; flattened wave carries more energy, so turn it down a little too.
        (set! y (* pre_norm (tanh_fast (* pre y))))
        (set! y (* 0.42 (- 1.0 (* 0.35 (kit808_bd_drive p))) (kit808_bd_level p) vel y))
        (set! carry (* carry carry_coeff))
        (set! last (+ y carry))
        (frame_add_mono out last 0.5)
        (if (and (< amp 0.0005) (< (fabs carry) 0.0001))
            (begin (set! last 0.0) (voice_done v)))
        void))))

;;;;;;;;;;;
;; snare ;;
;;;;;;;;;;;

;; Two resonators for the drum, at roughly the ratio of a drum head's two
;; lowest modes, each starting a little sharp and falling quickly to pitch. White noise
;; through a highpass and a lowpass makes the snares. Tone and velocity open
;; the noise lowpass and bring up the upper resonator, so a harder hit is
;; brighter as well as louder.

(bind-func kit808_sd_c
  (lambda (p:SAMPLE*)
    (let ((seed:i64 4711)
          (hp (svf_make 1))
          (lp (svf_make 1))
          (phase1:SAMPLE 0.0) (phase2:SAMPLE 0.0)
          (env1:SAMPLE 0.0) (env2:SAMPLE 0.0) (env_noise:SAMPLE 0.0)
          (coeff1 (decay_mult 0.2))
          (coeff2 (decay_mult 0.13))
          (coeff_noise (decay_mult 0.28))
          (sweep:SAMPLE 0.0)
          (sweep_coeff (decay_mult 0.03))
          (vel:SAMPLE 0.0) (bright:SAMPLE 0.0) (last_bright:SAMPLE -1.0)
          (f:SAMPLE 0.0) (body:SAMPLE 0.0) (snares:SAMPLE 0.0)
          (last:SAMPLE 0.0) (carry:SAMPLE 0.0)
          (carry_coeff (decay_mult 0.02)))
      (svf_set hp 1800.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin
              (set! carry last)
              (set! phase1 0.0) (set! phase2 0.0)
              (set! env1 1.0) (set! env2 1.0) (set! env_noise 1.0)
              (set! sweep 1.0)
              (set! vel (voice_vel v))))
        (set! bright (* (kit808_sd_tone p) (+ 0.5 (* 0.5 vel))))
        (if (<> bright last_bright)
            (begin
              (set! last_bright bright)
              (svf_set lp (+ 4000.0 (* 9000.0 bright)) 0.7)))
        ;; the drum
        (set! f (* (kit808_sd_tune p) (+ 1.0 (* 0.12 sweep))))
        (set! phase1 (+ phase1 (/ f SRf)))
        (if (>= phase1 1.0) (set! phase1 (- phase1 1.0)))
        (set! phase2 (+ phase2 (/ (* 1.78 f) SRf)))
        (if (>= phase2 1.0) (set! phase2 (- phase2 1.0)))
        (set! body (+ (* env1 (sine_at phase1))
                      (* env2 (+ 0.35 (* 0.65 bright)) (sine_at phase2))))
        ;; the snares
        (set! snares (svf_lp lp (svf_hp hp (noise_white seed))))
        (set! snares (* env_noise (+ 0.3 (* 1.2 (kit808_sd_snappy p) (+ 0.6 (* 0.4 vel)))) snares))
        (set! env1 (* env1 coeff1))
        (set! env2 (* env2 coeff2))
        (set! env_noise (* env_noise coeff_noise))
        (set! sweep (* sweep sweep_coeff))
        (set! carry (* carry carry_coeff))
        (set! last (+ (* 0.22 (kit808_sd_level p) vel (+ (* 0.75 body) snares)) carry))
        (frame_add_mono out last 0.5)
        (if (and (< env_noise 0.001) (< env1 0.001) (< (fabs carry) 0.0001))
            (begin (set! last 0.0) (voice_done v)))
        void))))

;;;;;;;;;;
;; clap ;;
;;;;;;;;;;

;; Noise through a bandpass around 1 kHz. Its envelope snaps open and dies
;; three times, 11 ms apart, then opens once more and fades over cp-decay:
;; the bursts are the separate hands, and the tail is the room.

(bind-func kit808_cp_c
  (lambda (p:SAMPLE*)
    (let ((seed:i64 90210)
          (bp (svf_make 1))
          (hp (svf_make 1))
          (env:SAMPLE 0.0)
          (burst_coeff (decay_mult 0.02))
          (tail_coeff:SAMPLE 0.999)
          (spacing:i64 (convert (/ SRf 90.0) i64))
          (age:i64 0)
          (tail:i1 #f)
          (vel:SAMPLE 0.0)
          (y:SAMPLE 0.0))
      (svf_set hp 400.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (set! age (voice_age v))
        (if (voice_start? v)
            (begin
              (set! env 1.0)
              (set! tail #f)
              (set! vel (voice_vel v))
              (svf_set bp (+ 900.0 (* 350.0 vel)) 1.6)))
        (if (or (= age spacing) (= age (* 2 spacing)))
            (set! env 1.0))
        (if (= age (* 3 spacing))
            (begin (set! env 0.8) (set! tail #t)))
        (if (= (% age 32) 0)
            (set! tail_coeff (decay_mult (clampf (kit808_cp_decay p) 0.002 100.0))))
        ;; the highpass comes after the envelope, to take out the thump of
        ;; each burst's sudden start
        (set! y (* env (svf_bp bp (noise_white seed))))
        (set! y (svf_hp hp y))
        (set! env (* env (if tail tail_coeff burst_coeff)))
        (frame_add_mono out (* 0.88 (kit808_cp_level p) vel y) 0.52)
        (if (and tail (< env 0.001))
            (voice_done v))
        void))))

;;;;;;;;;;;;;
;; hi-hats ;;
;;;;;;;;;;;;;

;; The metal bank through a bandpass at 8 kHz, an envelope, and a highpass
;; which takes away what's left of the low end. Pitch 42 plays the closed
;; hat and 46 the open one; both are mapped to this one voice, so each cuts
;; the other off. Velocity pushes the bandpass up a little.

(bind-func kit808_hh_c
  (lambda (p:SAMPLE*)
    (let ((metal (kit808_metal_make))
          (bp (svf_make 1))
          (hp (svf_make 1))
          (env:SAMPLE 0.0)
          (coeff:SAMPLE 0.99)
          (open:i1 #f)
          (vel:SAMPLE 0.0)
          (level:SAMPLE 0.0)
          (y:SAMPLE 0.0))
      (svf_set hp 6500.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin
              (set! env 1.0)
              (set! open (> (voice_pitch v) 44.0))
              (set! vel (voice_vel v))
              (svf_set bp (+ 7000.0 (* 2000.0 vel)) 1.2)))
        (if (= (% (voice_age v) 32) 0)
            (begin
              (set! coeff (decay_mult (clampf (if open (kit808_oh_decay p) (kit808_hh_decay p)) 0.002 100.0)))
              (set! level (if open (kit808_oh_level p) (kit808_hh_level p)))))
        (set! y (svf_bp bp (kit808_metal metal)))
        (set! y (svf_hp hp (* env y)))
        (set! env (* env coeff))
        (frame_add_mono out (* 2.4 level vel y) 0.62)
        (if (< env 0.001)
            (voice_done v))
        void))))

;;;;;;;;;;;;
;; cymbal ;;
;;;;;;;;;;;;

;; The same metal bank, split in two. A band around 3.4 kHz gives the cymbal
;; its clang and dies away quickly; a band from 7 kHz up is the shimmer, and
;; lasts the full cr-decay. Tone and velocity set the balance between them.

(bind-func kit808_cr_c
  (lambda (p:SAMPLE*)
    (let ((metal (kit808_metal_make))
          (bp_low (svf_make 1))
          (bp_high (svf_make 1))
          (hp (svf_make 1))
          (env_low:SAMPLE 0.0) (env_high:SAMPLE 0.0)
          (coeff_low:SAMPLE 0.99) (coeff_high:SAMPLE 0.99)
          (vel:SAMPLE 0.0) (bright:SAMPLE 0.0)
          (x:SAMPLE 0.0) (y:SAMPLE 0.0))
      (svf_set bp_low 3400.0 2.0)
      (svf_set bp_high 8000.0 0.8)
      (svf_set hp 6000.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin (set! env_low 1.0) (set! env_high 1.0) (set! vel (voice_vel v))))
        (if (= (% (voice_age v) 32) 0)
            (begin
              (set! coeff_low (decay_mult (clampf (* 0.3 (kit808_cr_decay p)) 0.002 100.0)))
              (set! coeff_high (decay_mult (clampf (kit808_cr_decay p) 0.002 100.0)))
              (set! bright (* (kit808_cr_tone p) (+ 0.6 (* 0.4 vel))))))
        (set! x (kit808_metal metal))
        (set! y (+ (* env_low (- 1.0 (* 0.6 bright)) (svf_bp bp_low x))
                   (* env_high (+ 0.5 bright) (svf_hp hp (svf_bp bp_high x)))))
        (set! env_low (* env_low coeff_low))
        (set! env_high (* env_high coeff_high))
        (frame_add_mono out (* 0.95 (kit808_cr_level p) vel y) 0.38)
        (if (< env_high 0.001)
            (voice_done v))
        void))))

;;;;;;;;;;;;;;;;;;;;;
;; toms and congas ;;
;;;;;;;;;;;;;;;;;;;;;

;; The toms and congas are the same circuit at different tunings. Each is a
;; resonator whose pitch falls a little at the start. The toms have more of
;; that fall and a puff of low noise, which the congas don't.
;;
;; `which` says which drum this voice plays: 0 low tom, 1 mid tom, 2 high
;; tom, 3 low conga, 4 mid conga, 5 high conga.

(bind-func static kit808_tom_tune
  (lambda (p:SAMPLE* which:i64)
    (cond ((= which 0) (kit808_lt_tune p))
          ((= which 1) (kit808_mt_tune p))
          ((= which 2) (kit808_ht_tune p))
          ((= which 3) (kit808_lc_tune p))
          ((= which 4) (kit808_mc_tune p))
          (else (kit808_hc_tune p)))))

(bind-func static kit808_tom_level
  (lambda (p:SAMPLE* which:i64)
    (cond ((= which 0) (kit808_lt_level p))
          ((= which 1) (kit808_mt_level p))
          ((= which 2) (kit808_ht_level p))
          ((= which 3) (kit808_lc_level p))
          ((= which 4) (kit808_mc_level p))
          (else (kit808_hc_level p)))))

(bind-func kit808_tom_c
  (lambda (p:SAMPLE* which:i64 pan:SAMPLE)
    (let ((seed:i64 (+ 17 which))
          (lp (svf_make 1))
          (conga (> which 2))
          (depth:SAMPLE (if (> which 2) 0.06 0.18))
          (phase:SAMPLE 0.0)
          (amp:SAMPLE 0.0) (amp_coeff:SAMPLE 0.999)
          (sweep:SAMPLE 0.0)
          (sweep_coeff (decay_mult (if (> which 2) 0.04 0.2)))
          (env_noise:SAMPLE 0.0)
          (noise_coeff (decay_mult 0.12))
          (vel:SAMPLE 0.0) (y:SAMPLE 0.0)
          (last:SAMPLE 0.0) (carry:SAMPLE 0.0)
          (carry_coeff (decay_mult 0.02)))
      (svf_set lp 1200.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin
              (set! carry last)
              (set! phase 0.0) (set! amp 1.0) (set! sweep 1.0)
              (set! env_noise (if conga 0.0 1.0))
              (set! vel (voice_vel v))))
        (if (= (% (voice_age v) 32) 0)
            (set! amp_coeff (decay_mult (clampf (if conga (kit808_conga_decay p) (kit808_tom_decay p)) 0.002 100.0))))
        (set! phase (+ phase (/ (* (kit808_tom_tune p which) (+ 1.0 (* depth sweep))) SRf)))
        (if (>= phase 1.0) (set! phase (- phase 1.0)))
        (set! y (+ (* amp (sine_at phase))
                   (* env_noise 0.25 vel (svf_lp lp (noise_white seed)))))
        (set! amp (* amp amp_coeff))
        (set! sweep (* sweep sweep_coeff))
        (set! env_noise (* env_noise noise_coeff))
        (set! carry (* carry carry_coeff))
        (set! last (+ (* 0.3 (kit808_tom_level p which) vel y) carry))
        (frame_add_mono out last pan)
        (if (and (< amp 0.001) (< (fabs carry) 0.0001))
            (begin (set! last 0.0) (voice_done v)))
        void))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; rim shot, claves, maracas and cowbell ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The rim shot is two very short resonators (500 Hz and 1.7 kHz), clipped
;; for bite and highpassed so it's all knock and no body.

(bind-func kit808_rs_c
  (lambda (p:SAMPLE*)
    (let ((hp (svf_make 1))
          (phase1:SAMPLE 0.0) (phase2:SAMPLE 0.0)
          (env:SAMPLE 0.0) (coeff (decay_mult 0.035))
          (vel:SAMPLE 0.0) (y:SAMPLE 0.0))
      (svf_set hp 350.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin (set! phase1 0.0) (set! phase2 0.0) (set! env 1.0) (set! vel (voice_vel v))))
        (set! phase1 (+ phase1 (/ 500.0 SRf)))
        (if (>= phase1 1.0) (set! phase1 (- phase1 1.0)))
        (set! phase2 (+ phase2 (/ 1700.0 SRf)))
        (if (>= phase2 1.0) (set! phase2 (- phase2 1.0)))
        (set! y (* env (+ (* 0.6 (sine_at phase1)) (sine_at phase2))))
        (set! y (svf_hp hp (tanh_fast (* 2.0 y))))
        (set! env (* env coeff))
        (frame_add_mono out (* 0.21 (kit808_rs_level p) vel y) 0.45)
        (if (< env 0.001) (voice_done v))
        void))))

;; The claves are a single resonator at 2.5 kHz with a short ring.

(bind-func kit808_cl_c
  (lambda (p:SAMPLE*)
    (let ((phase:SAMPLE 0.0)
          (env:SAMPLE 0.0) (coeff (decay_mult 0.09))
          (vel:SAMPLE 0.0))
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin (set! phase 0.0) (set! env 1.0) (set! vel (voice_vel v))))
        (set! phase (+ phase (/ 2500.0 SRf)))
        (if (>= phase 1.0) (set! phase (- phase 1.0)))
        (frame_add_mono out (* 0.23 (kit808_cl_level p) vel env (sine_at phase)) 0.36)
        (set! env (* env coeff))
        (if (< env 0.001) (voice_done v))
        void))))

;; The maracas are highpassed noise with a soft 4 ms attack and a short fade.

(bind-func kit808_ma_c
  (lambda (p:SAMPLE*)
    (let ((seed:i64 31337)
          (hp (svf_make 1))
          (rise:SAMPLE 0.0) (rise_coeff (smoothing_coeff 0.004))
          (env:SAMPLE 0.0) (coeff (decay_mult 0.08))
          (vel:SAMPLE 0.0))
      (svf_set hp 5500.0 0.8)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin (set! rise 0.0) (set! env 1.0) (set! vel (voice_vel v))))
        (onepole_lp rise rise_coeff 1.0)
        (frame_add_mono out (* 0.56 (kit808_ma_level p) vel rise env (svf_hp hp (noise_white seed))) 0.66)
        (set! env (* env coeff))
        (if (< env 0.001) (voice_done v))
        void))))

;; The cowbell is two of the metal bank's square waves, 540 and 800 Hz,
;; through a bandpass. Its envelope is two decays added together: a sharp
;; one for the strike and a longer one for the ring.

(bind-func kit808_cb_c
  (lambda (p:SAMPLE*)
    (let ((ph:SAMPLE* (zalloc 2))
          (bp (svf_make 1))
          (lp (svf_make 1))
          (strike:SAMPLE 0.0) (strike_coeff (decay_mult 0.05))
          (ring:SAMPLE 0.0) (ring_coeff (decay_mult 0.45))
          (vel:SAMPLE 0.0) (y:SAMPLE 0.0))
      (pset! ph 0 0.0)
      (pset! ph 1 0.25)
      (svf_set bp 1000.0 1.2)
      (svf_set lp 4000.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin (set! strike 1.0) (set! ring 1.0) (set! vel (voice_vel v))))
        (set! y (svf_lp lp (svf_bp bp (+ (kit808_square ph 0 540.0) (kit808_square ph 1 800.0)))))
        (set! y (* (+ (* 0.65 strike) (* 0.35 ring)) y))
        (set! strike (* strike strike_coeff))
        (set! ring (* ring ring_coeff))
        (frame_add_mono out (* 0.14 (kit808_cb_level p) vel y) 0.58)
        (if (< ring 0.001) (voice_done v))
        void))))

;;;;;;;;;;;;;;;;;;;;
;; making the kit ;;
;;;;;;;;;;;;;;;;;;;;

;; voice numbers: 0 kick, 1 rim shot, 2 snare, 3 clap, 4 hi-hats (closed and
;; open), 5-7 toms, 8 cymbal, 9 cowbell, 10 maracas, 11 claves, 12-14 congas
(bind-func kit808_make
  (lambda ()
    (let ((inst (inst_make "kit808" 15 (kit808_nparams)))
          (p (inst_params inst)))
      (kit808_defaults p)
      (inst_set_mode inst INST_KEYED)
      (inst_set_voice inst 0 (kit808_bd_c (inst_voice_params inst 0)))
      (inst_set_voice inst 1 (kit808_rs_c (inst_voice_params inst 1)))
      (inst_set_voice inst 2 (kit808_sd_c (inst_voice_params inst 2)))
      (inst_set_voice inst 3 (kit808_cp_c (inst_voice_params inst 3)))
      (inst_set_voice inst 4 (kit808_hh_c (inst_voice_params inst 4)))
      (inst_set_voice inst 5 (kit808_tom_c (inst_voice_params inst 5) 0 0.4))
      (inst_set_voice inst 6 (kit808_tom_c (inst_voice_params inst 6) 1 0.5))
      (inst_set_voice inst 7 (kit808_tom_c (inst_voice_params inst 7) 2 0.6))
      (inst_set_voice inst 8 (kit808_cr_c (inst_voice_params inst 8)))
      (inst_set_voice inst 9 (kit808_cb_c (inst_voice_params inst 9)))
      (inst_set_voice inst 10 (kit808_ma_c (inst_voice_params inst 10)))
      (inst_set_voice inst 11 (kit808_cl_c (inst_voice_params inst 11)))
      (inst_set_voice inst 12 (kit808_tom_c (inst_voice_params inst 12) 3 0.62))
      (inst_set_voice inst 13 (kit808_tom_c (inst_voice_params inst 13) 4 0.55))
      (inst_set_voice inst 14 (kit808_tom_c (inst_voice_params inst 14) 5 0.45))
      (inst_map_key inst 36 0)
      (inst_map_key inst 37 1)
      (inst_map_key inst 38 2)
      (inst_map_key inst 39 3)
      (inst_map_key inst 42 4)
      (inst_map_key inst 46 4)
      (inst_map_key inst 45 5)
      (inst_map_key inst 47 6)
      (inst_map_key inst 50 7)
      (inst_map_key inst 49 8)
      (inst_map_key inst 56 9)
      (inst_map_key inst 70 10)
      (inst_map_key inst 75 11)
      (inst_map_key inst 64 12)
      (inst_map_key inst 63 13)
      (inst_map_key inst 62 14)
      inst)))
