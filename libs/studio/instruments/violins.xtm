;;; violins.xtm -- a violin section, sustained with vibrato

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; A violin section playing long bowed notes with vibrato, at two
;; dynamics. The recordings last 9 to 15 seconds, so the loader finds a
;; steady stretch of each to repeat for as long as the key is held. It also
;; levels the recordings to one loudness, so that the dynamics parameter
;; alone sets how loud a note is.
;;
;; The samples are CC0 (public domain), from
;; the Versilian Studios Chamber Orchestra, Community Edition (VSCO 2 CE).
;; They live in assets/studio/VSCO-2-CE, and this
;; file is a thin wrapper which loads the library's SFZ file into a
;; sampler (libs/studio/sampler.xtm): the SFZ says which recording plays
;; on each key and velocity. Without the assets folder the instrument
;; prints where it looked, and is silent.

;;; Code:

(sys:load-preload-check 'studio-violins)
(define *xtmlib-studio-violins-loaded* #t)

(sys:load "libs/studio/sampler.xtm")

(def-instrument violins
                "a sampled violin section, sustained (VSCO 2 CE)"
                ;; the engine reads these seven by position (see *sampler:params*)
                (params
                 (attack 0.08 "seconds to fade in")
                 (release 0.8 "seconds for a released note to fade by 60 dB")
                 (tune 0.0 "transpose, in semitones")
                 (dynamics 18.0 "how much quieter a soft note is: dB between velocity 1.0 and 0.1")
                 (hardness 0.0 "-1.0 to 1.0: plays a softer or harder layer than the velocity would, at the same level")
                 (length 0.0 "seconds after which every note fades out (0.0: no limit)")
                 (level 1.0 "output level"))
                (presets
                 (section)
                 (swell (attack 0.8) (release 1.5))
                 (soft (hardness -0.5) (dynamics 12.0))
                 (short (attack 0.02) (length 0.3) (release 0.15))
                 (low (tune -12.0))
                 (high (tune 12.0))))

(bind-func violins_make
  (lambda ()
    (let ((inst (sampler_inst_make "violins" 32 (violins_nparams))))
      (violins_defaults (inst_params inst))
      inst)))

(define violins-setup
  (lambda (inst)
    (sampler:setup-sfz inst 'violins "VSCO-2-CE/ViolinEnsSusVib.sfz" '(loop) '(match -22.5 16 0.6))))
