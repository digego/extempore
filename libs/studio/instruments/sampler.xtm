;;; sampler.xtm -- an empty sampler to load your own samples into

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; Put this on a track, then load an SFZ instrument or a folder of samples
;; into it:
;;
;;   (track 'keys 'sampler)
;;   (sampler-load 'keys "assets/studio/some-library/instrument.sfz")
;;
;;   (track 'perc 'sampler)
;;   (sampler-load-folder 'perc "~/samples/my-kit" 'drums)
;;
;; A folder's files are named by MIDI note number (36.wav, 37.aif ...).
;; 'drums plays each file on its own key, at its recorded pitch and to its
;; end. Without it, each file is also spread across the keys up to halfway
;; to its neighbours, and transposed to fit, which suits a pitched
;; instrument recorded every few notes.
;;
;; Loading again replaces what the track held; notes already sounding play
;; on. libs/studio/sampler.xtm is the engine, and describes the SFZ opcodes
;; it understands.

;;; Code:

(sys:load-preload-check 'studio-instrument-sampler)
(define *xtmlib-studio-instrument-sampler-loaded* #t)

(sys:load "libs/studio/sampler.xtm")

(def-instrument sampler
  "an empty sampler: load an SFZ file or a folder of samples into it"
  ;; the engine reads these seven by position (see *sampler:params*)
  (params
   (attack 0.002 "seconds to fade in (a region's ampeg_attack applies if it's longer)")
   (release 0.3 "seconds for a released note to fade by 60 dB (a region's ampeg_release applies if it's longer)")
   (tune 0.0 "transpose, in semitones")
   (dynamics 30.0 "how much quieter a soft note is: dB between velocity 1.0 and 0.1")
   (hardness 0.0 "-1.0 to 1.0: shifts which velocity layer plays without changing the level")
   (length 0.0 "seconds after which every note fades out over the release parameter's time, even a one-shot (0.0: no limit)")
   (level 0.5 "output level"))
  (presets
   (plain)
   (gentle (dynamics 18.0) (hardness -0.25))
   (hard (dynamics 24.0) (hardness 0.3))
   (short (release 0.08) (length 0.25))
   (swell (attack 0.4) (release 2.0))
   (down (tune -12.0) (release 1.0))
   (up (tune 12.0) (release 0.15))))

(bind-func sampler_make
  (lambda ()
    (let ((inst (sampler_inst_make "sampler" 32 (sampler_nparams))))
      (sampler_defaults (inst_params inst))
      inst)))

(define sampler-setup
  (lambda (inst)
    (sampler:check-params 'sampler)))
