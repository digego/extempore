;;; ukulele.xtm -- a tenor ukulele

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; A tenor ukulele, plucked. The SFZ also maps a tap on the body and a
;; muted strum to keys 47 and 48, below the instrument's range; the lowest
;; note's recording is spread down to key 49 so that the keys between play.
;; The recordings are levelled to one loudness, so that the dynamics
;; parameter alone sets how loud a note is.
;;
;; The samples are CC0 (public domain), from
;; FreePats (Ukulele).
;; They live in assets/studio/freepats-ukulele, and this
;; file is a thin wrapper which loads the library's SFZ file into a
;; sampler (libs/studio/sampler.xtm): the SFZ says which recording plays
;; on each key and velocity. Without the assets folder the instrument
;; prints where it looked, and is silent.

;;; Code:

(sys:load-preload-check 'studio-ukulele)
(define *xtmlib-studio-ukulele-loaded* #t)

(sys:load "libs/studio/sampler.xtm")

(def-instrument ukulele
                "a sampled tenor ukulele (FreePats Ukulele)"
                ;; the engine reads these seven by position (see *sampler:params*)
                (params
                 (attack 0.002 "seconds to fade in")
                 (release 0.4 "seconds for a released note to fade by 60 dB")
                 (tune 0.0 "transpose, in semitones")
                 (dynamics 22.0 "how much quieter a soft note is: dB between velocity 1.0 and 0.1")
                 (hardness 0.0 "-1.0 to 1.0: plays a softer or harder layer than the velocity would, at the same level")
                 (length 0.0 "seconds after which every note fades out (0.0: no limit)")
                 (level 1.0 "output level"))
                (presets
                 (plucked)
                 (muted (length 0.15) (release 0.05))
                 (ringing (release 1.5))
                 (soft (dynamics 14.0))
                 (low (tune -12.0))))

(bind-func ukulele_make
  (lambda ()
    (let ((inst (sampler_inst_make "ukulele" 32 (ukulele_nparams))))
      (ukulele_defaults (inst_params inst))
      inst)))

(define ukulele-setup
  (lambda (inst)
    (sampler:setup-sfz inst 'ukulele "freepats-ukulele/Ukulele 20260811.sfz" '(match -20.0) '(keep-out 47 48))))
