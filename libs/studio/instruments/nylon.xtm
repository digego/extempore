;;; nylon.xtm -- a Spanish classical guitar

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; A nylon-string classical guitar, recorded with one microphone and its
;; noise filtered out, which gives it a slightly lo-fi character. The
;; recordings are levelled to one loudness, so that the dynamics parameter
;; alone sets how loud a note is, and tuned down 5 cents (the set is that
;; far sharp of A = 440 Hz).
;;
;; The samples are CC0 (public domain), from
;; FreePats (the Spanish Classical Guitar).
;; They live in assets/studio/freepats-spanish-classical-guitar, and this
;; file is a thin wrapper which loads the library's SFZ file into a
;; sampler (libs/studio/sampler.xtm): the SFZ says which recording plays
;; on each key and velocity. Without the assets folder the instrument
;; prints where it looked, and is silent.

;;; Code:

(sys:load-preload-check 'studio-nylon)
(define *xtmlib-studio-nylon-loaded* #t)

(sys:load "libs/studio/sampler.xtm")

(def-instrument nylon
  "a sampled nylon-string guitar (FreePats Spanish Classical Guitar)"
  ;; the engine reads these seven by position (see *sampler:params*)
  (params
    (attack 0.002 "seconds to fade in")
    (release 0.8 "seconds for a released note to fade by 60 dB")
    (tune 0.0 "transpose, in semitones")
    (dynamics 24.0 "how much quieter a soft note is: dB between velocity 1.0 and 0.1")
    (hardness 0.0 "-1.0 to 1.0: plays a softer or harder layer than the velocity would, at the same level")
    (length 0.0 "seconds after which every note fades out (0.0: no limit)")
    (level 1.0 "output level"))
  (presets
    (classical)
    (muted (length 0.2) (release 0.08))
    (soft (dynamics 16.0) (hardness -0.4))
    (ringing (release 2.0))
    (high (tune 12.0))))

(bind-func nylon_make
  (lambda ()
    (let ((inst (sampler_inst_make "nylon" 32 (nylon_nparams))))
      (nylon_defaults (inst_params inst))
      inst)))

(define nylon-setup
  (lambda (inst)
    (sampler:setup-sfz inst 'nylon "freepats-spanish-classical-guitar/SpanishClassicalGuitar-20190618.sfz" '(match -19.5) '(tune -5.0))))
