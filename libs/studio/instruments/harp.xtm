;;; harp.xtm -- a concert harp

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; A concert harp, plucked at two dynamics. Its strings ring on until
;; the harpist damps them, which here is the release time. The recordings
;; are levelled to one loudness, so that the dynamics parameter alone sets
;; how loud a note is, and tuned up 12 cents (the set is that far flat of
;; A = 440 Hz).
;;
;; The samples are CC0 (public domain), from
;; the Versilian Studios Chamber Orchestra, Community Edition (VSCO 2 CE).
;; They live in assets/studio/VSCO-2-CE, and this
;; file is a thin wrapper which loads the library's SFZ file into a
;; sampler (libs/studio/sampler.xtm): the SFZ says which recording plays
;; on each key and velocity. Without the assets folder the instrument
;; prints where it looked, and is silent.

;;; Code:

(sys:load-preload-check 'studio-harp)
(define *xtmlib-studio-harp-loaded* #t)

(sys:load "libs/studio/sampler.xtm")

(def-instrument harp
  "a sampled concert harp (VSCO 2 CE)"
  ;; the engine reads these seven by position (see *sampler:params*)
  (params
   (attack 0.002 "seconds to fade in")
   (release 3.0 "seconds for a released note to fade by 60 dB")
   (tune 0.0 "transpose, in semitones")
   (dynamics 24.0 "how much quieter a soft note is: dB between velocity 1.0 and 0.1")
   (hardness 0.0 "-1.0 to 1.0: plays a softer or harder layer than the velocity would, at the same level")
   (length 0.0 "seconds after which every note fades out (0.0: no limit)")
   (level 1.0 "output level"))
  (presets
   (concert)
   (ringing (release 8.0))
   (damped (release 0.2) (length 0.4))
   (soft (hardness -0.5) (dynamics 16.0))
   (high (tune 12.0))
   (low (tune -12.0) (release 5.0))))

(bind-func harp_make
  (lambda ()
    (let ((inst (sampler_inst_make "harp" 32 (harp_nparams))))
      (harp_defaults (inst_params inst))
      inst)))

(define harp-setup
  (lambda (inst)
    (sampler:setup-sfz inst 'harp "VSCO-2-CE/Harp.sfz" '(match -23.0 20) '(tune 12.0))))
