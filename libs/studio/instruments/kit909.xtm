;;; kit909.xtm -- a synthesised drum machine in the style of the TR-909

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; A drum kit in the style of the Roland TR-909. Each sound has its own voice,
;; and the notes follow General MIDI: 36 kick, 38 snare, 42 closed hat and so
;; on (the sounds clause below lists them all).
;;
;; The 909's drums were analogue circuits, and this file follows them:
;;
;; - The kick is an oscillator whose pitch starts several octaves up and
;;   falls to the note within about 50 ms. Most of the fall happens in the
;;   first few milliseconds, which is the punch; the rest is a slower settle
;;   which gives the kick its body. A short click of filtered noise and a
;;   pulse sits on the front.
;; - The snare is two oscillators for the drum and white noise for the
;;   snares, with separate controls for the brightness of the noise (tone)
;;   and its level (snappy).
;; - The toms are oscillators with a falling pitch, like the kick but
;;   gentler, with a little noise for the stick.
;; - The clap and rim shot are filtered noise and short resonators, much as
;;   on the 808.
;;
;; The 909's hi-hats and cymbals were short digital recordings, not circuits.
;; Here they are synthesised. Each starts from banks of square waves at
;; unrelated frequencies (as the 808 did), mixed with white noise for the
;; hats or multiplied together for the cymbals, which gives a denser and more
;; tangled spectrum. Bandpass and highpass filters then put the energy where
;; the 909's recordings have it: the hats high and crisp, the crash broad,
;; and the ride a ringing ping over a quieter wash.
;;
;; Velocity sets the level of every sound, and on most it also sets the tone:
;; a harder kick has more click and more punch, a harder snare or clap is
;; brighter.
;;
;; The closed and open hi-hats share one voice, so either one cuts the other
;; off, as on the original.
;;
;; This is an original implementation, built from published descriptions of
;; the 909's circuits and its sound.

;;; Code:

(sys:load-preload-check 'studio-kit909)
(define *xtmlib-studio-kit909-loaded* #t)

(sys:load "libs/studio/api.xtm")

(def-instrument kit909
  "a synthesised drum machine in the style of the TR-909"
  (params
    (bd-tune 52.0 "kick pitch in Hz, once the sweep has settled")
    (bd-sweep 0.6 "how far the kick's pitch falls at the start, 0.0 to 1.0")
    (bd-attack 0.5 "kick click, 0.0 to 1.0")
    (bd-decay 0.5 "seconds for the kick to die away")
    (bd-drive 0.0 "kick saturation, 0.0 to 1.0")
    (bd-level 0.7 "kick level, 0.0 to 1.0")
    (sd-tune 190.0 "snare pitch in Hz (the lower of its two tones)")
    (sd-tone 0.5 "snare brightness, 0.0 to 1.0")
    (sd-snappy 0.6 "how loud the snares are against the drum, 0.0 to 1.0")
    (sd-level 0.7 "snare level, 0.0 to 1.0")
    (rs-level 0.7 "rim shot level, 0.0 to 1.0")
    (cp-decay 0.4 "seconds for the clap's tail to die away")
    (cp-level 0.7 "clap level, 0.0 to 1.0")
    (hh-decay 0.1 "seconds for the closed hi-hat to die away")
    (hh-level 0.7 "closed hi-hat level, 0.0 to 1.0")
    (oh-decay 0.6 "seconds for the open hi-hat to die away")
    (oh-level 0.7 "open hi-hat level, 0.0 to 1.0")
    (cr-decay 2.2 "seconds for the crash cymbal to die away")
    (cr-tone 0.5 "crash brightness, 0.0 to 1.0")
    (cr-level 0.7 "crash level, 0.0 to 1.0")
    (rd-decay 2.5 "seconds for the ride cymbal to die away")
    (rd-level 0.7 "ride level, 0.0 to 1.0")
    (tom-decay 0.5 "seconds for the toms to die away")
    (lt-tune 95.0 "low tom pitch in Hz")
    (lt-level 0.7 "low tom level, 0.0 to 1.0")
    (mt-tune 135.0 "mid tom pitch in Hz")
    (mt-level 0.7 "mid tom level, 0.0 to 1.0")
    (ht-tune 185.0 "high tom pitch in Hz")
    (ht-level 0.7 "high tom level, 0.0 to 1.0"))
  (presets
    (classic)
    (hard (bd-tune 50.0) (bd-sweep 0.85) (bd-attack 0.9) (bd-decay 0.35) (bd-drive 0.3)
          (sd-tone 0.8) (sd-snappy 0.7) (hh-decay 0.06) (oh-decay 0.35) (cr-tone 0.75))
    (deep (bd-tune 45.0) (bd-sweep 0.45) (bd-attack 0.25) (bd-decay 0.9) (sd-tune 175.0)
          (sd-tone 0.3) (sd-snappy 0.45) (cp-decay 0.55) (oh-decay 0.8) (cr-tone 0.3))
    (house (bd-decay 0.6) (bd-attack 0.4) (sd-snappy 0.5) (cp-decay 0.5) (hh-decay 0.08)
           (oh-decay 0.4) (rd-decay 3.0))
    (tight (bd-tune 56.0) (bd-sweep 0.7) (bd-attack 0.7) (bd-decay 0.25) (sd-tune 210.0)
           (sd-snappy 0.75) (sd-tone 0.65) (cp-decay 0.2) (hh-decay 0.045) (oh-decay 0.25)
           (cr-decay 1.2) (rd-decay 1.5) (tom-decay 0.3))
    (rave (bd-tune 48.0) (bd-sweep 0.9) (bd-attack 0.8) (bd-decay 0.7) (bd-drive 0.85)
          (sd-tone 0.7) (cp-decay 0.3) (hh-decay 0.07) (oh-decay 0.45)))
  (sounds
    (bd 36) (rs 37) (sd 38) (cp 39) (hh 42) (lt 45) (oh 46) (mt 47) (cr 49) (ht 50) (rd 51)))

;;;;;;;;;;;;;;;;;;;;;
;; building blocks ;;
;;;;;;;;;;;;;;;;;;;;;

;; The filters, white noise, sine table, band-limited pulse and decay
;; multipliers are dsp.xtm's. What follows is what is particular to this kit.

(bind-func static kit909_shape
  "soft saturation: tanh, scaled so that an input of 1.0 still gives 1.0.
`drive` 1.0 is nearly clean; more bends the waveform towards a square."
  (lambda (x:SAMPLE drive:SAMPLE)
    (/ (tanh (* drive x)) (tanh drive))))

(bind-macro
  "one frame of a square wave from the oscillator whose phase is number i of
the array ph, at freq Hz: -1.0 to 1.0, band-limited by blep_pulse. The
oscillators run freely from note to note, so no two hits start from quite the
same place."
  (kit909_square ph i freq)
  `(let ((sq_inc:SAMPLE (/ ,freq SRf)))
     (let ((sq_phase:SAMPLE (+ (pref ,ph ,i) sq_inc)))
       (if (>= sq_phase 1.0) (set! sq_phase (- sq_phase 1.0)))
       (pset! ,ph ,i sq_phase)
       (blep_pulse sq_phase sq_inc 0.5))))

(bind-func kit909_metal_make
  "the six phases of a metal bank, each starting somewhere different"
  (lambda ()
    (let ((ph:SAMPLE* (zalloc 6)))
      (pset! ph 0 0.0) (pset! ph 1 0.31) (pset! ph 2 0.57)
      (pset! ph 3 0.13) (pset! ph 4 0.79) (pset! ph 5 0.44)
      ph)))

(bind-func static kit909_metal
  "six square waves at unrelated frequencies, summed: a dense, clangorous
spectrum. `scale` moves all six together, so that two banks made with
different scales share no partials. ph is from kit909_metal_make."
  (lambda (ph:SAMPLE* scale:SAMPLE)
    (* 0.1667 (+ (kit909_square ph 0 (* scale 263.0)) (kit909_square ph 1 (* scale 401.5))
                 (kit909_square ph 2 (* scale 433.7)) (kit909_square ph 3 (* scale 562.9))
                 (kit909_square ph 4 (* scale 683.3)) (kit909_square ph 5 (* scale 891.6))))))

;;;;;;;;;;
;; kick ;;
;;;;;;;;;;

;; The pitch envelope has two parts which decay at different rates: a fast
;; one (gone in about 30 ms) which starts the kick several octaves up, and a
;; slow one (about 250 ms) which bends the last stretch down to the note.
;; bd-sweep scales both, and velocity adds a little.
;;
;; The oscillator is a sine pushed gently into tanh, which rounds its peaks
;; towards a square and adds the odd harmonics that make a 909 kick sound
;; harder than an 808's. The click is a short pulse plus a burst of
;; bandpassed noise, and bd-attack sets its level.
;;
;; A kick can be retriggered while the last one is still sounding. The last
;; output value is carried into the new note and faded out over a few
;; milliseconds (`carry`), so the jump doesn't click.

(bind-func kit909_bd_c
  (lambda (p:SAMPLE*)
    (let ((seed:i64 909)
          (click_bp (svf_make 1))
          (phase:SAMPLE 0.0)
          (amp:SAMPLE 0.0) (amp_coeff:SAMPLE 0.999)
          (fast:SAMPLE 0.0) (fast_coeff (decay_mult 0.03))
          (slow:SAMPLE 0.0) (slow_coeff (decay_mult 0.25))
          (depth:SAMPLE 0.0)
          (pulse:SAMPLE 0.0) (pulse_coeff (onepole_coeff 5000.0))
          (pulse_frames:i64 (convert (/ SRf 2000.0) i64))
          (burst:SAMPLE 0.0) (burst_coeff (decay_mult 0.015))
          (vel:SAMPLE 0.0) (pre:SAMPLE 1.0)
          (y:SAMPLE 0.0) (click:SAMPLE 0.0)
          (last:SAMPLE 0.0) (carry:SAMPLE 0.0)
          (carry_coeff (decay_mult 0.02)))
      (svf_set click_bp 3000.0 0.8)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin
              (set! carry last)
              (set! phase 0.0)
              (set! amp 1.0) (set! fast 1.0) (set! slow 1.0) (set! burst 1.0)
              (set! vel (voice_vel v))))
        (if (= (% (voice_age v) 32) 0)
            (begin
              (set! amp_coeff (decay_mult (clampf (kit909_bd_decay p) 0.002 100.0)))
              (set! depth (* (kit909_bd_sweep p) (+ 0.7 (* 0.3 vel))))
              (set! pre (+ 1.6 (* 6.0 (kit909_bd_drive p))))))
        ;; the oscillator
        (set! phase (+ phase (/ (* (kit909_bd_tune p) (+ 1.0 (* depth (+ (* 5.0 fast) (* 1.5 slow))))) SRf)))
        (if (>= phase 1.0) (set! phase (- phase 1.0)))
        (set! y (* amp (sine_at phase)))
        (set! amp (* amp amp_coeff))
        (set! fast (* fast fast_coeff))
        (set! slow (* slow slow_coeff))
        ;; the click: a 0.5 ms pulse through a lowpass, and a burst of noise
        ;; around 3 kHz
        (onepole_lp pulse pulse_coeff (if (< (voice_age v) pulse_frames) 1.0 0.0))
        (set! click (+ (* 0.6 pulse) (* 0.8 burst (svf_bp click_bp (noise_white seed)))))
        (set! burst (* burst burst_coeff))
        (set! y (+ y (* (kit909_bd_attack p) vel click)))
        ;; drive flattens the wave, which carries more energy at the same
        ;; peak, so turn it down a little as the drive goes up
        (set! y (kit909_shape y pre))
        (set! y (* 0.47 (- 1.0 (* 0.35 (kit909_bd_drive p))) (kit909_bd_level p) vel y))
        (set! carry (* carry carry_coeff))
        (set! last (+ y carry))
        (frame_add_mono out last 0.5)
        (if (and (< amp 0.0005) (< burst 0.001) (< (fabs carry) 0.0001))
            (begin (set! last 0.0) (voice_done v)))
        void))))

;;;;;;;;;;;
;; snare ;;
;;;;;;;;;;;

;; Two oscillators for the drum, each with a short fall in pitch, and noise
;; for the snares. sd-tone opens the noise lowpass, sd-snappy sets its
;; level, and velocity raises both, so a harder hit is brighter as well as
;; louder.

(bind-func kit909_sd_c
  (lambda (p:SAMPLE*)
    (let ((seed:i64 4242)
          (hp (svf_make 1))
          (lp (svf_make 1))
          (phase1:SAMPLE 0.0) (phase2:SAMPLE 0.0)
          (env1:SAMPLE 0.0) (env2:SAMPLE 0.0) (env_noise:SAMPLE 0.0)
          (coeff1 (decay_mult 0.17))
          (coeff2 (decay_mult 0.11))
          (coeff_noise (decay_mult 0.32))
          (sweep:SAMPLE 0.0) (sweep_coeff (decay_mult 0.04))
          (vel:SAMPLE 0.0) (bright:SAMPLE 0.0) (last_bright:SAMPLE -1.0)
          (f:SAMPLE 0.0) (body:SAMPLE 0.0) (snares:SAMPLE 0.0)
          (last:SAMPLE 0.0) (carry:SAMPLE 0.0)
          (carry_coeff (decay_mult 0.02)))
      (svf_set hp 700.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin
              (set! carry last)
              (set! phase1 0.0) (set! phase2 0.0)
              (set! env1 1.0) (set! env2 1.0) (set! env_noise 1.0)
              (set! sweep 1.0)
              (set! vel (voice_vel v))))
        (set! bright (* (kit909_sd_tone p) (+ 0.5 (* 0.5 vel))))
        (if (<> bright last_bright)
            (begin
              (set! last_bright bright)
              (svf_set lp (+ 3500.0 (* 11000.0 bright)) 0.7)))
        ;; the drum
        (set! f (* (kit909_sd_tune p) (+ 1.0 (* 0.2 sweep))))
        (set! phase1 (+ phase1 (/ f SRf)))
        (if (>= phase1 1.0) (set! phase1 (- phase1 1.0)))
        (set! phase2 (+ phase2 (/ (* 1.7 f) SRf)))
        (if (>= phase2 1.0) (set! phase2 (- phase2 1.0)))
        (set! body (kit909_shape (+ (* env1 (sine_at phase1))
                                    (* 0.6 env2 (sine_at phase2)))
                                 1.5))
        ;; the snares
        (set! snares (svf_lp lp (svf_hp hp (noise_white seed))))
        (set! snares (* env_noise (+ 0.25 (* 1.3 (kit909_sd_snappy p) (+ 0.6 (* 0.4 vel)))) snares))
        (set! env1 (* env1 coeff1))
        (set! env2 (* env2 coeff2))
        (set! env_noise (* env_noise coeff_noise))
        (set! sweep (* sweep sweep_coeff))
        (set! carry (* carry carry_coeff))
        (set! last (+ (* 0.18 (kit909_sd_level p) vel (+ (* 0.8 body) snares)) carry))
        (frame_add_mono out last 0.5)
        (if (and (< env_noise 0.001) (< env1 0.001) (< (fabs carry) 0.0001))
            (begin (set! last 0.0) (voice_done v)))
        void))))

;;;;;;;;;;
;; clap ;;
;;;;;;;;;;

;; Noise through a bandpass a little above 1 kHz, opened four times, 9 ms
;; apart, then left to fade over cp-decay. The 909's clap is brighter and
;; has a longer tail than the 808's.

(bind-func kit909_cp_c
  (lambda (p:SAMPLE*)
    (let ((seed:i64 1234567)
          (bp (svf_make 1))
          (hp (svf_make 1))
          (env:SAMPLE 0.0)
          (burst_coeff (decay_mult 0.018))
          (tail_coeff:SAMPLE 0.999)
          (spacing:i64 (convert (/ SRf 110.0) i64))
          (age:i64 0)
          (tail:i1 #f)
          (vel:SAMPLE 0.0)
          (y:SAMPLE 0.0))
      (svf_set hp 600.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (set! age (voice_age v))
        (if (voice_start? v)
            (begin
              (set! env 1.0)
              (set! tail #f)
              (set! vel (voice_vel v))
              (svf_set bp (+ 1000.0 (* 400.0 vel)) 1.4)))
        (if (or (= age spacing) (= age (* 2 spacing)) (= age (* 3 spacing)))
            (set! env 1.0))
        (if (= age (* 4 spacing))
            (begin (set! env 0.85) (set! tail #t)))
        (if (= (% age 32) 0)
            (set! tail_coeff (decay_mult (clampf (kit909_cp_decay p) 0.002 100.0))))
        ;; the highpass comes after the envelope, to take out the thump of
        ;; each burst's sudden start
        (set! y (* env (svf_bp bp (noise_white seed))))
        (set! y (svf_hp hp y))
        (set! env (* env (if tail tail_coeff burst_coeff)))
        (frame_add_mono out (* 0.74 (kit909_cp_level p) vel y) 0.52)
        (if (and tail (< env 0.001))
            (voice_done v))
        void))))

;;;;;;;;;;;;;;
;; rim shot ;;
;;;;;;;;;;;;;;

;; Three very short resonators, clipped for bite and highpassed so that
;; there's no body to it.

(bind-func kit909_rs_c
  (lambda (p:SAMPLE*)
    (let ((hp (svf_make 1))
          (phase1:SAMPLE 0.0) (phase2:SAMPLE 0.0) (phase3:SAMPLE 0.0)
          (env:SAMPLE 0.0) (coeff (decay_mult 0.04))
          (vel:SAMPLE 0.0) (y:SAMPLE 0.0))
      (svf_set hp 500.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin
              (set! phase1 0.0) (set! phase2 0.0) (set! phase3 0.0)
              (set! env 1.0) (set! vel (voice_vel v))))
        (set! phase1 (+ phase1 (/ 480.0 SRf)))
        (if (>= phase1 1.0) (set! phase1 (- phase1 1.0)))
        (set! phase2 (+ phase2 (/ 1080.0 SRf)))
        (if (>= phase2 1.0) (set! phase2 (- phase2 1.0)))
        (set! phase3 (+ phase3 (/ 1900.0 SRf)))
        (if (>= phase3 1.0) (set! phase3 (- phase3 1.0)))
        (set! y (* env (+ (* 0.5 (sine_at phase1))
                          (sine_at phase2)
                          (* 0.6 (sine_at phase3)))))
        (set! y (svf_hp hp (tanh (* 2.5 y))))
        (set! env (* env coeff))
        (frame_add_mono out (* 0.21 (kit909_rs_level p) vel y) 0.45)
        (if (< env 0.001) (voice_done v))
        void))))

;;;;;;;;;;;;;
;; hi-hats ;;
;;;;;;;;;;;;;

;; A metal bank mixed with white noise, through a bandpass at about 10 kHz,
;; an envelope and a highpass. The noise makes these crisper and less
;; pitched than the 808's hats. Pitch 42 plays the closed hat and 46 the
;; open one; both are mapped to this one voice, so each cuts the other off.

(bind-func kit909_hh_c
  (lambda (p:SAMPLE*)
    (let ((metal (kit909_metal_make))
          (seed:i64 777)
          (bp (svf_make 1))
          (hp (svf_make 1))
          (env:SAMPLE 0.0)
          (coeff:SAMPLE 0.99)
          (open:i1 #f)
          (vel:SAMPLE 0.0)
          (level:SAMPLE 0.0)
          (y:SAMPLE 0.0))
      (svf_set hp 7500.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin
              (set! env 1.0)
              (set! open (> (voice_pitch v) 44.0))
              (set! vel (voice_vel v))
              (svf_set bp (+ 9000.0 (* 2000.0 vel)) 0.9)))
        (if (= (% (voice_age v) 32) 0)
            (begin
              (set! coeff (decay_mult (clampf (if open (kit909_oh_decay p) (kit909_hh_decay p)) 0.002 100.0)))
              (set! level (if open (kit909_oh_level p) (kit909_hh_level p)))))
        (set! y (svf_bp bp (+ (kit909_metal metal 1.0) (* 0.6 (noise_white seed)))))
        (set! y (svf_hp hp (* env y)))
        (set! env (* env coeff))
        (frame_add_mono out (* 0.28 level vel y) 0.62)
        (if (< env 0.001)
            (voice_done v))
        void))))

;;;;;;;;;;;;;
;; cymbals ;;
;;;;;;;;;;;;;

;; The crash multiplies two metal banks tuned apart (ring modulation), so
;; every partial of one meets every partial of the other and the spectrum
;; fills in. A band around 5 kHz gives the crash its body and fades in
;; about half of cr-decay; the band above 8 kHz is the shimmer and lasts
;; the full time. A few milliseconds of rise soften the hit.

(bind-func kit909_cr_c
  (lambda (p:SAMPLE*)
    (let ((metal_a (kit909_metal_make))
          (metal_b (kit909_metal_make))
          (seed:i64 5150)
          (bp_mid (svf_make 1))
          (hp_high (svf_make 1))
          (hp_low (svf_make 1))
          (rise:SAMPLE 0.0) (rise_coeff (smoothing_coeff 0.002))
          (env_mid:SAMPLE 0.0) (env_high:SAMPLE 0.0)
          (coeff_mid:SAMPLE 0.99) (coeff_high:SAMPLE 0.99)
          (vel:SAMPLE 0.0) (bright:SAMPLE 0.0)
          (x:SAMPLE 0.0) (y:SAMPLE 0.0))
      (svf_set bp_mid 5000.0 1.0)
      (svf_set hp_high 8000.0 0.7)
      (svf_set hp_low 2500.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin (set! env_mid 1.0) (set! env_high 1.0) (set! rise 0.0) (set! vel (voice_vel v))))
        (if (= (% (voice_age v) 32) 0)
            (begin
              (set! coeff_mid (decay_mult (clampf (* 0.45 (kit909_cr_decay p)) 0.002 100.0)))
              (set! coeff_high (decay_mult (clampf (kit909_cr_decay p) 0.002 100.0)))
              (set! bright (* (kit909_cr_tone p) (+ 0.6 (* 0.4 vel))))))
        (set! x (+ (* 4.0 (kit909_metal metal_a 1.0) (kit909_metal metal_b 1.37)) (* 0.4 (noise_white seed))))
        (set! y (+ (* env_mid (- 1.0 (* 0.5 bright)) (svf_bp bp_mid x))
                   (* env_high (+ 0.4 bright) (svf_hp hp_high x))))
        (set! y (* rise (svf_hp hp_low y)))
        (onepole_lp rise rise_coeff 1.0)
        (set! env_mid (* env_mid coeff_mid))
        (set! env_high (* env_high coeff_high))
        (frame_add_mono out (* 0.29 (kit909_cr_level p) vel y) 0.38)
        (if (< env_high 0.001)
            (voice_done v))
        void))))

;; The ride is a ping over a wash. Two narrow bandpasses (3.2 and 5.3 kHz)
;; pick single clusters of partials out of a ring-modulated metal source, and
;; ring like a struck bell; they fade in about a third of rd-decay. The wash
;; is the same source above 7 kHz, quieter, lasting the full rd-decay.

(bind-func kit909_rd_c
  (lambda (p:SAMPLE*)
    (let ((metal_a (kit909_metal_make))
          (metal_b (kit909_metal_make))
          (ping1 (svf_make 1))
          (ping2 (svf_make 1))
          (wash (svf_make 1))
          (env_ping:SAMPLE 0.0) (env_wash:SAMPLE 0.0)
          (coeff_ping:SAMPLE 0.99) (coeff_wash:SAMPLE 0.99)
          (vel:SAMPLE 0.0)
          (x:SAMPLE 0.0) (y:SAMPLE 0.0))
      (svf_set ping1 3200.0 8.0)
      (svf_set ping2 5300.0 8.0)
      (svf_set wash 7000.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin (set! env_ping 1.0) (set! env_wash 1.0) (set! vel (voice_vel v))))
        (if (= (% (voice_age v) 32) 0)
            (begin
              (set! coeff_ping (decay_mult (clampf (* 0.35 (kit909_rd_decay p)) 0.002 100.0)))
              (set! coeff_wash (decay_mult (clampf (kit909_rd_decay p) 0.002 100.0)))))
        (set! x (* 4.0 (kit909_metal metal_a 1.19) (kit909_metal metal_b 1.61)))
        (set! y (+ (* env_ping (+ (svf_bp ping1 x) (* 0.8 (svf_bp ping2 x))))
                   (* env_wash (+ 0.25 (* 0.2 vel)) (svf_hp wash x))))
        (set! env_ping (* env_ping coeff_ping))
        (set! env_wash (* env_wash coeff_wash))
        (frame_add_mono out (* 0.25 (kit909_rd_level p) vel y) 0.64)
        (if (< env_wash 0.001)
            (voice_done v))
        void))))

;;;;;;;;;;
;; toms ;;
;;;;;;;;;;

;; Each tom is an oscillator whose pitch starts about a fifth sharp and
;; slides down to the note, with a puff of noise for the stick. `which` says
;; which tom this voice plays: 0 low, 1 mid, 2 high.

(bind-func static kit909_tom_tune
  (lambda (p:SAMPLE* which:i64)
    (cond ((= which 0) (kit909_lt_tune p))
          ((= which 1) (kit909_mt_tune p))
          (else (kit909_ht_tune p)))))

(bind-func static kit909_tom_level
  (lambda (p:SAMPLE* which:i64)
    (cond ((= which 0) (kit909_lt_level p))
          ((= which 1) (kit909_mt_level p))
          (else (kit909_ht_level p)))))

(bind-func kit909_tom_c
  (lambda (p:SAMPLE* which:i64 pan:SAMPLE)
    (let ((seed:i64 (+ 99 which))
          (lp (svf_make 1))
          (phase:SAMPLE 0.0)
          (amp:SAMPLE 0.0) (amp_coeff:SAMPLE 0.999)
          (sweep:SAMPLE 0.0) (sweep_coeff (decay_mult 0.3))
          (env_noise:SAMPLE 0.0) (noise_coeff (decay_mult 0.08))
          (vel:SAMPLE 0.0) (y:SAMPLE 0.0)
          (last:SAMPLE 0.0) (carry:SAMPLE 0.0)
          (carry_coeff (decay_mult 0.02)))
      (svf_set lp 2500.0 0.7)
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin
              (set! carry last)
              (set! phase 0.0) (set! amp 1.0) (set! sweep 1.0) (set! env_noise 1.0)
              (set! vel (voice_vel v))))
        (if (= (% (voice_age v) 32) 0)
            (set! amp_coeff (decay_mult (clampf (kit909_tom_decay p) 0.002 100.0))))
        (set! phase (+ phase (/ (* (kit909_tom_tune p which) (+ 1.0 (* 0.5 sweep))) SRf)))
        (if (>= phase 1.0) (set! phase (- phase 1.0)))
        (set! y (+ (* amp (kit909_shape (sine_at phase) 1.5))
                   (* env_noise 0.3 vel (svf_lp lp (noise_white seed)))))
        (set! amp (* amp amp_coeff))
        (set! sweep (* sweep sweep_coeff))
        (set! env_noise (* env_noise noise_coeff))
        (set! carry (* carry carry_coeff))
        (set! last (+ (* 0.27 (kit909_tom_level p which) vel y) carry))
        (frame_add_mono out last pan)
        (if (and (< amp 0.001) (< (fabs carry) 0.0001))
            (begin (set! last 0.0) (voice_done v)))
        void))))

;;;;;;;;;;;;;;;;;;;;
;; making the kit ;;
;;;;;;;;;;;;;;;;;;;;

;; voice numbers: 0 kick, 1 rim shot, 2 snare, 3 clap, 4 hi-hats (closed and
;; open), 5-7 toms, 8 crash, 9 ride
(bind-func kit909_make
  (lambda ()
    (let ((inst (inst_make "kit909" 10 (kit909_nparams)))
          (p (inst_params inst)))
      (kit909_defaults p)
      (inst_set_mode inst INST_KEYED)
      (inst_set_voice inst 0 (kit909_bd_c p))
      (inst_set_voice inst 1 (kit909_rs_c p))
      (inst_set_voice inst 2 (kit909_sd_c p))
      (inst_set_voice inst 3 (kit909_cp_c p))
      (inst_set_voice inst 4 (kit909_hh_c p))
      (inst_set_voice inst 5 (kit909_tom_c p 0 0.4))
      (inst_set_voice inst 6 (kit909_tom_c p 1 0.5))
      (inst_set_voice inst 7 (kit909_tom_c p 2 0.6))
      (inst_set_voice inst 8 (kit909_cr_c p))
      (inst_set_voice inst 9 (kit909_rd_c p))
      (inst_map_key inst 36 0)
      (inst_map_key inst 37 1)
      (inst_map_key inst 38 2)
      (inst_map_key inst 39 3)
      (inst_map_key inst 42 4)
      (inst_map_key inst 46 4)
      (inst_map_key inst 45 5)
      (inst_map_key inst 47 6)
      (inst_map_key inst 50 7)
      (inst_map_key inst 49 8)
      (inst_map_key inst 51 9)
      inst)))
