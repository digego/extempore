;;; acid.xtm -- a monophonic acid bassline synth

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; A bass synth in the style of the Roland TB-303: one oscillator (saw or
;; square) into a resonant diode-ladder lowpass filter (modelled below) which
;; is swept by a decaying envelope.
;;
;; Two things give it the acid sound. A loud note (velocity above 0.8) is an
;; *accent*: it's louder, and it opens the filter further and faster. And a
;; note which starts before the last one has finished *slides*: the pitch
;; glides to the new note (exponentially in semitones), and the envelopes
;; carry on without restarting.
;;
;; This is an original implementation, built from published descriptions of
;; how the 303 behaves.

;;; Code:

(sys:load-preload-check 'studio-acid)
(define *xtmlib-studio-acid-loaded* #t)

(sys:load "libs/studio/api.xtm")

(def-instrument acid
                "a squelchy monophonic bassline synth in the style of the TB-303"
                (params
                 (wave 0.0 "oscillator shape: 0.0 is a saw, 1.0 is a square")
                 (tune 0.0 "transpose, in semitones")
                 (cutoff 400.0 "frequency of the filter's resonant peak in Hz when the resonance is high")
                 (res 0.72 "filter resonance, 0.0 to 1.0")
                 (envmod 0.55 "how far the envelope opens the filter, 0.0 to 1.0")
                 (decay 0.35 "how long the filter envelope takes to close, in seconds")
                 (accent 0.6 "how much harder accented notes (velocity above 0.8) hit, 0.0 to 1.0")
                 (slide 0.06 "how long the pitch takes to glide to a legato note, in seconds")
                 (drive 0.15 "output overdrive, 0.0 to 1.0")
                 (level 0.8 "output level"))
                (presets
                 (classic)
                 (squelchy (cutoff 260.0) (res 0.88) (envmod 0.75) (decay 0.25) (accent 0.8))
                 (rubber (wave 1.0) (cutoff 215.0) (res 0.6) (envmod 0.4) (decay 0.5) (drive 0.0))
                 (screamer (cutoff 420.0) (res 0.93) (envmod 0.9) (decay 0.6) (accent 1.0) (drive 0.7) (level 0.45))
                 (deep (wave 1.0) (cutoff 150.0) (res 0.3) (envmod 0.25) (decay 0.8) (accent 0.3) (drive 0.3) (level 0.45))))

;;;;;;;;;;;;;
;; filter  ;;
;;;;;;;;;;;;;

;; The 303's filter is a diode ladder: four one-pole sections like a Moog's,
;; but each is coupled to its neighbours, so a section is loaded by the next
;; and the response above the cutoff falls more gently than 24 dB/octave
;; before it settles there. In normalised form (Zavalishin, "The Art of VA
;; Filter Design", the diode ladder), with the input x and the four outputs
;; y1 to y4:
;;
;;   y1' = (x - y1) + (y2 - y1)    y3' = (y2 - y3) + (y4 - y3)
;;   y2' = (y1 - y2) + (y3 - y2)   y4' = y3 - y4
;;
;; and the resonance feeds y4 back to the input: x becomes input - k y4.
;; The ladder rings freely when k reaches 18.3878 (at 1.1952 radians per unit
;; time), so the voice sets k as a fraction of that.
;;
;; Each frame is solved with the trapezoidal rule, with the feedback loop
;; closed within the frame, so the filter keeps its tuning as the resonance
;; rises and can be swept at any rate. With T = I - g A (A the matrix of the
;; equations above, g = tan(pi f / SR) / 1.1952) the new outputs are
;;
;;   y+ = T^-1 ((I + g A) y + g b u) + d u+
;;
;; where u is the ladder's input on the last frame, u+ its input on this one,
;; and d = g T^-1 b is how far a unit of input moves each output at once. T is
;; tridiagonal: its factors are worked out when the cutoff changes (in
;; acid_diode_set), and a frame costs one forward and one back substitution.
;; The loop then fixes u+ directly, since y4+ = p4 + d4 u+.
;;
;; As in other models of the 303, a highpass (about 150 Hz) sits in the
;; feedback path, so the resonance is not fed back at the lowest frequencies.
;; It also shifts the frequency at which the ladder rings, and the feedback it
;; needs to ring, by amounts which depend on how close the cutoff is to 150
;; Hz: acid_diode_set corrects both with fits to the exact loop, so that the
;; resonant peak sits at the cutoff and the top of the resonance knob is the
;; edge of self-oscillation.
;;
;; The ladder's input is saturated (tanh_fast) after the loop is solved, so a
;; loud or resonant signal is squashed as it enters, which keeps the ringing
;; at the top of the resonance knob bounded.
;;
;; The filter's numbers are at a SAMPLE*: 0 g, 1 to 4 the d, 5 to 7 the
;; elimination multipliers of T, 8 to 11 the reciprocals of its pivots,
;; 12 one less the highpass's G, 13 the highpass's G, 14 the feedback gain, 15
;; the loop's divisor. Its state is six numbers at another: y1 to y4, the last
;; u and the highpass's state.

(bind-func static acid_diode_set
  "set the filter c for a resonant peak at freq Hz and a resonance of res (0.0 to 1.0)"
  (lambda (c:SAMPLE* freq:SAMPLE res:SAMPLE)
    (let ((r:SAMPLE 0.0) (sh:SAMPLE 1.0)
          (f:SAMPLE 0.0) (g:SAMPLE 0.0) (dd:SAMPLE 0.0) (gh:SAMPLE 0.0)
          (k:SAMPLE 0.0) (m1:SAMPLE 0.0) (m2:SAMPLE 0.0) (m3:SAMPLE 0.0) (m4:SAMPLE 0.0)
          (l2:SAMPLE 0.0) (l3:SAMPLE 0.0) (l4:SAMPLE 0.0) (kk:SAMPLE 0.0)
          (i:i64 0))
      ;; The highpass moves the ringing up by a factor sh and raises the
      ;; feedback it needs, both as functions of the highpass's corner over
      ;; the ladder's own frequency (cubic fits to the exact loop). The
      ;; ladder's frequency is the cutoff over sh, so three rounds settle it.
      (set! f freq)
      (dotimes (i 3)
        (set! r (clampf (/ 150.0 f) 0.0 1.6))
        (set! sh (+ 1.0 (* r (+ 0.737 (* r (- (* 0.0496 r) 0.2539))))))
        (set! f (/ freq sh)))
      (set! r (clampf (/ 150.0 f) 0.0 1.6))
      (set! k (* res 18.387755 (+ 1.0 (* r (+ 1.4697 (* r (- 0.5319 (* 0.045 r))))))))
      (set! f (clampf f 20.0 (* 0.45 SRf)))
      (set! g (/ (tan (* SPI (/ f SRf))) 1.1952286))
      (set! dd (* (+ g 1.0) (+ 1.0 (* g (+ 6.0 (* g (+ 9.0 g)))))))
      (pset! c 0 g)
      (pset! c 1 (/ (* g (+ 1.0 (* g (+ 5.0 (* g (+ 6.0 g)))))) dd))
      (pset! c 2 (/ (* g g (+ 1.0 (* g (+ 3.0 g)))) dd))
      (pset! c 3 (/ (* g g g (+ g 1.0)) dd))
      (pset! c 4 (/ (* g g g g) dd))
      (set! m1 (+ 1.0 (* 2.0 g)))
      (set! l2 (/ (- 0.0 g) m1))
      (set! m2 (+ (+ 1.0 (* 2.0 g)) (* g l2)))
      (set! l3 (/ (- 0.0 g) m2))
      (set! m3 (+ (+ 1.0 (* 2.0 g)) (* g l3)))
      (set! l4 (/ (- 0.0 g) m3))
      (set! m4 (+ (+ 1.0 g) (* g l4)))
      (pset! c 5 l2) (pset! c 6 l3) (pset! c 7 l4)
      (pset! c 8 (/ 1.0 m1)) (pset! c 9 (/ 1.0 m2)) (pset! c 10 (/ 1.0 m3)) (pset! c 11 (/ 1.0 m4))
      (set! gh (tan (* SPI (/ 150.0 SRf))))
      (pset! c 13 (/ gh (+ 1.0 gh)))
      (pset! c 12 (- 1.0 (pref c 13)))
      (set! kk (* k (pref c 12)))
      (pset! c 14 kk)
      (pset! c 15 (/ 1.0 (+ 1.0 (* kk (pref c 4)))))
      void)))

(bind-func static acid_diode_tick
  "one frame of the filter: the input x in, the lowpass out"
  (lambda (s:SAMPLE* c:SAMPLE* x:SAMPLE)
    (let ((g:SAMPLE (pref c 0))
          (y1:SAMPLE (pref s 0)) (y2:SAMPLE (pref s 1)) (y3:SAMPLE (pref s 2)) (y4:SAMPLE (pref s 3))
          (up:SAMPLE (pref s 4)) (sh:SAMPLE (pref s 5))
          (a:SAMPLE 0.0)
          (z1:SAMPLE 0.0) (z2:SAMPLE 0.0) (z3:SAMPLE 0.0) (z4:SAMPLE 0.0)
          (p1:SAMPLE 0.0) (p2:SAMPLE 0.0) (p3:SAMPLE 0.0) (p4:SAMPLE 0.0)
          (u:SAMPLE 0.0) (v:SAMPLE 0.0))
      (set! a (- 1.0 (* 2.0 g)))
      ;; the right-hand side, then forward elimination
      (set! z1 (+ (* a y1) (* g (+ y2 up))))
      (set! z2 (- (+ (* a y2) (* g (+ y1 y3))) (* (pref c 5) z1)))
      (set! z3 (- (+ (* a y3) (* g (+ y2 y4))) (* (pref c 6) z2)))
      (set! z4 (- (+ (* g y3) (* (- 1.0 g) y4)) (* (pref c 7) z3)))
      ;; back substitution: what the outputs would be with no new input
      (set! p4 (* z4 (pref c 11)))
      (set! p3 (* (+ z3 (* g p4)) (pref c 10)))
      (set! p2 (* (+ z2 (* g p3)) (pref c 9)))
      (set! p1 (* (+ z1 (* g p2)) (pref c 8)))
      (set! u (tanh_fast (* (- x (* (pref c 14) (- p4 sh))) (pref c 15))))
      (set! y1 (+ p1 (* (pref c 1) u)))
      (set! y2 (+ p2 (* (pref c 2) u)))
      (set! y3 (+ p3 (* (pref c 3) u)))
      (set! y4 (+ p4 (* (pref c 4) u)))
      (set! v (* (pref c 13) (- y4 sh)))
      (pset! s 0 y1) (pset! s 1 y2) (pset! s 2 y3) (pset! s 3 y4)
      (pset! s 4 u) (pset! s 5 (+ sh (* 2.0 v)))
      y4)))

(bind-func acid_voice_c
  (lambda (p:SAMPLE*)
    (let ((fc:SAMPLE* (zalloc 16))
          (fs:SAMPLE* (zalloc 6))
          (phase:SAMPLE 0.0)
          (pitch:SAMPLE 36.0)
          (freq:SAMPLE 110.0)
          (inc:SAMPLE 0.0)
          (saw:SAMPLE 0.0)
          (square:SAMPLE 0.0)
          (filter_env:SAMPLE 0.0)
          (accent_env:SAMPLE 0.0)
          (amp_env:SAMPLE 0.0)
          (accented:SAMPLE 0.0)
          (cutoff:SAMPLE 0.0)
          (res:SAMPLE 0.0)
          (x:SAMPLE 0.0)
          (pre:SAMPLE 0.0)
          (os (os_make))
          (dcin:SAMPLE 0.0)
          (dcout:SAMPLE 0.0)
          (dc_k:SAMPLE (dc_coeff 20.0))
          (i:i64 0)
          ;; these depend on parameters, and are worked out every 32 frames
          (tune_semi:SAMPLE 0.0)
          (glide:SAMPLE 1.0)
          (filter_decay:SAMPLE 0.999)
          (amp_attack (smoothing_coeff 0.002))
          (amp_release (smoothing_coeff 0.008))
          (accent_smooth (smoothing_coeff 0.03)))
      (dotimes (i 16) (pset! fc i 0.0))
      (dotimes (i 6) (pset! fs i 0.0))
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (begin
              ;; a new note (not a slide): jump to the pitch, restart the envelope
              (set! tune_semi (acid_tune p))
              (set! pitch (+ (voice_pitch v) tune_semi))
              (set! filter_env 1.0)
              (set! accented (if (> (voice_vel v) 0.8) 1.0 0.0))))
        (if (= (% (voice_age v) 32) 0)
            (begin
              (set! tune_semi (acid_tune p))
              (set! glide (smoothing_coeff (* 0.3 (acid_slide p))))
              ;; accented notes always have a short, snappy filter decay
              (set! x (if (> accented 0.5) 0.2 (acid_decay p)))
              (set! filter_decay (exp (/ -1.0 (* (clamp x 0.01 10.0) SRf))))))
        ;; the pitch glides in semitones, which is how the 303's slide behaves
        ;; (its capacitor charges the pitch control voltage)
        (set! pitch (+ pitch (* glide (- (+ (voice_pitch v) tune_semi) pitch))))
        ;; envelopes. The accent envelope is a smoothed copy of the filter
        ;; envelope, so quick runs of accents pile up and push the filter
        ;; further open each time.
        (set! filter_env (* filter_env filter_decay))
        (set! accent_env (+ accent_env (* accent_smooth (- (* accented filter_env) accent_env))))
        (set! amp_env (+ amp_env (* (if (> (voice_gate v) 0.5) amp_attack amp_release)
                                    (- (voice_gate v) amp_env))))
        ;; every 8 frames: what needs an exp, a pow or a tan. The envelopes move
        ;; the cutoff by up to four octaves, plus two more for accents.
        (if (= (% (voice_age v) 8) 0)
            (begin
              (set! freq (* 440.0 (exp (* 0.057762265 (- pitch 69.0)))))
              (set! inc (/ freq SRf))
              (set! cutoff (* (acid_cutoff p)
                              (pow 2.0 (+ (* 4.0 (acid_envmod p) filter_env)
                                          (* 2.0 (acid_accent p) accent_env)))))
              (set! res (clampf (acid_res p) 0.0 1.0))
              (acid_diode_set fc cutoff res)
              void))
        ;; oscillator: a saw and a square, band-limited (blep_saw, blep_pulse)
        ;; so that they don't alias
        (set! phase (+ phase inc))
        (if (>= phase 1.0) (set! phase (- phase 1.0)))
        (set! saw (blep_saw phase inc))
        (set! square (blep_pulse phase inc 0.5))
        (set! x (+ saw (* (acid_wave p) (- square saw))))
        (set! x (* 5.5 (acid_diode_tick fs fc (* 0.5 x))))
        ;; amplifier: accents are louder
        (set! x (* x amp_env (+ 0.7 (* 0.6 (acid_accent p) accented))))
        (set! pre (+ 1.0 (* 6.0 (acid_drive p))))
        (set! x (oversat4 os x pre))
        (set! x (dc_block dcin dcout dc_k x))
        (frame_add out (* (acid_level p) x))
        ;; the note is over once it has been released and has faded away
        (if (and (< (voice_gate v) 0.5) (< amp_env 0.0005))
            (voice_done v))
        void))))

(bind-func acid_make
  (lambda ()
    (let ((inst (inst_make "acid" 1 (acid_nparams))))
      (acid_defaults (inst_params inst))
      (inst_set_voice inst 0 (acid_voice_c (inst_voice_params inst 0)))
      (inst_set_mode inst INST_MONO)
      inst)))
