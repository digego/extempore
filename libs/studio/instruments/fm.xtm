;;; fm.xtm -- a six-operator FM synth in the style of the Yamaha DX7

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; Frequency modulation, as John Chowning described it in 1973, makes a rich
;; spectrum from two sine waves: a *modulator* swings the phase of a *carrier*
;; back and forth, and the carrier's spectrum grows sidebands at the carrier
;; frequency plus and minus every multiple of the modulator frequency. How
;; far the phase swings (the *modulation index*, in radians) sets how many of
;; those sidebands are strong, so a modulator's level works like a filter
;; cutoff: low is a pure sine, high is bright and buzzy. What the DX7 called FM
;; is strictly phase modulation, and that's what this does too.
;;
;; The ratio of the two frequencies sets which partials appear. A whole-number
;; ratio (1:1, 1:2, 1:3) gives a harmonic spectrum, like a string or a reed;
;; anything else (1:1.4, 1:3.5) gives an inharmonic one, like a bell.
;;
;; The DX7 has six sine *operators* per voice. Each has its own frequency (a
;; ratio of the note's, or a fixed frequency), its own output level and its
;; own envelope. An *algorithm* says which operators modulate which, and
;; which ones you hear (the carriers). There are 32 algorithms, from one tall
;; stack of six to six separate sine waves, and one operator in each feeds its
;; own output back into its phase (the `feedback` parameter), which turns a
;; sine into something close to a sawtooth.
;;
;; Most of the character of a DX7 sound is in the envelopes. Give a modulator
;; a fast decay and the note starts bright and mellows, the way a struck or
;; plucked note does; give it a slow attack and the note brightens as it
;; swells, the way a brass note does. Each operator's envelope here is an
;; attack, a decay to a sustain level and a release. The decay and release
;; are exponential (straight lines in decibels, as on the DX7), and their
;; times are the time to fall by 60 dB.
;;
;; Two more DX7 features keep a patch playable across the keyboard. Keyboard
;; rate scaling makes the envelopes of higher notes run faster, as a real
;; piano's do. Keyboard level scaling turns an operator down for notes above
;; middle C; on a modulator, that stops high notes getting harsh, and keeps
;; their sidebands below the Nyquist frequency where they would alias.
;; Operators whose frequency approaches the Nyquist frequency fade out for the
;; same reason, and a modulator's index is turned down as the note climbs until
;; the spectrum it makes fits under half the sample rate, so that a patch
;; without any keyboard scaling stays clean too (it just gets duller). Levels,
;; frequencies, feedback and brightness glide to their new values over a few
;; milliseconds, so that moving them during a note doesn't make zipper noise.
;;
;; This is a clean-room implementation, built from the published DX7
;; documentation (the algorithm chart and the description of the operators
;; and envelopes) and the FM synthesis literature. The presets are new
;; patches, made in the spirit of the DX7's famous ones.

;;; Code:

(sys:load-preload-check 'studio-fm)
(define *xtmlib-studio-fm-loaded* #t)

(sys:load "libs/studio/api.xtm")
(sys:load "libs/studio/dsp.xtm")

(def-instrument fm
  "a six-operator FM synth in the style of the Yamaha DX7"
  (params
    (algorithm 5.0 "which of the 32 DX7 algorithms connects the operators, 1 to 32")
    (feedback 0.2 "how much of its own output the feedback operator feeds back, 0.0 to 1.0")
    (bright 1.0 "scales every modulator's level, 0.0 (only the carriers' sines) to 2.0")
    (transpose 0.0 "transpose, in semitones")
    (key-rate 0.4 "how much faster envelopes run for higher notes, 0.0 to 1.0 (1.0: twice as fast per octave)")
    (lfo-rate 5.5 "LFO rate in Hz")
    (lfo-delay 0.6 "seconds for the LFO to fade in after a note starts")
    (lfo-pitch 0.0 "vibrato depth in semitones, 0.0 to 1.0")
    (lfo-amp 0.0 "tremolo depth, 0.0 to 1.0")
    (chorus 0.35 "stereo chorus on the output, 0.0 (none) to 1.0")
    (level 0.38 "output level")
    ;; every operator has the same ten parameters, in the same order
    (op1-ratio 1.0 "operator 1's frequency as a multiple of the note's, 0.5 to 32")
    (op1-fixed 0.0 "if above 0, operator 1 ignores the note and plays this frequency in Hz")
    (op1-detune -3.0 "operator 1's detune in cents")
    (op1-level 0.9 "operator 1's output level, 0.0 to 1.0. As a modulator, 1.0 is an index of 4π")
    (op1-attack 0.001 "operator 1's attack time in seconds")
    (op1-decay 7.0 "seconds for operator 1 to decay 60 dB (towards its sustain level)")
    (op1-sustain 0.0 "operator 1's sustain level, 0.0 to 1.0")
    (op1-release 0.6 "seconds for operator 1 to fade 60 dB once the note is released")
    (op1-velocity 0.6 "how much velocity changes operator 1's level, 0.0 to 1.0")
    (op1-keyscale 0.0 "how much operator 1 turns down above middle C, 0.0 to 1.0 (1.0: -12 dB per octave)")
    (op2-ratio 1.0 "operator 2's frequency as a multiple of the note's, 0.5 to 32")
    (op2-fixed 0.0 "if above 0, operator 2 ignores the note and plays this frequency in Hz")
    (op2-detune 0.0 "operator 2's detune in cents")
    (op2-level 0.16 "operator 2's output level, 0.0 to 1.0. As a modulator, 1.0 is an index of 4π")
    (op2-attack 0.001 "operator 2's attack time in seconds")
    (op2-decay 1.6 "seconds for operator 2 to decay 60 dB (towards its sustain level)")
    (op2-sustain 0.15 "operator 2's sustain level, 0.0 to 1.0")
    (op2-release 0.6 "seconds for operator 2 to fade 60 dB once the note is released")
    (op2-velocity 0.8 "how much velocity changes operator 2's level, 0.0 to 1.0")
    (op2-keyscale 0.25 "how much operator 2 turns down above middle C, 0.0 to 1.0 (1.0: -12 dB per octave)")
    (op3-ratio 1.0 "operator 3's frequency as a multiple of the note's, 0.5 to 32")
    (op3-fixed 0.0 "if above 0, operator 3 ignores the note and plays this frequency in Hz")
    (op3-detune 0.0 "operator 3's detune in cents")
    (op3-level 0.4 "operator 3's output level, 0.0 to 1.0. As a modulator, 1.0 is an index of 4π")
    (op3-attack 0.001 "operator 3's attack time in seconds")
    (op3-decay 2.0 "seconds for operator 3 to decay 60 dB (towards its sustain level)")
    (op3-sustain 0.0 "operator 3's sustain level, 0.0 to 1.0")
    (op3-release 0.4 "seconds for operator 3 to fade 60 dB once the note is released")
    (op3-velocity 0.8 "how much velocity changes operator 3's level, 0.0 to 1.0")
    (op3-keyscale 0.0 "how much operator 3 turns down above middle C, 0.0 to 1.0 (1.0: -12 dB per octave)")
    (op4-ratio 14.0 "operator 4's frequency as a multiple of the note's, 0.5 to 32")
    (op4-fixed 0.0 "if above 0, operator 4 ignores the note and plays this frequency in Hz")
    (op4-detune 0.0 "operator 4's detune in cents")
    (op4-level 0.1 "operator 4's output level, 0.0 to 1.0. As a modulator, 1.0 is an index of 4π")
    (op4-attack 0.001 "operator 4's attack time in seconds")
    (op4-decay 0.3 "seconds for operator 4 to decay 60 dB (towards its sustain level)")
    (op4-sustain 0.0 "operator 4's sustain level, 0.0 to 1.0")
    (op4-release 0.3 "seconds for operator 4 to fade 60 dB once the note is released")
    (op4-velocity 0.9 "how much velocity changes operator 4's level, 0.0 to 1.0")
    (op4-keyscale 0.6 "how much operator 4 turns down above middle C, 0.0 to 1.0 (1.0: -12 dB per octave)")
    (op5-ratio 1.0 "operator 5's frequency as a multiple of the note's, 0.5 to 32")
    (op5-fixed 0.0 "if above 0, operator 5 ignores the note and plays this frequency in Hz")
    (op5-detune 4.0 "operator 5's detune in cents")
    (op5-level 0.5 "operator 5's output level, 0.0 to 1.0. As a modulator, 1.0 is an index of 4π")
    (op5-attack 0.001 "operator 5's attack time in seconds")
    (op5-decay 5.0 "seconds for operator 5 to decay 60 dB (towards its sustain level)")
    (op5-sustain 0.0 "operator 5's sustain level, 0.0 to 1.0")
    (op5-release 0.6 "seconds for operator 5 to fade 60 dB once the note is released")
    (op5-velocity 0.6 "how much velocity changes operator 5's level, 0.0 to 1.0")
    (op5-keyscale 0.0 "how much operator 5 turns down above middle C, 0.0 to 1.0 (1.0: -12 dB per octave)")
    (op6-ratio 1.0 "operator 6's frequency as a multiple of the note's, 0.5 to 32")
    (op6-fixed 0.0 "if above 0, operator 6 ignores the note and plays this frequency in Hz")
    (op6-detune 0.0 "operator 6's detune in cents")
    (op6-level 0.07 "operator 6's output level, 0.0 to 1.0. As a modulator, 1.0 is an index of 4π")
    (op6-attack 0.001 "operator 6's attack time in seconds")
    (op6-decay 2.0 "seconds for operator 6 to decay 60 dB (towards its sustain level)")
    (op6-sustain 0.1 "operator 6's sustain level, 0.0 to 1.0")
    (op6-release 0.6 "seconds for operator 6 to fade 60 dB once the note is released")
    (op6-velocity 0.7 "how much velocity changes operator 6's level, 0.0 to 1.0")
    (op6-keyscale 0.4 "how much operator 6 turns down above middle C, 0.0 to 1.0 (1.0: -12 dB per octave)"))
  (presets
    ;; the default patch: a 1:1 body with a fast-decaying modulator, a 1:14
    ;; tine which rings for a moment at the attack, and a second, detuned body
    (epiano)
    ;; a plucked and slapped bass: a 1:1 pair whose modulator (with feedback)
    ;; decays fast, and a 1:3 pair for the snap of the string
    (bass (algorithm 2) (feedback 0.35) (key-rate 0.2) (chorus 0.0) (level 0.4)
          (op1-detune 0.0) (op1-level 0.9) (op1-decay 2.5) (op1-sustain 0.4) (op1-release 0.12) (op1-velocity 0.4)
          (op2-level 0.28) (op2-decay 0.35) (op2-sustain 0.1) (op2-release 0.12) (op2-velocity 0.7) (op2-keyscale 0.0)
          (op3-level 0.5) (op3-decay 0.6) (op3-release 0.1) (op3-velocity 0.6)
          (op4-ratio 3.0) (op4-level 0.2) (op4-decay 0.12) (op4-keyscale 0.0)
          (op5-level 0.0) (op6-level 0.0))
    ;; tubular bells, after Chowning's FM bell: a carrier and an inharmonic
    ;; 1:3.5 modulator decaying together, so the tone gets purer as it fades. A
    ;; second, detuned pair beats against the first.
    (bells (feedback 0.0) (key-rate 0.3) (chorus 0.15) (level 0.38)
           (op1-detune 0.0) (op1-level 0.8) (op1-decay 9.0) (op1-release 3.0) (op1-velocity 0.5)
           (op2-ratio 3.5) (op2-level 0.25) (op2-decay 5.0) (op2-sustain 0.0) (op2-release 3.0) (op2-velocity 0.6) (op2-keyscale 0.5)
           (op3-detune 7.0) (op3-level 0.5) (op3-decay 7.0) (op3-release 3.0) (op3-velocity 0.5)
           (op4-ratio 3.5) (op4-detune -5.0) (op4-level 0.15) (op4-decay 4.0) (op4-release 3.0) (op4-velocity 0.6) (op4-keyscale 0.5)
           (op5-ratio 2.0) (op5-detune 0.0) (op5-level 0.25) (op5-decay 4.0) (op5-release 2.0) (op5-velocity 0.5)
           (op6-ratio 7.0) (op6-level 0.06) (op6-decay 0.6) (op6-sustain 0.0) (op6-keyscale 0.6))
    ;; a marimba: the bar's fundamental, its overtone two octaves up, and a
    ;; quick knock from the mallet
    (marimba (feedback 0.0) (key-rate 0.5) (chorus 0.0) (level 0.5)
             (op1-detune 0.0) (op1-level 0.9) (op1-decay 2.5) (op1-release 0.6) (op1-velocity 0.5)
             (op2-level 0.04) (op2-decay 0.25) (op2-sustain 0.0) (op2-keyscale 0.0)
             (op3-ratio 4.0) (op3-level 0.3) (op3-decay 0.35) (op3-release 0.3) (op3-velocity 0.7)
             (op4-ratio 7.0) (op4-level 0.15) (op4-decay 0.04) (op4-keyscale 0.3)
             (op5-ratio 10.0) (op5-detune 0.0) (op5-level 0.2) (op5-decay 0.08) (op5-release 0.08) (op5-velocity 0.8)
             (op6-level 0.0))
    ;; brass: three detuned 1:1 pairs (the last with feedback, for a
    ;; sawtooth edge) whose modulators swell a little after the carriers, so
    ;; each note brightens as it speaks; and a delayed vibrato
    (brass (feedback 0.8) (key-rate 0.2) (lfo-pitch 0.12) (lfo-delay 0.5) (chorus 0.2) (level 0.42)
           (op1-detune -3.0) (op1-level 0.7) (op1-attack 0.06) (op1-decay 3.0) (op1-sustain 0.8) (op1-release 0.25) (op1-velocity 0.4)
           (op2-detune -3.0) (op2-level 0.24) (op2-attack 0.08) (op2-decay 0.4) (op2-sustain 0.55) (op2-release 0.2) (op2-velocity 0.7)
           (op3-detune 4.0) (op3-level 0.5) (op3-attack 0.06) (op3-decay 3.0) (op3-sustain 0.8) (op3-release 0.25) (op3-velocity 0.4)
           (op4-ratio 1.0) (op4-detune 4.0) (op4-level 0.22) (op4-attack 0.08) (op4-decay 0.4) (op4-sustain 0.55) (op4-release 0.2) (op4-velocity 0.7) (op4-keyscale 0.25)
           (op5-detune 0.0) (op5-level 0.4) (op5-attack 0.06) (op5-decay 3.0) (op5-sustain 0.8) (op5-release 0.25) (op5-velocity 0.4)
           (op6-level 0.14) (op6-attack 0.12) (op6-decay 0.6) (op6-sustain 0.55) (op6-release 0.2))
    ;; a drawbar organ: six sines at 16', 8', 5 1/3', 4', 2 2/3' and 2', with
    ;; a little feedback on the top one for grit, and a slow tremolo
    (organ (algorithm 32) (feedback 0.3) (key-rate 0.0) (lfo-rate 6.5) (lfo-delay 0.0) (lfo-amp 0.15) (chorus 0.5) (level 0.3)
           (op1-ratio 0.5) (op1-detune 0.0) (op1-level 0.8) (op1-attack 0.005) (op1-sustain 1.0) (op1-release 0.05) (op1-velocity 0.0)
           (op2-ratio 1.0) (op2-level 0.9) (op2-attack 0.005) (op2-sustain 1.0) (op2-release 0.05) (op2-velocity 0.0) (op2-keyscale 0.0)
           (op3-ratio 1.5) (op3-level 0.5) (op3-attack 0.005) (op3-sustain 1.0) (op3-release 0.05) (op3-velocity 0.0)
           (op4-ratio 2.0) (op4-level 0.6) (op4-attack 0.005) (op4-sustain 1.0) (op4-release 0.05) (op4-velocity 0.0) (op4-keyscale 0.0)
           (op5-ratio 3.0) (op5-detune 0.0) (op5-level 0.3) (op5-attack 0.005) (op5-sustain 1.0) (op5-release 0.05) (op5-velocity 0.0)
           (op6-ratio 4.0) (op6-level 0.35) (op6-attack 0.005) (op6-sustain 1.0) (op6-release 0.05) (op6-velocity 0.0) (op6-keyscale 0.0))
    ;; a clavinet: a bright 1:1 pair, a pair centred on the third harmonic for
    ;; the nasal tone, and a short burst of feedback for the pluck. Notes stop
    ;; dead when they're released, as if damped.
    (clav (feedback 0.3) (key-rate 0.3) (chorus 0.0) (level 0.45)
          (op1-detune 0.0) (op1-level 0.9) (op1-decay 5.0) (op1-release 0.05) (op1-velocity 0.5)
          (op2-level 0.2) (op2-decay 0.8) (op2-sustain 0.35) (op2-release 0.05) (op2-keyscale 0.3)
          (op3-ratio 3.0) (op3-level 0.35) (op3-decay 1.0) (op3-release 0.05)
          (op4-ratio 1.0) (op4-level 0.12) (op4-decay 0.3) (op4-release 0.05) (op4-keyscale 0.3)
          (op5-detune 0.0) (op5-level 0.3) (op5-decay 0.15) (op5-release 0.05) (op5-velocity 0.8)
          (op6-ratio 5.0) (op6-level 0.2) (op6-decay 0.05) (op6-sustain 0.0) (op6-release 0.05))
    ;; a glassy pad: slow sines an octave apart, lit from above by modulators
    ;; at high ratios and low levels which fade in more slowly still
    (glass (feedback 0.0) (key-rate 0.0) (lfo-pitch 0.05) (lfo-delay 1.0) (lfo-rate 4.5) (chorus 0.6) (level 0.3)
           (op1-detune 0.0) (op1-level 0.7) (op1-attack 0.6) (op1-decay 4.0) (op1-sustain 0.8) (op1-release 1.8) (op1-velocity 0.3)
           (op2-ratio 3.0) (op2-level 0.05) (op2-attack 1.2) (op2-decay 3.0) (op2-sustain 0.7) (op2-release 1.8) (op2-keyscale 0.3)
           (op3-ratio 2.0) (op3-detune 7.0) (op3-level 0.4) (op3-attack 0.8) (op3-decay 4.0) (op3-sustain 0.7) (op3-release 2.0) (op3-velocity 0.3)
           (op4-ratio 7.0) (op4-level 0.03) (op4-attack 0.3) (op4-decay 2.0) (op4-sustain 0.5) (op4-release 2.0)
           (op5-detune -7.0) (op5-level 0.5) (op5-attack 0.7) (op5-decay 4.0) (op5-sustain 0.8) (op5-release 1.8) (op5-velocity 0.3)
           (op6-ratio 4.0) (op6-level 0.04) (op6-attack 1.0) (op6-decay 3.0) (op6-sustain 0.6) (op6-release 1.8))))

;; The voice reads an operator's parameters by position: operator `op` (0 to
;; 5) starts where op1-ratio is, plus ten for each operator before it, and
;; `field` counts along the ten (0 ratio, 1 fixed, 2 detune, 3 level, 4
;; attack, 5 decay, 6 sustain, 7 release, 8 velocity, 9 keyscale).
(bind-macro "the parameter `field` (0 to 9) of operator `op` (0 to 5)"
  (fm_op_param p op field)
  `(pref ,p (+ ,(cadr (assoc 'op1-ratio (studio:instrument-params 'fm))) (* 10 ,op) ,field)))

;;;;;;;;;;;;;;;;;;;;;;;;;
;; the sine wave table ;;
;;;;;;;;;;;;;;;;;;;;;;;;;

;; Six operators in each of eight voices is 48 sine waves a frame, too many to
;; call sin for. Every operator reads the shared table in dsp.xtm instead
;; (sine_wrap, which takes any phase in cycles, and wrap01, which brings a
;; phase back into 0.0 to 1.0).

;;;;;;;;;;;;;;;;;;;;
;; the algorithms ;;
;;;;;;;;;;;;;;;;;;;;

;; Each algorithm is a block of 48 numbers in fm_algorithms:
;;
;;   0 to 35   which operators modulate which: entry (6 × to) + from is 1.0
;;             if operator `from` modulates operator `to`
;;   36 to 41  1.0 for each carrier (an operator which modulates nothing)
;;   42, 43    the feedback loop: the operator whose output is fed back, and
;;             the operator it's fed into
;;
;; Operators are counted from 0 here and from 1 everywhere else.
(bind-val FM_ALG_SIZE i64 48)

(bind-func static fm_algorithms_make
  (lambda ()
    (let ((table:SAMPLE* (halloc (* 32 FM_ALG_SIZE)))
          (i:i64 0))
      (dotimes (i (* 32 FM_ALG_SIZE))
        (pset! table i 0.0))
      table)))

(bind-val fm_algorithms SAMPLE* (fm_algorithms_make))

(bind-func fm_algorithm_connect
  "in algorithm alg, operator `from` modulates operator `to` (all counted from 1)"
  (lambda (alg:i64 from:i64 to:i64)
    (pset! fm_algorithms (+ (* (- alg 1) FM_ALG_SIZE) (* 6 (- to 1)) (- from 1)) 1.0)
    void))

(bind-func fm_algorithm_finish
  "set algorithm alg's feedback loop, and mark the operators which modulate nothing as carriers"
  (lambda (alg:i64 fb_from:i64 fb_to:i64)
    (let ((a (pref-ptr fm_algorithms (* (- alg 1) FM_ALG_SIZE)))
          (targets:SAMPLE 0.0)
          (from:i64 0)
          (to:i64 0))
      (dotimes (from 6)
        (set! targets 0.0)
        (dotimes (to 6)
          (set! targets (+ targets (pref a (+ (* 6 to) from)))))
        (pset! a (+ 36 from) (if (< targets 0.5) 1.0 0.0)))
      (pset! a 42 (convert (- fb_from 1) SAMPLE))
      (pset! a 43 (convert (- fb_to 1) SAMPLE))
      void)))

;; The 32 algorithms of the DX7, as drawn in its manual. Each chain lists
;; operators which modulate the next one along: (6 5 4 3) is 6 into 5 into 4
;; into 3. The pair at the end is the feedback loop, from one operator into
;; another (usually the same one).
(define *fm-algorithms*
  '((1  ((2 1) (6 5 4 3))             (6 6))
    (2  ((2 1) (6 5 4 3))             (2 2))
    (3  ((3 2 1) (6 5 4))             (6 6))
    (4  ((3 2 1) (6 5 4))             (4 6))
    (5  ((2 1) (4 3) (6 5))           (6 6))
    (6  ((2 1) (4 3) (6 5))           (5 6))
    (7  ((2 1) (4 3) (6 5 3))         (6 6))
    (8  ((2 1) (4 3) (6 5 3))         (4 4))
    (9  ((2 1) (4 3) (6 5 3))         (2 2))
    (10 ((3 2 1) (5 4) (6 4))         (3 3))
    (11 ((3 2 1) (5 4) (6 4))         (6 6))
    (12 ((2 1) (4 3) (5 3) (6 3))     (2 2))
    (13 ((2 1) (4 3) (5 3) (6 3))     (6 6))
    (14 ((2 1) (5 4 3) (6 4))         (6 6))
    (15 ((2 1) (5 4 3) (6 4))         (2 2))
    (16 ((2 1) (4 3 1) (6 5 1))       (6 6))
    (17 ((2 1) (4 3 1) (6 5 1))       (2 2))
    (18 ((2 1) (3 1) (6 5 4 1))       (3 3))
    (19 ((3 2 1) (6 4) (6 5))         (6 6))
    (20 ((3 1) (3 2) (5 4) (6 4))     (3 3))
    (21 ((3 1) (3 2) (6 4) (6 5))     (3 3))
    (22 ((2 1) (6 3) (6 4) (6 5))     (6 6))
    (23 ((1) (3 2) (6 4) (6 5))       (6 6))
    (24 ((1) (2) (6 3) (6 4) (6 5))   (6 6))
    (25 ((1) (2) (3) (6 4) (6 5))     (6 6))
    (26 ((1) (3 2) (5 4) (6 4))       (6 6))
    (27 ((1) (3 2) (5 4) (6 4))       (3 3))
    (28 ((2 1) (5 4 3) (6))           (5 5))
    (29 ((1) (2) (4 3) (6 5))         (6 6))
    (30 ((1) (2) (5 4 3) (6))         (5 5))
    (31 ((1) (2) (3) (4) (6 5))       (6 6))
    (32 ((1) (2) (3) (4) (5) (6))     (6 6))))

(for-each
  (lambda (entry)
    (let ((alg (car entry)))
      (for-each (lambda (chain)
                  (let loop ((c chain))
                    (if (and (pair? c) (pair? (cdr c)))
                        (begin (fm_algorithm_connect alg (car c) (cadr c))
                               (loop (cdr c))))))
                (cadr entry))
      (fm_algorithm_finish alg (car (caddr entry)) (cadr (caddr entry)))))
  *fm-algorithms*)

;;;;;;;;;;;;;;;
;; the voice ;;
;;;;;;;;;;;;;;;

(bind-func fm_voice_c
  (lambda (p:SAMPLE*)
    (let ((phase:SAMPLE* (zalloc 6))   ; each operator's phase, in cycles
          (inc:SAMPLE* (zalloc 6))     ; ... and how far it moves each frame
          (gain:SAMPLE* (zalloc 6))    ; level, after velocity, keyboard scaling and the index limit
          (tinc:SAMPLE* (zalloc 6))    ; where inc and gain are heading
          (tgain:SAMPLE* (zalloc 6))
          (fhz:SAMPLE* (zalloc 6))     ; each operator's frequency in Hz
          (g0:SAMPLE* (zalloc 6))      ; its level before the index limit
          (top:SAMPLE* (zalloc 6))     ; the highest frequency in its spectrum, in Hz
          (lim:SAMPLE* (zalloc 6))     ; how far the index limit turns it down as a modulator
          (raw:SAMPLE* (zalloc 6))     ; this frame's output of each operator
          ;; the envelopes: stage 0 is the attack, 1 the decay and sustain, 2 the release
          (env:SAMPLE* (zalloc 6))
          (stage:i64* (zalloc 6))
          (attack:SAMPLE* (zalloc 6))  ; added to env each frame
          (decay:SAMPLE* (zalloc 6))   ; multipliers for the distance left to go
          (release:SAMPLE* (zalloc 6))
          (sustain:SAMPLE* (zalloc 6))
          (released:i1 #f)
          (alg:SAMPLE* fm_algorithms)
          (fb_from:i64 5)
          (fb_to:i64 5)
          (fb_amount:SAMPLE 0.0)
          (fb_target:SAMPLE 0.0)
          (depth_target:SAMPLE 2.0)
          (glide:SAMPLE (- 1.0 (exp (/ -200.0 SRf))))   ; 5 ms
          (live:i1 #f)                 ; is the voice still sounding from a note before?
          (fb1:SAMPLE 0.0)
          (fb2:SAMPLE 0.0)
          (depth:SAMPLE 2.0)
          (out_scale:SAMPLE 0.0)
          (carriers:SAMPLE 0.0)
          (lfo_phase:SAMPLE 0.0)
          (lfo:SAMPLE 0.0)
          (lfo_amount:SAMPLE 0.0)
          (pitch:SAMPLE 60.0)
          (note_freq:SAMPLE 0.0)
          (rate:SAMPLE 1.0)
          (octaves:SAMPLE 0.0)
          (vibrato:SAMPLE 1.0)
          (k:i64 0))
      (dotimes (k 6)
        (pset! phase k 0.0) (pset! inc k 0.0) (pset! gain k 0.0) (pset! raw k 0.0)
        (pset! tinc k 0.0) (pset! tgain k 0.0) (pset! fhz k 0.0) (pset! g0 k 0.0)
        (pset! top k 0.0) (pset! lim k 1.0)
        (pset! env k 0.0) (pset! stage k 2) (pset! attack k 1.0) (pset! decay k 0.0)
        (pset! release k 0.0) (pset! sustain k 0.0))
      (lambda (v:Voice* out:SAMPLE*)
        ;; scratch variables are declared here rather than with the voice's
        ;; state above, so that the compiler can keep them in registers
        (let ((start:i1 (voice_start? v))
              (f:SAMPLE 0.0)
              (x:SAMPLE 0.0)
              (e:SAMPLE 0.0)
              (s:SAMPLE 0.0)
              (m:SAMPLE 0.0)
              (y:SAMPLE 0.0)
              (r:SAMPLE 0.0)
              (finished:i1 #f)
              (a:i64 0)
              (k:i64 0)
              (j:i64 0)
              (n:i64 0))
          (if start
              (begin
                ;; a voice which was silent restarts every operator from phase
                ;; zero, so that each note's attack sounds the same. One which
                ;; is still sounding (a stolen voice, or a retrigger) keeps its
                ;; phases, and its gains and frequencies glide to the new
                ;; note's, so that it doesn't click. The envelopes restart from
                ;; wherever they are.
                (set! released #f)
                (set! lfo_phase 0.0)
                (if (not live)
                    (begin
                      (set! fb1 0.0)
                      (set! fb2 0.0)
                      (dotimes (k 6)
                        (pset! phase k 0.0)
                        (pset! raw k 0.0))
                      void))
                (dotimes (k 6)
                  (pset! stage k 0))))
          ;; every 64 frames (1.5 ms), turn the parameters into frequencies,
          ;; gains and envelope rates
          (if (= (% (voice_age v) 64) 0)
              (begin
                (set! a (convert (+ (fm_algorithm p) 0.5)))
                (set! a (if (< a 1) 0 (if (> a 32) 31 (- a 1))))
                (set! alg (pref-ptr fm_algorithms (* a FM_ALG_SIZE)))
                (set! fb_from (convert (pref alg 42)))
                (set! fb_to (convert (pref alg 43)))
                ;; a modulator at level 1.0 swings its carrier's phase by two
                ;; whole cycles (a modulation index of 4π)
                (set! depth_target (* 2.0 (fm_bright p)))
                (set! carriers 0.0)
                (dotimes (k 6)
                  (set! carriers (+ carriers (pref alg (+ 36 k)))))
                ;; carriers add up, so algorithms with more of them are turned down
                (set! out_scale (/ (fm_level p) (sqrt carriers)))
                (set! pitch (+ (voice_pitch v) (fm_transpose p)))
                (set! note_freq (* (voice_freq v) (semitones (fm_transpose p))))
                (set! x (pow 2.0 (* (fm_key_rate p) (/ (- pitch 60.0) 12.0))))
                (set! rate (clamp x 0.125 8.0))
                (set! x (/ (- pitch 60.0) 12.0))
                (set! octaves (if (> x 0.0) x 0.0))
                ;; the LFO fades in over lfo-delay seconds
                (set! x (* (fm_lfo_delay p) SRf))
                (set! lfo_amount (if (< x 1.0) 1.0 (/ (convert (voice_age v) SAMPLE) x)))
                (if (> lfo_amount 1.0) (set! lfo_amount 1.0))
                (set! vibrato (semitones (* (fm_lfo_pitch p) lfo_amount lfo)))
                (dotimes (k 6)
                  (set! f (fm_op_param p k 1))
                  (if (<= f 0.0)
                      (set! f (* (fm_op_param p k 0) note_freq)))
                  (set! f (* f vibrato (pow 2.0 (/ (fm_op_param p k 2) 1200.0))))
                  (pset! fhz k f)
                  (pset! tinc k (/ f SRf))
                  ;; level, scaled by velocity and by how far above middle C the note is
                  (set! x (* (fm_op_param p k 3)
                             (- 1.0 (* (fm_op_param p k 8) (- 1.0 (voice_vel v))))
                             (pow 2.0 (* -2.0 (fm_op_param p k 9) octaves))))
                  ;; fade out an operator between 0.4 and 0.48 of the sample rate,
                  ;; before it reaches the Nyquist frequency and aliases
                  (set! s (/ (- (* 0.48 SRf) f) (* 0.08 SRf)))
                  (pset! g0 k (* x (clamp s 0.0 1.0)))
                  ;; envelope rates, sped up for higher notes by key-rate
                  (set! x (fm_op_param p k 4))
                  (pset! attack k (/ rate (* (if (< x 0.0005) 0.0005 x) SRf)))
                  (set! x (fm_op_param p k 5))
                  (pset! decay k (exp (/ (* -6.9078 rate) (* (if (< x 0.001) 0.001 x) SRf))))
                  (set! x (fm_op_param p k 7))
                  (pset! release k (exp (/ (* -6.9078 rate) (* (if (< x 0.001) 0.001 x) SRf))))
                  (set! x (fm_op_param p k 6))
                  (pset! sustain k (clamp x 0.0 1.0)))
                ;; The index limit. A modulator which swings a carrier's phase by
                ;; an index I puts sidebands at multiples of its own frequency,
                ;; strong out to about I + 3 of them either side of the carrier. So
                ;; each operator's highest frequency is its own plus (I + 3)
                ;; times the highest frequency of its modulators, and the
                ;; modulators' indices are turned down together until that is
                ;; half the sample rate. Working from operator 6 down means a
                ;; modulator's own highest frequency is known by the time its
                ;; carriers are reached. The limit follows the pitch smoothly:
                ;; low notes are untouched, and a note which climbs loses its
                ;; modulation gradually.
                (dotimes (k 6)
                  (pset! lim k 1.0))
                (dotimes (n 6)
                  (set! k (- 5 n))
                  (set! s 0.0)
                  (set! y 1.0)
                  (set! j (+ k 1))
                  (while (< j 6)
                    (if (> (pref alg (+ (* 6 k) j)) 0.5)
                        (begin
                          (set! s (+ s (* 6.2831853 depth_target (pref g0 j))))
                          (if (> (pref top j) y) (set! y (pref top j)))
                          void))
                    (set! j (+ j 1)))
                  (pset! top k (pref fhz k))
                  (if (> s 0.0)
                      (begin
                        ;; the largest total index which keeps the spectrum
                        ;; under half the sample rate, and the factor which
                        ;; brings the modulators' indices down to it. The
                        ;; sidebands which matter reach I + 3 I^(1/3) + 2
                        ;; modulator frequencies from the carrier, and the
                        ;; index is held to what that allows (found by
                        ;; bisection).
                        (set! x (- (/ (- (* 0.5 SRf) (pref fhz k)) y) 2.0))
                        (if (< x 0.0) (set! x 0.0))
                        (set! e (if (< x s) x s))
                        (if (> (+ e (* 3.0 (pow e 0.3333333))) x)
                            (begin
                              (set! e 0.0)
                              (set! f x)
                              (dotimes (a 9)
                                (set! r (* 0.5 (+ e f)))
                                (if (> (+ r (* 3.0 (pow r 0.3333333))) x)
                                    (set! f r)
                                    (set! e r)))
                              void))
                        (set! m (/ e s))
                        (pset! top k (+ (pref fhz k) (* (+ e (* 3.0 (pow e 0.3333333)) 2.0) y)))
                        (set! j (+ k 1))
                        (while (< j 6)
                          (if (and (> (pref alg (+ (* 6 k) j)) 0.5) (< m (pref lim j)))
                              (pset! lim j m))
                          (set! j (+ j 1)))
                        void)))
                (dotimes (k 6)
                  (pset! tgain k (* (pref g0 k) (pref lim k))))
                ;; feedback 1.0 swings the phase by a quarter of a cycle, about as
                ;; far as it can go before the sawtooth breaks up into noise. Its
                ;; harmonics go on forever, so above about 650 Hz it's turned down
                ;; to keep them from aliasing.
                (set! x (/ 0.015 (pref tinc fb_to)))
                (set! fb_target (* 0.25 (fm_feedback p) (if (< x 1.0) x 1.0)))))
          ;; a voice which was silent starts at the note's own values
          (if (and start (not live))
              (begin
                (dotimes (k 6)
                  (pset! inc k (pref tinc k))
                  (pset! gain k (pref tgain k)))
                (set! depth depth_target)
                (set! fb_amount fb_target)
                void))
          (dotimes (k 6)
            (pset! inc k (+ (pref inc k) (* glide (- (pref tinc k) (pref inc k)))))
            (pset! gain k (+ (pref gain k) (* glide (- (pref tgain k) (pref gain k))))))
          (set! depth (+ depth (* glide (- depth_target depth))))
          (set! fb_amount (+ fb_amount (* glide (- fb_target fb_amount))))
          (set! lfo_phase (+ lfo_phase (/ (fm_lfo_rate p) SRf)))
          (set! lfo_phase (wrap01 lfo_phase))
          (set! lfo (sine_wrap lfo_phase))
          (if (and (< (voice_gate v) 0.5) (not released))
              (begin
                (set! released #t)
                (dotimes (k 6) (pset! stage k 2))))
          ;; Run the operators from 6 down to 1. In every DX7 algorithm an
          ;; operator is modulated only by higher-numbered ones, so by the time
          ;; we reach an operator, this frame's output of each of its modulators
          ;; is ready.
          (set! y 0.0)
          (set! finished #t)
          (dotimes (n 6)
            (set! k (- 5 n))
            ;; the envelope
            (set! e (pref env k))
            (set! s (pref sustain k))
            (cond ((= (pref stage k) 0)
                   (set! e (+ e (pref attack k)))
                   (if (>= e 1.0) (begin (set! e 1.0) (pset! stage k 1)))
                   void)
                  ((= (pref stage k) 1)
                   (set! e (+ s (* (pref decay k) (- e s))))
                   ;; settle exactly, rather than creep into denormal numbers
                   (if (< (fabs (- e s)) 1.0e-7) (set! e s))
                   void)
                  (else
                    (set! e (* e (pref release k)))
                    (if (< e 1.0e-7) (set! e 0.0))
                    void))
            (pset! env k e)
            ;; the phase modulation from this operator's modulators, and from
            ;; the feedback loop (the average of its last two frames, which is
            ;; how the DX7 keeps feedback from rattling)
            (set! m 0.0)
            (set! j (+ k 1))
            (while (< j 6)
              (set! m (+ m (* (pref alg (+ (* 6 k) j)) (pref raw j))))
              (set! j (+ j 1)))
            (set! m (* depth m))
            (if (= k fb_to)
                (set! m (+ m (* fb_amount 0.5 (+ fb1 fb2)))))
            (set! x (* e (pref gain k)))
            (pset! raw k (if (= x 0.0) 0.0 (* x (sine_wrap (+ (pref phase k) m)))))
            (pset! phase k (wrap01 (+ (pref phase k) (pref inc k))))
            ;; carriers are what we hear. The note is over once every carrier
            ;; has decayed or been released to silence.
            (if (> (pref alg (+ 36 k)) 0.5)
                (begin
                  (set! y (+ y (pref raw k)))
                  (if (or (= (pref stage k) 0) (> e 0.0001))
                      (set! finished #f))
                  void)))
          (set! fb2 fb1)
          (set! fb1 (pref raw fb_from))
          ;; tremolo dips the level by up to lfo-amp
          (set! x (- 1.0 (* (fm_lfo_amp p) lfo_amount 0.5 (+ 1.0 lfo))))
          (frame_add out (* y out_scale x))
          (set! live (not finished))
          (if finished (voice_done v))
          void)))))

;;;;;;;;;;;;;;;;
;; the output ;;
;;;;;;;;;;;;;;;;

;; Two things happen to the summed voices on their way out.
;;
;; First, a highpass at 10 Hz takes out DC. A carrier and modulator at the
;; same frequency put a sideband at 0 Hz (the carrier minus one modulator
;; frequency), so a 1:1 patch has a DC offset which moves with its envelopes.
;;
;; Then a chorus, which many classic DX7 sounds were heard through. It reads
;; the voices from a delay line at two points, each swept between 4 and 10
;; milliseconds by a slow sine, half a cycle apart: one for the left channel
;; and one for the right. The voices are all in the centre, so the chorus
;; works on one channel and spreads it into two.
(bind-func fm_output_c
  (lambda (p:SAMPLE*)
    (let ((line (dl_make 1024))
          (dc_k:SAMPLE (- 1.0 (/ (* STWOPI 10.0) SRf)))
          (dc_in:SAMPLE 0.0)
          (dc_out:SAMPLE 0.0)
          (phase:SAMPLE 0.0)
          (mix:SAMPLE 0.0)
          (x:SAMPLE 0.0)
          (ms:SAMPLE (* 0.001 SRf))
          (l:SAMPLE 0.0)
          (r:SAMPLE 0.0))
      (lambda (frame:SAMPLE*)
        (set! x (pref frame 0))
        (set! x (dc_block dc_in dc_out dc_k x))
        (dl_write line x)
        (set! mix (fm_chorus p))
        (if (> mix 0.0)
            (begin
              (set! mix (if (> mix 1.0) 1.0 mix))
              (set! phase (wrap01 (+ phase (/ 0.45 SRf))))
              (set! l (dl_readf line (* ms (+ 7.0 (* 3.0 (sine_wrap phase))))))
              (set! r (dl_readf line (* ms (+ 7.0 (* 3.0 (sine_wrap (+ phase 0.5)))))))
              (pset! frame 0 (+ (* (- 1.0 (* 0.4 mix)) x) (* 0.6 mix l)))
              (pset! frame 1 (+ (* (- 1.0 (* 0.4 mix)) x) (* 0.6 mix r)))
              void)
            (begin
              (pset! frame 0 x)
              (pset! frame 1 x)
              void))
        void))))

(bind-func fm_make
  (lambda ()
    (let ((inst (inst_make "fm" 8 (fm_nparams)))
          (i:i64 0))
      (fm_defaults (inst_params inst))
      (dotimes (i 8)
        (inst_set_voice inst i (fm_voice_c (inst_voice_params inst i))))
      (inst_set_fx inst (fm_output_c (inst_params inst)))
      inst)))
