;;; scheduler.xtm -- rudimentary xtlang 'native' scheduling

;; Author: Andrew Sorensen
;; Keywords: extempore
;; Required dylibs:

;;; Commentary:

;; A scheduler is an ordered list of events, each holding a time and the name
;; of a native function to call with that time. scheduler_init turns a list
;; into a closure which, called with a time, runs everything due by then;
;; scheduler_evt (or the `sched` macro) adds to the list.

;; Everything here is generic in the time type, so a scheduler can run off
;; wall-clock seconds (clock_scheduler, a double) or musical beats
;; (beat_scheduler, a Rational). See tests/core/scheduler.xtm for the API
;; driven by hand, and examples/core/scheduler.xtm for the real thing.

;;; Code:

(if *xtc:globals:with-cache* (sys:load "libs/aot-cache/scheduler.xtm" 'quiet))
(sys:load-preload-check 'scheduler)
(define *xtmlib-scheduler-loaded* #t)

(xtc:aot:suppress-aot-do (sys:load "libs/core/rational.xtm"))
(xtc:aot:suppress-aot-do (sys:load "libs/core/xthread.xtm"))

(xtc:aot:insert-forms (sys:load "libs/core/rational.xtm"))
(xtc:aot:insert-forms (sys:load "libs/core/xthread.xtm"))

(xtc:aot:insert-header "xtmscheduler")
(xtc:aot:import-ll "xtmscheduler")


(bind-type SchedEvt <!a,i8*,SchedEvt*,SchedEvt*>
  "a scheduled call: <time,native function name,previous,next>")

;; the constructor bind-type generates for a generic type with a pointer field
;; comes out with the wrong type arguments, so build the node by hand
(bind-func SchedEvt_new:[SchedEvt{!a}*,!a,i8*,SchedEvt{!a}*,SchedEvt{!a}*]*
  (lambda (time fname prev next)
    (let ((evt:SchedEvt{!a}* (halloc)))
      (tset! evt 0 time)
      (tset! evt 1 fname)
      (tset! evt 2 prev)
      (tset! evt 3 next)
      evt)))

(bind-func scheduler_init:[[i64,!a]*,SchedEvt{!a}*,[void,!a]*]*
  (lambda (el f)
    (let ((mutex:i8* (mutex_create))
          (thread:i8* (thread_self))
          (cnt 0)
          (evtlist:SchedEvt{!a}* el)
          (fp:[void,!a]* f)
          (element:SchedEvt{!a}* null)
          (next:SchedEvt{!a}* null)
          (prev:SchedEvt{!a}* null))
      (lambda (time)
        (set! cnt 0)
        (mutex_lock mutex)
        (set! element evtlist)
        (while (and (not (null? element))
                    (<= (tref element 0) time))
          (set! cnt (+ cnt 1))
          (set! fp (cast (llvm_get_function_ptr (tref element 1))))
          ;; (println "exec: " time ":" (tref element 0))
          (fptrcall fp (tref element 0)) ; (tref element 2))
          (set! next (tref element 3))
          (set! prev (tref element 2))
          (if (null? prev)
              (set! evtlist next)
              (tset! prev 3 next))
          (if (not (null? next)) (tset! next 2 prev))
          (free element)
          (set! element next))
        (mutex_unlock mutex)
        cnt))))

(bind-func scheduler_at:[SchedEvt{!a}*,SchedEvt{!a}*,!a]*
  "the last event in EVTLIST at or before TIME, or null if there is none"
  (lambda (evtlist time)
    (let ((prev:SchedEvt{!a}* null)
          (evt:SchedEvt{!a}* evtlist))
      (while (and (not (null? evt))
                  (<= (tref evt 0) time))
        (set! prev evt)
        (set! evt (tref evt 3)))
      prev)))

(bind-func scheduler_evt:[void,[i64,!a]*,!a,i8*]*
  "add an event calling FNAME at TIME to SCHEDULER's list"
  (lambda (scheduler time fname)
    (let ((lock (= (thread_equal_self (scheduler.thread)) 0))
          (prev:SchedEvt{!a}* null)
          (next:SchedEvt{!a}* null)
          (new:SchedEvt{!a}* null))
      (if lock (mutex_lock (scheduler.mutex)))
      (set! prev (scheduler_at (scheduler.evtlist) time))
      (if (null? prev)
          (begin
            (set! next (scheduler.evtlist))
            (set! new (SchedEvt_new time fname null next))
            (if (not (null? next)) (tset! next 2 new))
            (scheduler.evtlist new)
            void)
          (begin
            (set! next (tref prev 3)) ;; get next from previous
            (set! new (SchedEvt_new time fname prev next))
            (tset! prev 3 new) ;; make us next of previous
            (if (not (null? next)) (tset! next 2 new)) ;; set us to previous of next
            void))
      (if lock (mutex_unlock (scheduler.mutex)))
      void)))

(bind-alias SCHED [void]*)

(bind-macro
  ""
  (sched sname time fname)
  `(scheduler_evt (,(string->symbol (string-append (symbol->string sname) ".scheduler")))
    ,time (get_native_name ,fname)))


(bind-alias CLOCKEVT [void,double]*)

(bind-func clock_scheduler
  (lambda (hz:double)
    (let ((evtlist:SchedEvt{double}* null)
          (ft:[void,double]* null)
          (scheduler:[i64,double]* null)
          (running:i64 1)
          (time 0.0)
          (err 0)
          (i (/ 1.0 hz))
          (f (lambda ()
               (spawn (lambda ()
                        (set! scheduler (scheduler_init evtlist ft))
                        (set! time (clock_clock))
                        (while (> running 0)
                          (scheduler time)
                          (while (< (clock_clock) time) (thread_sleep 0 100000))
                          (set! time (+ time i))
                          void)
                        (println "exiting scheduler")))
               void)))
      (f)
      f)))

(bind-alias BEATEVT [void,Rational]*)

(bind-func beat_scheduler
  (lambda (bpm:double hz:double)
    (let ((evtlist:SchedEvt{Rational}* null)
          (ft:[void,Rational]* null)
          (scheduler:[i64,Rational]* null)
          (beat:Rational (Rat 1 1))
          (running:i64 1)
          (offset:i64 0)
          (time 0.0)
          (i (Rat 1 (dtoi64 hz)))
          (f (lambda ()
               (spawn (lambda ()
                        (set! scheduler (scheduler_init evtlist ft))
                        (set! time (clock_clock))
                        (while (> running 0)
                          (scheduler beat)
                          (set! beat (+ beat (* i (Rat (dtoi64 bpm) 60))))
                          (while (< (clock_clock) time) (thread_sleep 0 100000))
                          (set! time (+ time (rtod i)))
                          void)
                        (println "exiting scheduler")))
               void)))
      (f)
      f)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *xtmlib-scheduler-loaded* #t)
(xtc:aot:insert-footer "xtmscheduler")
