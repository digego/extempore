;;; audiofile.xtm -- reading and writing WAV and AIFF files

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; Reads uncompressed WAV, AIFF and AIFF-C files, and writes WAV files.
;;
;;   (audiofile_frames path)        ;; frames in the file, or -1
;;   (audiofile_channels path)      ;; channels, or -1
;;   (audiofile_samplerate path)    ;; samples per second, or -1.0
;;   (audiofile_read path dest start nframes)
;;   (audiofile_write_wav path src nframes channels samplerate encoding)
;;
;; audiofile_read reads at most nframes frames, starting start frames in, into
;; dest as interleaved SAMPLEs (nframes * channels of them), and returns how
;; many frames it read, or -1 if the file can't be read. Only the frames asked
;; for are read from disk. Every encoding is scaled so that full scale is 1.0:
;; a 16-bit sample is divided by 32768, a 24-bit one by 8388608, and so on.
;;
;; The encodings read are 8, 16, 24 and 32-bit integers and 32 and 64-bit
;; floats, in WAV (including WAVE_FORMAT_EXTENSIBLE) and AIFF or AIFF-C
;; (NONE, twos, sowt, fl32 and fl64). audiofile_write_wav writes
;; AUDIOFILE_PCM_16, AUDIOFILE_PCM_24, AUDIOFILE_PCM_32, AUDIOFILE_FLOAT_32 or
;; AUDIOFILE_FLOAT_64, clipping integer samples to [-1, 1].
;;
;; A relative path which isn't found is retried relative to the Extempore
;; share directory.

;;; Code:

(if *xtc:globals:with-cache* (sys:load (sys:aot-cache-path "audiofile.xtm") 'quiet))
(sys:load-preload-check 'audiofile)
(define *xtmlib-audiofile-loaded* #f)

(xtc:aot:suppress-aot-do
 (sys:load "libs/base/base.xtm"))
(xtc:aot:insert-forms
 (sys:load "libs/base/base.xtm" 'quiet))

(xtc:aot:insert-header "xtmaudiofile")
(xtc:aot:import-ll "xtmaudiofile")

;; the sample encodings
(bind-val AUDIOFILE_PCM_U8 i64 1)    ;; unsigned 8-bit (WAV's 8-bit)
(bind-val AUDIOFILE_PCM_8 i64 2)     ;; signed 8-bit (AIFF's 8-bit)
(bind-val AUDIOFILE_PCM_16 i64 3)
(bind-val AUDIOFILE_PCM_24 i64 4)
(bind-val AUDIOFILE_PCM_32 i64 5)
(bind-val AUDIOFILE_FLOAT_32 i64 6)
(bind-val AUDIOFILE_FLOAT_64 i64 7)

(bind-func static audiofile_encoding_bytes
  "bytes per sample of an encoding, or 0 for an unknown one"
  (lambda (enc:i64)
    (cond ((or (= enc AUDIOFILE_PCM_U8) (= enc AUDIOFILE_PCM_8)) 1)
          ((= enc AUDIOFILE_PCM_16) 2)
          ((= enc AUDIOFILE_PCM_24) 3)
          ((or (= enc AUDIOFILE_PCM_32) (= enc AUDIOFILE_FLOAT_32)) 4)
          ((= enc AUDIOFILE_FLOAT_64) 8)
          (else 0))))

;; What a file's header says: 0 frames, 1 channels, 2 samplerate, 3 encoding,
;; 4 whether the samples are little-endian, 5 the byte offset of the first
;; frame.
(bind-type AudioFileInfo <i64,i64,double,i64,i1,i64> (printer? . #f))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; reading integers out of bytes, any order ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(bind-func static audiofile_u8
  (lambda (p:i8* i:i64)
    (& (convert (pref p i) i64) 255)))

(bind-func static audiofile_le16
  (lambda (p:i8*)
    (bor (audiofile_u8 p 0) (<< (audiofile_u8 p 1) 8))))

(bind-func static audiofile_le32
  (lambda (p:i8*)
    (bor (bor (audiofile_u8 p 0) (<< (audiofile_u8 p 1) 8))
         (bor (<< (audiofile_u8 p 2) 16) (<< (audiofile_u8 p 3) 24)))))

(bind-func static audiofile_be16
  (lambda (p:i8*)
    (bor (<< (audiofile_u8 p 0) 8) (audiofile_u8 p 1))))

(bind-func static audiofile_be32
  (lambda (p:i8*)
    (bor (bor (<< (audiofile_u8 p 0) 24) (<< (audiofile_u8 p 1) 16))
         (bor (<< (audiofile_u8 p 2) 8) (audiofile_u8 p 3)))))

(bind-func static audiofile_tag_is
  "do the four bytes at p spell tag?"
  (lambda (p:i8* tag:i8*)
    (= (strncmp p tag 4) 0)))

;;;;;;;;;;;;;;;;;;;;;;
;; parsing a header ;;
;;;;;;;;;;;;;;;;;;;;;;

(bind-func static audiofile_open
  "fopen path for reading (or retry it relative to the share directory)"
  (lambda (path:i8*)
    (let ((fp (fopen path "rb")))
      (if (null? fp)
          (let ((sharedir (sys_sharedir))
                (sharepath:i8* (salloc (+ (strlen sharedir) (strlen path) 2))))
            (sprintf sharepath "%s/%s" sharedir path)
            (fopen sharepath "rb"))
          fp))))

(bind-func static audiofile_wave_encoding
  "the encoding of a WAV fmt chunk's format tag and bits per sample"
  (lambda (tag:i64 bits:i64)
    (cond ((= tag 1)
           (cond ((= bits 8) AUDIOFILE_PCM_U8)
                 ((= bits 16) AUDIOFILE_PCM_16)
                 ((= bits 24) AUDIOFILE_PCM_24)
                 ((= bits 32) AUDIOFILE_PCM_32)
                 (else 0)))
          ((= tag 3)
           (cond ((= bits 32) AUDIOFILE_FLOAT_32)
                 ((= bits 64) AUDIOFILE_FLOAT_64)
                 (else 0)))
          (else 0))))

(bind-func static audiofile_aiff_encoding
  "the encoding of an AIFF COMM chunk's sample size (and AIFF-C compression
type, or null), and whether it is little-endian"
  (lambda (bits:i64 compression:i8* le:i1*)
    (pset! le 0 #f)
    (let ((pcm (cond ((= bits 8) AUDIOFILE_PCM_8)
                     ((= bits 16) AUDIOFILE_PCM_16)
                     ((= bits 24) AUDIOFILE_PCM_24)
                     ((= bits 32) AUDIOFILE_PCM_32)
                     (else 0))))
      (cond ((null? compression) pcm)
            ((or (audiofile_tag_is compression "NONE") (audiofile_tag_is compression "twos")) pcm)
            ((audiofile_tag_is compression "sowt") (pset! le 0 #t) pcm)
            ((or (audiofile_tag_is compression "fl32") (audiofile_tag_is compression "FL32")) AUDIOFILE_FLOAT_32)
            ((or (audiofile_tag_is compression "fl64") (audiofile_tag_is compression "FL64")) AUDIOFILE_FLOAT_64)
            (else 0)))))

(bind-func static audiofile_parse:[i8*,i8*,AudioFileInfo*]*
  "fill info from the header of the open file fp, walking its chunks.
Returns an error message, or null if the file is one we can read."
  (lambda (fp:i8* info:AudioFileInfo*)
    (let ((hdr:i8* (salloc 12))
          (chunk:i8* (salloc 8))
          (fmt:i8* (salloc 40))
          (le:i1* (salloc 1))
          (filesize:i64 0)
          (pos:i64 12)
          (size:i64 0)
          (payload:i64 0)
          (wave:i1 #f) (aifc:i1 #f)
          (have_fmt:i1 #f) (have_data:i1 #f)
          (channels:i64 0) (samplerate:double 0.0) (enc:i64 0)
          (declared:i64 -1) (dataoff:i64 0) (datalen:i64 0)
          (framebytes:i64 0) (n:i64 0) (tag:i64 0) (skip:i64 0)
          (err:i8* null))
      (fseek fp 0 2:i32) ;; SEEK_END
      (set! filesize (ftell fp))
      (fseek fp 0 0:i32)
      (pset! le 0 #t)
      (cond
        ((or (< filesize 12) (<> (fread hdr 1 12 fp) 12))
         (set! err "the file is too short to be a WAV or AIFF file") void)
        ((and (audiofile_tag_is hdr "RIFF") (audiofile_tag_is (pref-ptr hdr 8) "WAVE"))
         (set! wave #t) void)
        ((and (audiofile_tag_is hdr "FORM") (audiofile_tag_is (pref-ptr hdr 8) "AIFF"))
         void)
        ((and (audiofile_tag_is hdr "FORM") (audiofile_tag_is (pref-ptr hdr 8) "AIFC"))
         (set! aifc #t) void)
        (else (set! err "the file isn't a WAV or AIFF file") void))
      (if (null? err)
          (begin
            ;; walk the chunks until both the format and the data are found
            (while (and (not (and have_fmt have_data))
                        (<= (+ pos 8) filesize))
              (fseek fp pos 0:i32)
              (if (<> (fread chunk 1 8 fp) 8) (set! filesize 0)) ;; ends the walk
              (set! size (if wave (audiofile_le32 (pref-ptr chunk 4)) (audiofile_be32 (pref-ptr chunk 4))))
              (set! payload (+ pos 8))
              (cond
                ((and wave (audiofile_tag_is chunk "fmt ") (>= size 16))
                 (set! n (fread fmt 1 (if (< size 40) size 40) fp))
                 (if (>= n 16)
                     (begin
                       (set! tag (audiofile_le16 fmt))
                       (set! channels (audiofile_le16 (pref-ptr fmt 2)))
                       (set! samplerate (convert (audiofile_le32 (pref-ptr fmt 4)) double))
                       ;; WAVE_FORMAT_EXTENSIBLE keeps the real format tag in
                       ;; the first two bytes of a GUID further along
                       (if (and (= tag #xfffe) (>= n 26))
                           (set! tag (audiofile_le16 (pref-ptr fmt 24))))
                       (set! enc (audiofile_wave_encoding tag (audiofile_le16 (pref-ptr fmt 14))))
                       (set! have_fmt #t)
                       void)))
                ((and wave (audiofile_tag_is chunk "data"))
                 (set! dataoff payload)
                 (set! datalen size)
                 (set! have_data #t)
                 void)
                ((and (not wave) (audiofile_tag_is chunk "COMM") (>= size 18))
                 (set! n (fread fmt 1 (if (< size 22) size 22) fp))
                 (if (>= n 18)
                     (begin
                       (set! channels (audiofile_be16 fmt))
                       (set! declared (audiofile_be32 (pref-ptr fmt 2)))
                       ;; fp80ptrtod reads the big-endian 80-bit float AIFF stores
                       (set! samplerate (fp80ptrtod (pref-ptr fmt 8)))
                       (set! enc (audiofile_aiff_encoding (audiofile_be16 (pref-ptr fmt 6))
                                                          (if (and aifc (>= n 22)) (pref-ptr fmt 18) null)
                                                          le))
                       (set! have_fmt #t)
                       void)))
                ((and (not wave) (audiofile_tag_is chunk "SSND") (>= size 8))
                 (if (= (fread fmt 1 8 fp) 8)
                     (begin
                       (set! skip (audiofile_be32 fmt))
                       (set! dataoff (+ payload 8 skip))
                       (set! datalen (- size (+ 8 skip)))
                       (set! have_data #t)
                       void)))
                (else void))
              ;; chunks are padded out to an even number of bytes
              (set! pos (+ payload size (& size 1))))
            (cond
              ((not have_fmt) (set! err "the format chunk is missing or truncated") void)
              ((not have_data) (set! err "the sample data chunk is missing") void)
              ((or (< channels 1) (> channels 1024)) (set! err "the header has a bogus channel count") void)
              ;; a NaN rate fails the first test, xtlang's float comparisons
              ;; being true for NaN
              ((or (<= samplerate 0.0) (> samplerate 10000000.0)) (set! err "the header has a bogus sample rate") void)
              ((= enc 0) (set! err "the sample encoding isn't one this library reads") void)
              (else
               (set! framebytes (* channels (audiofile_encoding_bytes enc)))
               ;; a truncated file (or a streamed WAV, whose data chunk claims
               ;; 4GB) holds only the frames actually there
               (if (or (< datalen 0) (> (+ dataoff datalen) filesize))
                   (set! datalen (- filesize dataoff)))
               (set! n (if (< datalen 0) 0 (/ datalen framebytes)))
               (if (and (>= declared 0) (< declared n)) (set! n declared))
               (tfill! info n channels samplerate enc (pref le 0) dataoff)
               void))))
      err)))

(bind-func audiofile_info
  "fill info from the header of the file at path; returns #t on success, and
prints why not otherwise"
  (lambda (path:i8* info:AudioFileInfo*)
    (let ((fp (audiofile_open path))
          (err:i8* null))
      (if (null? fp)
          (begin (let ((msg:i8* (salloc 512)))
                   (sprintf msg "audiofile: can't open %s" path)
                   (log_error msg)) #f)
          (begin
            (set! err (audiofile_parse fp info))
            (fclose fp)
            (if (null? err)
                #t
                (begin (let ((msg:i8* (salloc 512)))
                         (sprintf msg "audiofile: can't read %s: %s" path err)
                         (log_error msg)) #f)))))))

(bind-func audiofile_frames
  "the number of frames in the audio file at path, or -1"
  (lambda (path:i8*)
    (let ((info:AudioFileInfo* (salloc)))
      (if (audiofile_info path info) (tref info 0) -1))))

(bind-func audiofile_channels
  "the number of channels in the audio file at path, or -1"
  (lambda (path:i8*)
    (let ((info:AudioFileInfo* (salloc)))
      (if (audiofile_info path info) (tref info 1) -1))))

(bind-func audiofile_samplerate
  "the sample rate of the audio file at path, or -1.0"
  (lambda (path:i8*)
    (let ((info:AudioFileInfo* (salloc)))
      (if (audiofile_info path info) (tref info 2) -1.0))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; converting samples to and from SAMPLEs ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The loops load samples as whole integers or floats, which assumes a
;; little-endian machine (as every platform Extempore runs on is); big-endian
;; samples are byte-swapped after loading. Each conversion is written out in
;; its own loop, because xtlang functions aren't inlined into each other and
;; a call per sample costs several times the conversion itself.

(bind-func static audiofile_decode
  "convert n samples of encoding enc at src into SAMPLEs at dest"
  (lambda (src:i8* dest:SAMPLE* n:i64 enc:i64 le:i1)
    (let ((i:i64 0) (j:i64 0)
          (s16:i16* (cast src i16*))
          (s32:i32* (cast src i32*))
          (s64:i64* (cast src i64*))
          (f32:float* (cast src float*))
          (f64:double* (cast src double*))
          (v:i32 0) (w:i64 0)
          (b0:i32 0) (b1:i32 0) (b2:i32 0)
          (t32:i32* (salloc 1))
          (t64:i64* (salloc 1))
          (k8:SAMPLE (convert (/ 1.0 128.0) SAMPLE))
          (k16:SAMPLE (convert (/ 1.0 32768.0) SAMPLE))
          (k32:SAMPLE (convert (/ 1.0 2147483648.0) SAMPLE)))
      (cond
        ((= enc AUDIOFILE_PCM_U8)
         (dotimes (i n)
           (pset! dest i (* k8 (convert (- (& (convert (pref src i) i32) 255) 128) SAMPLE)))))
        ((= enc AUDIOFILE_PCM_8)
         (dotimes (i n)
           (pset! dest i (* k8 (convert (pref src i) SAMPLE)))))
        ((and (= enc AUDIOFILE_PCM_16) le)
         (dotimes (i n)
           (pset! dest i (* k16 (convert (pref s16 i) SAMPLE)))))
        ((= enc AUDIOFILE_PCM_16)
         (dotimes (i n)
           (set! v (convert (pref s16 i) i32))
           (set! v (bor (<< (& v 255) 8) (& (>> v 8) 255)))
           (pset! dest i (* k16 (convert (convert v i16) SAMPLE)))))
        ((= enc AUDIOFILE_PCM_24)
         ;; the 24 bits go at the top of an i32, which carries the sign
         (dotimes (i n)
           (set! j (* 3 i))
           (set! b0 (& (convert (pref src j) i32) 255))
           (set! b1 (& (convert (pref src (+ j 1)) i32) 255))
           (set! b2 (& (convert (pref src (+ j 2)) i32) 255))
           (set! v (if le
                       (bor (<< b0 8) (bor (<< b1 16) (<< b2 24)))
                       (bor (<< b2 8) (bor (<< b1 16) (<< b0 24)))))
           (pset! dest i (* k32 (convert v SAMPLE)))))
        ((and (= enc AUDIOFILE_PCM_32) le)
         (dotimes (i n)
           (pset! dest i (* k32 (convert (pref s32 i) SAMPLE)))))
        ((= enc AUDIOFILE_PCM_32)
         (dotimes (i n)
           (set! v (pref s32 i))
           (set! v (bor (bor (& (>> v 24) 255) (& (>> v 8) #xff00))
                        (bor (& (<< v 8) #xff0000) (<< v 24))))
           (pset! dest i (* k32 (convert v SAMPLE)))))
        ((and (= enc AUDIOFILE_FLOAT_32) le)
         (dotimes (i n)
           (pset! dest i (convert (pref f32 i) SAMPLE))))
        ((= enc AUDIOFILE_FLOAT_32)
         (dotimes (i n)
           (set! v (pref s32 i))
           (pset! t32 0 (bor (bor (& (>> v 24) 255) (& (>> v 8) #xff00))
                             (bor (& (<< v 8) #xff0000) (<< v 24))))
           (pset! dest i (convert (pref (cast t32 float*) 0) SAMPLE))))
        ((and (= enc AUDIOFILE_FLOAT_64) le)
         (dotimes (i n)
           (pset! dest i (convert (pref f64 i) SAMPLE))))
        ((= enc AUDIOFILE_FLOAT_64)
         (dotimes (i n)
           (set! w (pref s64 i))
           (pset! t64 0 (bor (bor (bor (& (>> w 56) 255) (& (>> w 40) #xff00))
                                  (bor (& (>> w 24) #xff0000) (& (>> w 8) #xff000000)))
                             (bor (bor (& (<< w 8) #xff00000000) (& (<< w 24) #xff0000000000))
                                  (bor (& (<< w 40) #xff000000000000) (<< w 56)))))
           (pset! dest i (convert (pref (cast t64 double*) 0) SAMPLE))))
        (else void))
      void)))

(bind-func static audiofile_encode
  "convert n SAMPLEs at src into little-endian samples of encoding enc at
dest, clipping integer ones to [-1, 1]"
  (lambda (src:SAMPLE* dest:i8* n:i64 enc:i64)
    (let ((i:i64 0) (j:i64 0) (x:double 0.0) (v:i64 0) (scale:double 0.0) (top:i64 0)
          (d16:i16* (cast dest i16*))
          (d32:i32* (cast dest i32*))
          (f32:float* (cast dest float*))
          (f64:double* (cast dest double*)))
      (cond
        ((= enc AUDIOFILE_FLOAT_32)
         (dotimes (i n) (pset! f32 i (convert (pref src i) float))))
        ((= enc AUDIOFILE_FLOAT_64)
         (dotimes (i n) (pset! f64 i (convert (pref src i) double))))
        (else
         (set! scale (cond ((= enc AUDIOFILE_PCM_16) 32768.0)
                           ((= enc AUDIOFILE_PCM_24) 8388608.0)
                           (else 2147483648.0)))
         (set! top (- (convert scale i64) 1))
         (dotimes (i n)
           (set! x (convert (pref src i) double))
           ;; NaN first, since xtlang's float comparisons are true for it
           (set! x (cond ((<> x x) 0.0) ((> x 1.0) 1.0) ((< x -1.0) -1.0) (else x)))
           (set! v (convert (floor (+ 0.5 (* scale x))) i64))
           (if (> v top) (set! v top))
           (cond ((= enc AUDIOFILE_PCM_16) (pset! d16 i (convert v i16)) void)
                 ((= enc AUDIOFILE_PCM_32) (pset! d32 i (convert v i32)) void)
                 (else
                  (set! j (* 3 i))
                  (pset! dest j (convert (& v 255) i8))
                  (pset! dest (+ j 1) (convert (& (>> v 8) 255) i8))
                  (pset! dest (+ j 2) (convert (& (>> v 16) 255) i8))
                  void)))))
      void)))

;;;;;;;;;;;;;;;;;;;;;;;;;
;; reading and writing ;;
;;;;;;;;;;;;;;;;;;;;;;;;;

;; samples are read and written through a buffer of this many frames
(bind-val AUDIOFILE_BLOCK_FRAMES i64 16384)

(bind-func audiofile_read
  "read at most nframes frames, from frame start on, of the audio file at path
into dest (as interleaved SAMPLEs); returns the number of frames read, or -1
if the file can't be read"
  (lambda (path:i8* dest:SAMPLE* start:i64 nframes:i64)
    (let ((fp (audiofile_open path))
          (info:AudioFileInfo* (salloc))
          (err:i8* null))
      (if (null? fp)
          (begin (let ((msg:i8* (salloc 512)))
                   (sprintf msg "audiofile: can't open %s" path)
                   (log_error msg)) -1)
          (begin
            (set! err (audiofile_parse fp info))
            (if (not (null? err))
                (begin
                  (let ((msg:i8* (salloc 512)))
                    (sprintf msg "audiofile: can't read %s: %s" path err)
                    (log_error msg))
                  (fclose fp)
                  -1)
                (let ((frames (tref info 0))
                      (channels (tref info 1))
                      (enc (tref info 3))
                      (le (tref info 4))
                      (framebytes (* channels (audiofile_encoding_bytes enc)))
                      (from (if (< start 0) 0 (if (> start frames) frames start)))
                      (todo (if (< nframes 0) 0 (if (> nframes (- frames from)) (- frames from) nframes)))
                      (block:i8* (malloc (* AUDIOFILE_BLOCK_FRAMES framebytes)))
                      (done:i64 0) (want:i64 0) (got:i64 0) (reading:i1 #t))
                  (fseek fp (+ (tref info 5) (* from framebytes)) 0:i32)
                  (while (and reading (< done todo))
                    (set! want (if (< (- todo done) AUDIOFILE_BLOCK_FRAMES) (- todo done) AUDIOFILE_BLOCK_FRAMES))
                    (set! got (/ (fread block 1 (* want framebytes) fp) framebytes))
                    (audiofile_decode block (pref-ptr dest (* done channels)) (* got channels) enc le)
                    (set! done (+ done got))
                    (if (< got want) (set! reading #f)))
                  (free block)
                  (fclose fp)
                  done)))))))

(bind-func static audiofile_put_le
  "store the low nbytes bytes of v at p, little-endian"
  (lambda (p:i8* v:i64 nbytes:i64)
    (let ((k:i64 0))
      (dotimes (k nbytes)
        (pset! p k (convert (& (>> v (* 8 k)) 255) i8)))
      void)))

(bind-func audiofile_write_wav
  "write nframes frames of interleaved SAMPLEs from src to a WAV file at
path, in encoding enc (AUDIOFILE_PCM_16, _24 or _32, or AUDIOFILE_FLOAT_32
or _64); returns #t on success"
  (lambda (path:i8* src:SAMPLE* nframes:i64 channels:i64 samplerate:i64 enc:i64)
    (let ((bytes (audiofile_encoding_bytes enc))
          (framebytes (* channels bytes))
          (datalen (* nframes framebytes))
          (hdr:i8* (salloc 44))
          (fp:i8* null)
          (block:i8* null)
          (done:i64 0) (n:i64 0) (ok:i1 #t))
      (cond
        ((or (< enc AUDIOFILE_PCM_16) (> enc AUDIOFILE_FLOAT_64))
         (let ((msg:i8* (salloc 512)))
           (sprintf msg "audiofile: can't write %s: WAV files are written as AUDIOFILE_PCM_16, _24 or _32, or AUDIOFILE_FLOAT_32 or _64" path)
           (log_error msg))
         #f)
        ((or (< channels 1) (< nframes 0) (< samplerate 1))
         (let ((msg:i8* (salloc 512)))
           (sprintf msg "audiofile: can't write %s: bad channel count, frame count or sample rate" path)
           (log_error msg))
         #f)
        ((> (+ datalen 36) 4294967295)
         (let ((msg:i8* (salloc 512)))
           (sprintf msg "audiofile: can't write %s: a WAV file holds at most 4GB of samples" path)
           (log_error msg))
         #f)
        (else
         (set! fp (fopen path "wb"))
         (if (null? fp)
             (begin (let ((msg:i8* (salloc 512)))
                      (sprintf msg "audiofile: can't open %s for writing" path)
                      (log_error msg)) #f)
             (begin
               (memcpy hdr "RIFF" 4)
               (audiofile_put_le (pref-ptr hdr 4) (+ datalen 36) 4)
               (memcpy (pref-ptr hdr 8) "WAVEfmt " 8)
               (audiofile_put_le (pref-ptr hdr 16) 16 4)
               (audiofile_put_le (pref-ptr hdr 20) (if (>= enc AUDIOFILE_FLOAT_32) 3 1) 2)
               (audiofile_put_le (pref-ptr hdr 22) channels 2)
               (audiofile_put_le (pref-ptr hdr 24) samplerate 4)
               (audiofile_put_le (pref-ptr hdr 28) (* samplerate framebytes) 4)
               (audiofile_put_le (pref-ptr hdr 32) framebytes 2)
               (audiofile_put_le (pref-ptr hdr 34) (* 8 bytes) 2)
               (memcpy (pref-ptr hdr 36) "data" 4)
               (audiofile_put_le (pref-ptr hdr 40) datalen 4)
               (if (<> (fwrite hdr 1 44 fp) 44) (set! ok #f))
               (set! block (malloc (* AUDIOFILE_BLOCK_FRAMES framebytes)))
               (while (and ok (< done nframes))
                 (set! n (if (< (- nframes done) AUDIOFILE_BLOCK_FRAMES) (- nframes done) AUDIOFILE_BLOCK_FRAMES))
                 (audiofile_encode (pref-ptr src (* done channels)) block (* n channels) enc)
                 (if (<> (fwrite block 1 (* n framebytes) fp) (* n framebytes)) (set! ok #f))
                 (set! done (+ done n)))
               (free block)
               (if (<> (fclose fp) 0) (set! ok #f))
               (if (not ok) (let ((msg:i8* (salloc 512)))
                              (sprintf msg "audiofile: writing %s failed" path)
                              (log_error msg)))
               ok)))))))

(xtc:aot:insert-footer "xtmaudiofile")
(define *xtmlib-audiofile-loaded* #t)
