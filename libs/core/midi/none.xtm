;;; none.xtm -- the MIDI backend for a platform which has none yet

;; Loaded by libs/core/midi.xtm, which says what a backend defines. This one
;; finds no ports and opens none, so loopback ports are all that work.

(bind-func midi_be_init
  (lambda ()
    #f))

(bind-func midi_be_scan
  (lambda ()
    void))

(bind-func midi_be_open
  (lambda (port:MidiPort* a:i64 b:i64 name:i8*)
    #f))

(bind-func midi_be_close
  (lambda (port:MidiPort*)
    void))

(bind-func midi_be_send
  (lambda (port:MidiPort* bytes:i8* n:i64)
    #f))
