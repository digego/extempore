{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Release, Ninja, tests on)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci",
      "inherits": "default",
      "displayName": "CI build & test"
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "Release artefact (assets, no tests, relocatable share dir)",
      "cacheVariables": {
        "BUILD_TESTS": "OFF",
        "ASSETS": "ON",
        "EXT_SHARE_DIR": "."
      }
    },
    {
      "name": "sanitize-asan",
      "inherits": "default",
      "displayName": "AddressSanitizer",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "EXTEMPORE_SANITIZE": "asan"
      }
    },
    {
      "name": "sanitize-ubsan",
      "inherits": "default",
      "displayName": "UndefinedBehaviorSanitizer",
      "binaryDir": "${sourceDir}/build-ubsan",
      "cacheVariables": {
        "EXTEMPORE_SANITIZE": "ubsan"
      }
    },
    {
      "name": "sanitize-tsan",
      "inherits": "default",
      "displayName": "ThreadSanitizer",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "EXTEMPORE_SANITIZE": "tsan"
      }
    },
    {
      "name": "sanitize-asan-ubsan",
      "inherits": "default",
      "displayName": "Address + UndefinedBehaviorSanitizer",
      "binaryDir": "${sourceDir}/build-asan-ubsan",
      "cacheVariables": {
        "EXTEMPORE_SANITIZE": "asan+ubsan"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "release", "configurePreset": "release" },
    { "name": "sanitize-asan", "configurePreset": "sanitize-asan" },
    { "name": "sanitize-ubsan", "configurePreset": "sanitize-ubsan" },
    { "name": "sanitize-tsan", "configurePreset": "sanitize-tsan" },
    { "name": "sanitize-asan-ubsan", "configurePreset": "sanitize-asan-ubsan" }
  ],
  "testPresets": [
    {
      "name": "default",
      "displayName": "The suites CI runs (docs/verify-examples is local-only: ctest -L docs)",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 },
      "filter": {
        "include": {
          "label": "libs-core|libs-studio|compiler-unit|cpp-unit|nrepl|examples-core|examples-audio|audio-offline"
        }
      }
    },
    {
      "name": "ci",
      "inherits": "default",
      "configurePreset": "ci"
    },
    {
      "$comment": "The fast, deterministic suites: the example tests' timeouts don't allow for a sanitizer's slowdown, and compiler-unit's AOT round trip runs its own unscaled timeouts. Under ASan the JIT-compiled xtlang is instrumented and zone memory poisoned, so the studio and offline renders exercise most of xtlang's memory traffic.",
      "name": "sanitize-asan",
      "configurePreset": "sanitize-asan",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=0:detect_leaks=0:abort_on_error=1:detect_container_overflow=0",
        "UBSAN_OPTIONS": "halt_on_error=0:print_stacktrace=1"
      },
      "filter": {
        "include": {
          "label": "libs-core|cpp-unit|libs-studio|nrepl|audio-offline"
        }
      }
    },
    {
      "name": "sanitize-ubsan",
      "inherits": "sanitize-asan",
      "configurePreset": "sanitize-ubsan"
    },
    {
      "name": "sanitize-asan-ubsan",
      "inherits": "sanitize-asan",
      "configurePreset": "sanitize-asan-ubsan"
    },
    {
      "name": "sanitize-tsan",
      "configurePreset": "sanitize-tsan",
      "output": { "outputOnFailure": true },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=0 second_deadlock_stack=1"
      },
      "filter": {
        "include": {
          "label": "libs-core|cpp-unit|nrepl"
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "default" },
        { "type": "test", "name": "default" }
      ]
    }
  ]
}
