---
# Left out on purpose:
# - bugprone-throwing-static-initialization: it flags every process-lifetime
#   global (a static std::string), and a failed allocation at static init ends
#   the process however it is written.
# - bugprone-signed-bitwise: an unsigned char operand is promoted to int, so
#   it flags every expression which packs or unpacks bytes.
# - performance-avoid-endl: the runtime's output is interactive diagnostics,
#   where the flush is what's wanted.
# - cppcoreguidelines-pro-type-static-cast-downcast: its fix is dynamic_cast,
#   which -fno-rtti rules out.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-macro-parentheses,
  -bugprone-narrowing-conversions,
  -bugprone-branch-clone,
  -bugprone-signed-bitwise,
  -bugprone-signed-char-misuse,
  -bugprone-throwing-static-initialization,
  cppcoreguidelines-slicing,
  misc-const-correctness,
  misc-misplaced-const,
  modernize-deprecated-headers,
  modernize-loop-convert,
  modernize-make-unique,
  modernize-raw-string-literal,
  modernize-redundant-void-arg,
  modernize-use-bool-literals,
  modernize-use-emplace,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-ranges,
  modernize-use-starts-ends-with,
  modernize-use-std-numbers,
  modernize-use-using,
  performance-*,
  -performance-avoid-endl,
  -performance-no-int-to-ptr,
  readability-container-contains,
  readability-misleading-indentation,
  readability-redundant-smartptr-get
WarningsAsErrors: '*'
CheckOptions:
  # Pointee constness: its fix-its don't compile where a pointer is passed on
  # as mutable, and the runtime's C APIs take mutable pointers throughout.
  misc-const-correctness.AnalyzePointers: false
HeaderFilterRegex: '^.*/(src|include)/(?!s7|linenoise).*'
