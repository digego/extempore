# extempore binary executable
extempore
extempore.exe
extempore.lib
extempore.so
extempore.dll
extempore.dylib
libextempore.so

# local dev state (per-session assistants, sanitizer builds)
.remember/
/build-asan/
/build-ubsan/
/build-tsan/

# cmake & other build tools
/build
/Testing
/out # this is where MSVS puts the CMake build stuff

# AOT-compiled libraries
/libs/aot-cache

# Windows dlls/libs
/libs/platform-shlibs
extempore.pdb
extempore.ilk

# assets
/assets

# extempore scratch file
/scratch.xtm

# igore emacs # files
\#*#

# DS_Store
.DS_Store

# Astro docs
docs/node_modules/
docs/dist/
docs/.astro/

# llvm
/llvm

# vscode
.vscode

#visual studio
.vs
CMakeSettings.json

# ignore any xtm files in top level extempore dir
/*.xtm

# ignore any dlls at the top level
/*.dll

# ignore any video files at the top level
/*.avi
/*.mp4
/*.wmv

# ignore images at the top level
/*.png
/*.jpeg
/*.jpg

# ignore any dat files and log files at top level
/*.dat
/*.log

# ignore data
/data

# ignore toml (except mise.toml)
/*.toml
!mise.toml

# ccls is a clang-based LSP server
.ccls-cache/*

# ignore config
config.txt
