;;; audio_player.xtm -- a simple audio file player example

;; Author: Ben Swift
;; Keywords: extempore
;; Required dylibs:

;;; Commentary:

;; This reads assets/samples/xmas_carol.wav, which comes with the assets
;; (build the `assets` target, or configure with -DASSETS=ON). An AudioBuffer
;; (see libs/core/audiobuffer.xtm) does the same job with less code; this shows
;; reading a file into a buffer of your own.

;;; Code:

(sys:load "libs/core/audiofile.xtm")

(bind-func dsp:DSP
  (let ((audio_file_path "assets/samples/xmas_carol.wav")
        ;; get number of channels/frames in file
        (nchan (audiofile_channels audio_file_path))
        (nframes (audiofile_frames audio_file_path))
        (nsamp (* nchan nframes))
        ;; allocate memory buffer for audio samples
        (audio_data:SAMPLE* (zalloc nsamp))
        ;; read audio samples into buffer
        (frames_read (audiofile_read audio_file_path audio_data 0 nframes))
        ;; markers for keeping track of playback position
        (playhead 0)
        (i 0))
    (if (< frames_read 0)
        (printf "Error reading audio file.\n"))
    (lambda (in time chan dat)
      ;; increment playhead (this is the most basic playback possible
      ;; - it's not channel aware, it just steps through the buffer
      ;; one sample at a time)
      (set! playhead (modulo (+ playhead 1) nsamp))
      ;; play audio
      (* 1.0 (pref audio_data playhead)))))

;; now set the dsp closure to start the audio
(dsp:set! dsp)
