;;; portmidi.xtm:examples -- portmidi example

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; A simple MIDI output example using portmidi - helpful if you only
;; want to send MIDI messages to other devices (and don't need to
;; recieve any MIDI messages in Extempore)

;;; Code:

(sys:load "libs/external/portmidi.xtm")

(pm_initialize)

;; call this function to print a list of the MIDI devices on your
;; machine
(pm_print_devices)

;; bail out if no MIDI output is available (e.g. in CI)
(if (= (pm_default_out) -1)
    (begin (println "no MIDI output found, exiting") (quit 0)))

;; create an output stream (which we will send our midi output from) on the
;; first output device. To use another, put its device id here in place of
;; (pm_default_out):
(define *mout* (pm_create_output_stream (pm_default_out)))

;; now, let's send a midi message with the usual arguments

;;              time  stream pitch          velocity       duration channel
(play-midi-note (now) *mout* (random 60 72) (random 60 90) 44100    0)

(define midi-loop
  (lambda (beat dur)
    (mplay *mout* (random (list 60 60 60 67 70 74 75)) (random 60 80) dur 0)
    (callback (*metro* (+ beat (* .5 dur))) 'midi-loop (+ beat dur) dur)))

(midi-loop (*metro* 'get-beat 4) 1/4)
