;;
;; compile a trivial native console app
;;
;;  ./extempore.exe compile --exe ./examples/core/native_app_with_xtm.xtm
;;
;; after a successful compilation you should find native_app.exe in libs/builds/
;; in the cache directory (sys:cache-dir), which is build/libs/ for a source build
;;
;; <cache dir>/builds/native_app_with_xtm.exe hello native extempore
;;

(sys:load "libs/base/base.xtm")

(bind-func run
  (lambda (args:i32 argv:i8**)
    (extempore_init args argv)
    0:i32))
