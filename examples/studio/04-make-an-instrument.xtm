;;; 04-make-an-instrument.xtm -- write an instrument of your own

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; The studio's instruments are ordinary xtlang, one file each, in
;; libs/studio/instruments. This file builds one from scratch, and then
;; improves it while it plays. libs/studio/README.md has the full story.
;;
;; Evaluate it one expression at a time.

;;; Code:

(sys:load "libs/studio/studio.xtm")
(studio:start)

;; First, describe the instrument: its name, a line about it, its parameters
;; (name, default, description) and some presets.
(def-instrument beep
  "a sine wave with a click-free envelope"
  (params
   (attack 0.005 "seconds to fade in")
   (release 0.3 "seconds to fade out after the note ends")
   (level 0.25 "output level"))
  (presets
   (short (release 0.05))
   (long (attack 0.2) (release 1.5))))

;; Then say what one voice sounds like. beep_voice_c makes a voice: a closure
;; which is called once per frame of audio for as long as its note sounds. It
;; keeps its own state (here, the oscillator's phase and the envelope's
;; level), reads the note from v, and adds its output to the stereo frame out.
(bind-func beep_voice_c
  (lambda (p:SAMPLE*)
    (let ((phase:SAMPLE 0.0)
          (env:SAMPLE 0.0)
          (rate:SAMPLE 0.0))
      (lambda (v:Voice* out:SAMPLE*)
        ;; a new note: start the wave from the beginning
        (if (voice_start? v)
            (set! phase 0.0))
        ;; move the phase on by one frame's worth of the note's frequency
        (set! phase (+ phase (/ (voice_freq v) SRf)))
        (if (>= phase 1.0) (set! phase (- phase 1.0)))
        ;; glide the envelope towards the gate: up while the note is held,
        ;; down once it's released
        (set! rate (smoothing_coeff (if (> (voice_gate v) 0.5) (beep_attack p) (beep_release p))))
        (set! env (+ env (* rate (- (voice_gate v) env))))
        (frame_add out (* (beep_level p) (voice_vel v) env (sin (* STWOPI phase))))
        ;; once the note has been released and has faded out, free the voice
        (if (and (< (voice_gate v) 0.5) (< env 0.001))
            (voice_done v))
        void))))

;; Last, make the instrument: eight voices, each with a voice function and
;; its own copy of the parameters (so that each note can have its own).
(bind-func beep_make
  (lambda ()
    (let ((inst (inst_make "beep" 8 (beep_nparams)))
          (i:i64 0))
      (beep_defaults (inst_params inst))
      (dotimes (i 8)
        (inst_set_voice inst i (beep_voice_c (inst_voice_params inst i))))
      inst)))

;; It's an instrument like any other.
(track 'lead 'beep)
(ctl 'lead 'reverb 0.3)

(d1 (note (scale 'c4 'pentatonic '(0 2 4 <7 5> 4 2 <9 8> 4)))
    (sound 'lead)
    (off 1/8 (add (note 12))))

(preset 'lead 'short)
(ctl 'lead 'release 0.6)

;; Now change it while it plays. A sine wave is a bit plain, so this version
;; bends the sine by feeding it back into its own phase (a cheap way to add
;; harmonics), more when the note is played harder, with a new parameter to
;; say how much.
(def-instrument beep
  "a sine wave which gets brighter the harder it's played"
  (params
   (attack 0.005 "seconds to fade in")
   (release 0.3 "seconds to fade out after the note ends")
   (bite 0.6 "how much brighter loud notes are, 0.0 to 1.0")
   (level 0.25 "output level"))
  (presets
   (short (release 0.05))
   (long (attack 0.2) (release 1.5))
   (soft (bite 0.0))))

(bind-func beep_voice_c
  (lambda (p:SAMPLE*)
    (let ((phase:SAMPLE 0.0)
          (env:SAMPLE 0.0)
          (rate:SAMPLE 0.0)
          (last:SAMPLE 0.0))
      (lambda (v:Voice* out:SAMPLE*)
        (if (voice_start? v)
            (set! phase 0.0))
        (set! phase (+ phase (/ (voice_freq v) SRf)))
        (if (>= phase 1.0) (set! phase (- phase 1.0)))
        (set! rate (smoothing_coeff (if (> (voice_gate v) 0.5) (beep_attack p) (beep_release p))))
        (set! env (+ env (* rate (- (voice_gate v) env))))
        ;; the last output nudges the phase: more with velocity, less as the
        ;; note fades
        (set! last (sin (+ (* STWOPI phase) (* 1.5 (beep_bite p) (voice_vel v) env last))))
        (frame_add out (* (beep_level p) (voice_vel v) env last))
        (if (and (< (voice_gate v) 0.5) (< env 0.001))
            (voice_done v))
        void))))

;; beep_make has to be compiled again, because it's what calls beep_voice_c
;; and (beep_nparams) ...
(bind-func beep_make
  (lambda ()
    (let ((inst (inst_make "beep" 8 (beep_nparams)))
          (i:i64 0))
      (beep_defaults (inst_params inst))
      (dotimes (i 8)
        (inst_set_voice inst i (beep_voice_c (inst_voice_params inst i))))
      inst)))

;; ... and the track has to be told to make itself a new one
(reload 'lead)

(d1 (note (scale 'c4 'pentatonic '(0 2 4 <7 5> 4 2 <9 8> 4)))
    (sound 'lead)
    (vel (between 0.3 1.0 (slow 2 sine)))
    (off 1/8 (add (note 12))))

;; a parameter in a pattern belongs to its note: here each note has its own
;; release, and the long ones ring on over the short ones
(d1 (note (scale 'c4 'pentatonic '(0 2 4 <7 5> 4 2 <9 8> 4)))
    (sound 'lead)
    (param 'release '(0.05 0.05 1.5 0.05)))

(hush)

;; To keep an instrument, put it in a file of its own in
;; libs/studio/instruments (acid.xtm is a good one to copy). Then
;; (instruments) lists it and (track 'x 'its-name) loads it.
