;;; vibraphone.xtm -- a tour of the vibraphone's presets

;; Evaluate the whole file to hear each preset play the same phrase, or
;; render it to a file:
;;
;;   extras/studio/render examples/studio/demos/vibraphone.xtm /tmp/vibraphone.wav 40

(sys:load "libs/studio/studio.xtm")

(score-begin)
(track 'vibraphone 'vibraphone)
(score-ctl 0 'vibraphone 'reverb 0.15)

;; the phrase, a note every 0.25 seconds
(define vibraphone-demo-notes '(65 69 72 76 74 72 69 67))

(define vibraphone-demo-phrase
  (lambda (start)
    (let loop ((i 0) (notes vibraphone-demo-notes))
      (if (pair? notes)
          (begin
            (score-note (+ start (* i 0.25)) 'vibraphone (car notes)
                        (+ 0.6 (* 0.4 (/ (modulo (* i 5) 8) 7.0))) 0.4)
            (loop (+ i 1) (cdr notes)))))))

;; the phrase twice for each preset
(let loop ((start 0.0) (names (presets 'vibraphone)))
  (if (pair? names)
      (begin
        (score-preset start 'vibraphone (car names))
        (vibraphone-demo-phrase start)
        (vibraphone-demo-phrase (+ start 3.0))
        (loop (+ start 6) (cdr names)))))

(score-end)
