;;; violins.xtm -- a tour of the violins's presets

;; Evaluate the whole file to hear each preset play the same phrase, or
;; render it to a file:
;;
;;   extras/studio/render examples/studio/demos/violins.xtm /tmp/violins.wav 40

(sys:load "libs/studio/studio.xtm")

(score-begin)
(track 'violins 'violins)
(score-ctl 0 'violins 'reverb 0.15)

;; the phrase, a note every 1.0 seconds
(define violins-demo-notes '(67 69 71 72))

(define violins-demo-phrase
  (lambda (start)
    (let loop ((i 0) (notes violins-demo-notes))
      (if (pair? notes)
          (begin
            (score-note (+ start (* i 1.0)) 'violins (car notes)
                        (+ 0.6 (* 0.4 (/ (modulo (* i 5) 8) 7.0))) 0.9)
            (loop (+ i 1) (cdr notes)))))))

;; the phrase for each preset
(let loop ((start 0.0) (names (presets 'violins)))
  (if (pair? names)
      (begin
        (score-preset start 'violins (car names))
        (violins-demo-phrase start)
        (loop (+ start 6) (cdr names)))))

(score-end)
