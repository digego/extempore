;;; organ.xtm -- a tour of the tonewheel organ's presets

;; Evaluate the whole file to hear each preset play something which suits
;; it, or render it to a file:
;;
;;   extras/studio/render examples/studio/demos/organ.xtm /tmp/organ.wav 42
;;
;; Listen for the rotary speaker changing speed: the gospel chords start on
;; the slow "chorale" setting and switch to fast "tremolo" mid-phrase, the
;; rock riff ends on a chord which slows down, and the ballad's last chord
;; speeds up. The horn gets there in about a second, the drum takes several.

(sys:load "libs/studio/studio.xtm")

(score-begin)
(track 'org 'organ)
(track 'lower 'organ)
(score-ctl 0 'org 'reverb 0.12)
(score-ctl 0 'lower 'reverb 0.12)

;; play a list of (beat pitches beats) on a track from `start`, with `beat`
;; seconds per beat. pitches is a list, so one entry can be a chord.
(define organ-demo-play
  (lambda (track start beat events)
    (for-each (lambda (e)
                (for-each (lambda (pitch)
                            (score-note (+ start (* beat (car e))) track pitch 0.8 (* beat (caddr e))))
                          (cadr e)))
              events)))

;; jazz: a bluesy line over shell voicings. On a B-3 the percussion is on
;; the upper manual only, so the left hand comps on a second organ track (the
;; lower manual) with percussion off. The line is played detached, so each
;; note pings; a note played legato wouldn't.
(score-preset 0.0 'org 'jazz)
(score-preset 0.0 'lower 'jazz)
(score-ctl 0.0 'lower 'perc 0.0)
(score-ctl 0.0 'lower 'drawbar2 4.0)
(organ-demo-play 'lower 0.0 0.3
  '((0 (53 57 63) 1.5) (2 (53 57 63) 0.6) (3.5 (58 62 68) 1.5) (6 (58 62 68) 0.6)
    (8 (53 57 63) 1.5) (10 (55 60 65) 0.6) (11.5 (60 64 70) 2.0) (14 (53 57 63) 4.0)))
(organ-demo-play 'org 0.0 0.3
  '((0.5 (72) 0.4) (1 (75) 0.4) (1.5 (77) 0.4) (2 (78) 0.3) (2.5 (77) 0.4) (3 (75) 0.8)
    (4.5 (72) 0.4) (5 (70) 0.4) (5.5 (72) 1.2) (8 (77) 0.4) (8.5 (80) 0.4) (9 (81) 0.4)
    (9.5 (80) 0.4) (10 (77) 0.4) (10.5 (75) 0.4) (11 (72) 0.8) (12.5 (69) 0.4) (13 (70) 0.4)
    (14 (72) 3.0)))

;; gospel: full organ on held chords. The rotor starts slow and is switched
;; to fast halfway through the second chord.
(score-preset 6.5 'org 'gospel)
(score-ctl 6.5 'org 'speed 0.8)
(organ-demo-play 'org 6.5 0.5
  '((0 (44 56 60 63 68) 3.5) (4 (44 56 61 65 68) 3.5) (8 (44 56 60 63 68) 4.0)
    (0 (72) 1.5) (1.5 (75) 0.5) (2 (77) 1.5) (4 (80) 2.0) (6 (77) 1.0) (7 (75) 1.0)
    (8 (72) 4.0)))
(score-ctl 9.0 'org 'speed 6.7)

;; rock: a driven riff with the rotor fast, ending on a held chord which is
;; switched to slow
(score-preset 13.0 'org 'rock)
(organ-demo-play 'org 13.0 0.25
  '((0 (40 52 59 64) 1.5) (1.5 (43 55 62 67) 1.0) (3 (45 57 64 69) 1.0) (4 (45 57 64 69) 0.5)
    (5 (43 55 62 67) 0.5) (6 (40 52 59 64) 1.5) (8 (40 52 59 64) 1.5) (9.5 (43 55 62 67) 1.0)
    (11 (46 58 65 70) 0.75) (12 (45 57 64 69) 0.75) (13 (43 55 62 67) 0.75)
    (14 (40 52 59 64 71 76) 9.5)))
(score-ctl 18.0 'org 'speed 0.8)

;; ballad: soft flute-like chords with the chorus-vibrato, the last one
;; swelling into the fast rotor
(score-preset 20.0 'org 'ballad)
(organ-demo-play 'org 20.0 0.6
  '((0 (48 55 59 64) 2.0) (2 (45 52 55 60) 2.0) (4 (41 48 52 57) 2.0) (6 (43 50 55 59 62) 5.0)
    (0 (76) 1.0) (1 (74) 1.0) (2 (72) 1.5) (3.5 (71) 0.5) (4 (69) 1.0) (5 (72) 1.0)
    (6 (74) 5.0)))
(score-ctl 24.4 'org 'speed 6.7)

;; reggae: the "bubble", short chords off the beat over a bass line, with
;; the rotor stopped
(score-preset 27.5 'org 'reggae)
(let loop ((bar 0))
  (if (< bar 4)
      (let ((start (+ 27.5 (* bar 1.6)))
            (chord (if (even? bar) '(57 60 64) '(57 62 66)))
            (root (if (even? bar) 45 50)))
        (organ-demo-play 'org start 0.2
          (list (list 0 (list root) 0.8) (list 1 chord 0.5) (list 2 (list (+ root 7)) 0.8)
                (list 3 chord 0.5) (list 4 (list root) 0.8) (list 5 chord 0.5)
                (list 5.5 chord 0.4) (list 6 (list (+ root 12)) 0.8) (list 7 chord 0.5)))
        (loop (+ bar 1)))))

;; bright: crisp percussive stabs and a quick line, rotor fast
(score-preset 34.5 'org 'bright)
(organ-demo-play 'org 34.5 0.25
  '((0 (60 64 67) 0.5) (1.5 (60 64 67) 0.5) (3 (62 65 69) 0.75) (4 (60 64 67) 0.5)
    (6 (72) 0.4) (6.5 (74) 0.4) (7 (75) 0.4) (7.5 (76) 0.4) (8 (79) 0.75) (9 (76) 0.4)
    (10 (65 69 72) 0.5) (11.5 (65 69 72) 0.5) (13 (67 71 74) 0.75) (14 (60 64 67 72) 8.0)))

(score-end)
