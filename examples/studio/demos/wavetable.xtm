;;; wavetable.xtm -- a tour of the wavetable synth's presets

;; Evaluate the whole file to hear each preset play four bars (at 140 bpm) of
;; something which suits it, or render it to a file:
;;
;;   extras/studio/render examples/studio/demos/wavetable.xtm /tmp/wavetable.wav 72

(sys:load "libs/studio/studio.xtm")

(score-begin)
(track 'synth 'wavetable)
(score-ctl 0 'synth 'reverb 0.12)

;; one beat at 140 bpm, and four bars: each preset plays a two-bar phrase twice
(define wt-beat (/ 60.0 140.0))
(define wt-section (* 16.0 wt-beat))

;; play a list of (beat pitches velocity beats) from `start`, where pitches is
;; a note number or a list of them (a chord)
(define wt-play
  (lambda (start events)
    (for-each
     (lambda (e)
       (let ((at (+ start (* wt-beat (car e))))
             (pitches (if (list? (cadr e)) (cadr e) (list (cadr e))))
             (dur (* wt-beat (cadddr e))))
         (for-each (lambda (p) (score-note at 'synth p (caddr e) dur)) pitches)))
     events)))

;; the same events, repeated every `period` beats, `times` times
(define wt-repeat
  (lambda (events period times)
    (let loop ((i 0) (acc '()))
      (if (= i times)
          acc
          (loop (+ i 1)
                (append acc (map (lambda (e) (cons (+ (car e) (* i period)) (cdr e))) events)))))))

(define wt-tour
  (list
   ;; reese: long, slowly beating bass notes
   (list 'reese '((0 33 1.0 2.8) (3 36 0.9 1) (4 31 1.0 3.8)))
   ;; supersaw: a lead riff over held chords
   (list 'supersaw '((0 (57 60 64) 0.9 3.8) (4 (53 57 60) 0.9 3.8)
                     (0 76 1.0 0.9) (1 79 0.9 0.9) (2 81 1.0 1.4) (4 79 0.9 0.9) (5 76 0.9 0.9) (6 72 1.0 1.8)))
   ;; pluck: a sixteenth-note arpeggio
   (list 'pluck (wt-repeat '((0 64 0.9 0.25) (0.5 67 0.7 0.25) (1 71 0.8 0.25) (1.5 76 0.7 0.25)
                             (2 74 0.9 0.25) (2.5 71 0.7 0.25) (3 67 0.8 0.25) (3.5 62 0.7 0.25))
                           4 2))
   ;; pad: two slow chords which open and move
   (list 'pad '((0 (48 55 64 71) 0.8 3.9) (4 (45 52 60 67) 0.8 3.6)))
   ;; bells: a high, sparse melody
   (list 'bells '((0 84 0.9 1) (1 91 0.8 1) (2 88 0.9 1) (3.5 86 0.7 0.5) (4 79 0.9 2) (6 83 0.8 1) (7 84 0.9 1)))
   ;; sync: a monophonic lead line, the sync sweeping on each note
   (list 'sync '((0 67 0.9 0.9) (1 70 0.9 0.4) (1.5 72 1.0 1.4) (3 75 0.9 0.9)
                 (4 74 1.0 1.4) (5.5 72 0.8 0.4) (6 70 0.9 1.9)))
   ;; formant: a slow, vocal melody
   (list 'formant '((0 69 0.9 1.9) (2 72 0.9 0.9) (3 74 0.8 0.9) (4 76 1.0 2.9) (7 74 0.8 0.9)))
   ;; wobble: bass notes under a wobble whose rate changes each bar (see below)
   (list 'wobble '((0 31 1.0 1.9) (2 31 1.0 1.9) (4 34 1.0 1.9) (6 29 1.0 1.9)))
   ;; growl: a busy talking bassline
   (list 'growl (wt-repeat '((0 33 1.0 0.45) (0.5 33 0.8 0.45) (1 36 1.0 0.7) (1.75 33 0.8 0.2)
                             (2 31 1.0 0.95) (3 38 0.9 0.45) (3.5 36 0.8 0.45))
                           4 2))
   ;; strings: a chord progression
   (list 'strings '((0 (52 59 64 67) 0.8 1.9) (2 (53 60 64 69) 0.8 1.9)
                    (4 (55 62 67 71) 0.8 1.9) (6 (52 59 64 67) 0.8 1.9)))))

(let loop ((start 0.0) (sections wt-tour))
  (if (pair? sections)
      (begin
        (score-preset start 'synth (car (car sections)))
        (wt-play start (cadr (car sections)))
        (wt-play (+ start (* 8.0 wt-beat)) (cadr (car sections)))
        ;; the wobble's LFO follows the tempo, a bar at a time: quarter
        ;; notes, eighths, dotted quarters, then eighths again
        (if (eq? (car (car sections)) 'wobble)
            (begin
              (score-ctl (+ start (* 4.0 wt-beat)) 'synth 'lfo-rate 4.667)
              (score-ctl (+ start (* 8.0 wt-beat)) 'synth 'lfo-rate 1.556)
              (score-ctl (+ start (* 12.0 wt-beat)) 'synth 'lfo-rate 4.667)))
        (loop (+ start wt-section) (cdr sections)))))

(score-end)
