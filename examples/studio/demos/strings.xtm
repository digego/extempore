;;; strings.xtm -- a tour of the string machine's presets

;; Evaluate the whole file to hear each preset in turn, or render it to a file:
;;
;;   extras/studio/render examples/studio/demos/strings.xtm /tmp/strings.wav 62

(sys:load "libs/studio/studio.xtm")

(score-begin)
(track 'strings 'strings)
(score-ctl 0 'strings 'reverb 0.25)
;; string machines are played in big chords: leave the master bus some room
(score-ctl 0 'strings 'gain 0.7)

;; play each chord in a list of (start seconds pitches...), every note held
;; for `dur` seconds
(define strings-demo-chords
  (lambda (start dur vel chords)
    (for-each (lambda (chord)
                (for-each (lambda (pitch)
                            (score-note (+ start (car chord)) 'strings pitch vel dur))
                          (cdr chord)))
              chords)))

;; classic: a minor-key progression, the upper voices moving by step
(score-preset 0.0 'strings 'classic)
(strings-demo-chords 0.0 1.7 0.8
                     '((0.0 45 57 60 64) (1.75 41 57 60 65) (3.5 48 55 60 64) (5.25 43 55 59 62)))

;; cellos: a low line (the cello register sounds an octave below the key),
;; each note overlapping the next a little
(score-preset 7.5 'strings 'cellos)
(let loop ((t 7.5) (line '(50 53 57 55 53 52 50 45)))
  (if (pair? line)
      (begin
        (score-note t 'strings (car line) 0.8 (if (null? (cdr line)) 1.4 0.95))
        (loop (+ t 0.85) (cdr line)))))

;; violins: a high line in sixths over a held fifth
(score-preset 15.0 'strings 'violins)
(strings-demo-chords 15.0 6.0 0.7 '((0.0 62 69)))
(strings-demo-chords 15.0 1.45 0.8
                     '((0.0 72 81) (1.5 74 83) (3.0 76 84) (4.5 74 81)))

;; phased: two long chords, so the phaser has time to sweep
(score-preset 22.0 'strings 'phased)
(strings-demo-chords 22.0 3.4 0.8
                     '((0.0 43 59 62 67) (3.5 40 59 64 67)))

;; pad: a slow swell and a long tail
(score-preset 29.0 'strings 'pad)
(strings-demo-chords 29.0 3.0 0.8
                     '((0.0 48 60 64 67 71) (3.0 41 60 65 69 72)))

;; brassy: short stabs, the accents played harder
(score-preset 36.5 'strings 'brassy)
(let loop ((stabs '((0.0 0.3 1.0 46 58 62 65) (0.5 0.2 0.7 46 58 62 65)
                    (1.0 0.6 0.9 48 60 64 67) (2.0 0.3 1.0 50 57 62 65)
                    (2.5 0.2 0.7 50 57 62 65) (3.0 0.9 0.9 48 55 60 64)
                    (4.5 0.3 1.0 46 58 62 65) (5.0 1.3 0.9 48 58 64 67))))
  (if (pair? stabs)
      (let ((s (car stabs)))
        (for-each (lambda (pitch)
                    (score-note (+ 36.5 (car s)) 'strings pitch (caddr s) (cadr s)))
                  (cdddr s))
        (loop (cdr stabs)))))

;; chamber: a chorale, one chord a second
(score-preset 44.0 'strings 'chamber)
(strings-demo-chords 44.0 0.95 0.8
                     '((0.0 48 55 64 72) (1.0 47 55 62 74) (2.0 45 57 64 72) (3.0 41 57 65 69)
                       (4.0 43 55 62 71) (5.0 36 55 64 72)))

;; jet: one chord, swept by a slow, deep phaser with lots of feedback
(score-preset 51.0 'strings 'jet)
(strings-demo-chords 51.0 7.0 0.8 '((0.0 50 62 69 72 76)))

(score-end)
