;;; resonator.xtm -- a tour of the resonator's presets

;; Evaluate the whole file to hear each preset play a phrase which suits it,
;; or render it to a file:
;;
;;   extras/studio/render examples/studio/demos/resonator.xtm /tmp/resonator.wav 64

(sys:load "libs/studio/studio.xtm")

(score-begin)
(track 'res 'resonator)
(score-ctl 0 'res 'reverb 0.15)

;; each phrase is a list of (beat pitch velocity beats), at 0.2 seconds a beat
(define resonator-demo-beat 0.2)

(define resonator-demo-phrases
  '((marimba
     (0 60 0.8 1) (1 64 0.6 1) (2 67 0.7 1) (3 72 0.6 1) (4 76 0.9 1) (5 72 0.6 1)
     (6 67 0.7 1) (7 64 0.6 1) (8 62 0.8 1) (9 65 0.6 1) (10 69 0.7 1) (11 74 0.6 1)
     (12 77 0.9 1) (13 74 0.6 1) (14 69 0.7 1) (15 65 0.6 1) (16 48 0.9 4) (16 60 0.8 4)
     (20 55 0.7 2) (22 52 0.7 2) (24 48 1.0 4))
    (vibes
     (0 53 0.6 6) (0 57 0.6 6) (0 60 0.6 6) (0 64 0.7 6)
     (8 52 0.6 6) (8 55 0.6 6) (8 59 0.6 6) (8 62 0.7 6)
     (16 50 0.6 2) (16 53 0.6 10) (16 57 0.6 10) (16 60 0.7 10) (18 72 0.5 2) (20 69 0.5 2) (22 67 0.6 4))
    (bell
     (0 48 1.0 2) (6 55 0.8 2) (12 52 0.9 2) (18 43 1.0 2))
    (kalimba
     (0 60 0.7 1) (1 67 0.6 1) (2 64 0.7 1) (3 72 0.6 1) (4 69 0.7 2) (6 67 0.6 1)
     (7 64 0.6 1) (8 62 0.7 2) (10 60 0.8 2) (12 55 0.6 1) (13 60 0.7 1) (14 64 0.7 1)
     (15 67 0.6 1) (16 69 0.8 2) (18 72 0.7 2) (20 60 0.9 4))
    (glass
     (0 84 0.7 2) (3 91 0.6 2) (6 88 0.7 2) (9 96 0.5 2) (12 79 0.8 2) (15 86 0.6 2) (18 84 0.7 4))
    (pan
     (0 67 0.8 1) (1 67 0.6 1) (2 72 0.8 1) (3 71 0.6 1) (4 69 0.8 2) (6 67 0.7 1)
     (7 64 0.7 1) (8 65 0.8 1) (9 67 0.6 1) (10 69 0.8 2) (12 67 0.7 1) (13 64 0.6 1)
     (14 60 0.8 2) (16 62 0.7 1) (17 64 0.7 1) (18 60 0.9 4))
    (harp
     (0 48 0.7 8) (1 52 0.6 8) (2 55 0.6 8) (3 60 0.6 8) (4 64 0.6 8) (5 67 0.6 8)
     (6 72 0.6 8) (7 76 0.7 8) (8 79 0.7 8) (12 45 0.7 8) (13 52 0.6 8) (14 57 0.6 8)
     (15 60 0.6 8) (16 64 0.6 8) (17 69 0.7 8) (18 72 0.7 8) (19 76 0.8 8))
    (koto
     (0 62 0.8 3) (3 63 0.6 1) (4 67 0.8 3) (7 69 0.6 1) (8 70 0.9 4) (12 69 0.6 1)
     (13 67 0.7 1) (14 63 0.7 2) (16 62 0.9 2) (18 50 0.8 6))
    (sitar
     (0 38 0.6 24) (0 50 0.8 3) (3 52 0.6 1) (4 53 0.8 2) (6 55 0.7 2) (8 57 0.9 4)
     (12 55 0.6 1) (13 53 0.6 1) (14 52 0.7 2) (16 50 0.9 6))
    (dulcimer
     (0 62 0.8 1) (0.5 62 0.5 1) (1 66 0.7 1) (1.5 66 0.5 1) (2 69 0.8 1) (2.5 69 0.5 1)
     (3 74 0.9 2) (5 73 0.6 1) (6 71 0.7 1) (7 69 0.7 1) (8 67 0.8 1) (8.5 67 0.5 1)
     (9 66 0.7 1) (9.5 66 0.5 1) (10 64 0.7 1) (11 62 0.9 4) (11 50 0.8 4))))

(define resonator-demo-phrase
  (lambda (start notes)
    (for-each (lambda (n)
                (score-note (+ start (* resonator-demo-beat (car n)))
                            'res (cadr n) (caddr n) (* resonator-demo-beat (cadddr n))))
              notes)))

;; six seconds of each preset
(let loop ((start 0.0) (names (presets 'resonator)))
  (if (pair? names)
      (begin
        (score-preset start 'res (car names))
        (resonator-demo-phrase (+ start 0.05) (cdr (assoc (car names) resonator-demo-phrases)))
        (loop (+ start 6.0) (cdr names)))))

(score-end)
