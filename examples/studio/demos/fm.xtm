;;; fm.xtm -- a tour of the FM synth's presets

;; Evaluate the whole file to hear each preset play something which suits
;; it, or render it to a file:
;;
;;   extras/studio/render examples/studio/demos/fm.xtm /tmp/fm.wav 53

(sys:load "libs/studio/studio.xtm")

(score-begin)
;; two tracks take turns, so that each preset's last notes ring out while the
;; next one starts
(track 'fm-a 'fm)
(track 'fm-b 'fm)
;; one note peaks around -12 dBFS, and the chords here have up to five
(score-ctl 0 'fm-a 'gain 0.7)
(score-ctl 0 'fm-b 'gain 0.7)

;; play a list of (beat pitch velocity beats) on a track, starting at `start`
;; seconds, with `beat` seconds to a beat
(define fm-demo-play
  (lambda (track start beat notes)
    (for-each (lambda (n)
                (score-note (+ start (* beat (car n))) track (cadr n) (caddr n) (* beat (cadddr n))))
              notes)))

;; a chord: every pitch at once (or spread by `strum` beats), with the same
;; velocity and length
(define fm-demo-chord
  (lambda (at pitches vel beats strum)
    (let loop ((ps pitches) (t at) (acc '()))
      (if (null? ps)
          (reverse acc)
          (loop (cdr ps) (+ t strum) (cons (list t (car ps) vel beats) acc))))))

(define fm-demo-section
  (lambda (start track preset reverb)
    (score-preset start track preset)
    (score-ctl start track 'reverb reverb)))

;; epiano (0 s): a ii-V-I in F, the chords rolled a little
(fm-demo-section 0.0 'fm-a 'epiano 0.2)
(fm-demo-play 'fm-a 0.0 0.6
              (append (fm-demo-chord 0 '(43 58 62 65 69) 0.75 2.5 0.03)
                      (fm-demo-chord 3 '(36 58 62 64 69) 0.6 2.5 0.03)
                      '((5.5 72 0.8 0.5) (6 74 0.7 0.5))
                      (fm-demo-chord 6.5 '(41 57 60 64 67) 0.85 4.5 0.04)
                      '((8.5 76 0.6 0.5) (9 79 0.7 2))))

;; bass (7 s): a syncopated line in E minor, sixteenths at 110 bpm. The
;; loudest notes are the octave pops, which velocity makes brighter.
(fm-demo-section 7.0 'fm-b 'bass 0.05)
(define fm-demo-bassline
  '((0 28 0.95 1.5) (3 40 0.85 0.5) (4 28 0.7 1) (6 31 0.8 1) (7 33 0.85 0.7)
    (8 35 0.9 1.5) (10 47 1.0 0.5) (11 35 0.6 0.7) (12 38 0.9 1.5) (14 40 1.0 0.5) (15 38 0.7 0.7)))
(dotimes (bar 3)
  (fm-demo-play 'fm-b (+ 7.0 (* bar 16 0.136)) 0.136 fm-demo-bassline))

;; bells (13.5 s): a slow peal, in arpeggios
(fm-demo-section 13.5 'fm-a 'bells 0.35)
(fm-demo-play 'fm-a 13.5 0.45
              '((0 72 0.9 1) (1 67 0.7 1) (2 64 0.75 1) (3 60 0.9 2)
                (5 64 0.8 1) (6 72 0.7 1) (7 67 0.8 1) (8 60 1.0 2)
                (10 72 0.7 1) (11 76 0.8 1) (12 79 0.9 3)))

;; marimba (20 s): rippling sixteenths over four chords
(fm-demo-section 20.0 'fm-b 'marimba 0.15)
(let loop ((chords '((57 60 64 69) (53 57 60 65) (55 59 62 67) (52 55 59 64))) (beat 0))
  (if (pair? chords)
      (let ((c (car chords)))
        (fm-demo-play 'fm-b 20.0 0.14
                      (list (list beat (- (car c) 12) 0.9 1)
                            (list (+ beat 1) (cadr c) 0.6 1) (list (+ beat 2) (caddr c) 0.7 1)
                            (list (+ beat 3) (cadddr c) 0.8 1) (list (+ beat 4) (+ (cadr c) 12) 0.9 1)
                            (list (+ beat 5) (cadddr c) 0.6 1) (list (+ beat 6) (caddr c) 0.7 1)
                            (list (+ beat 7) (cadr c) 0.6 1)))
        (loop (cdr chords) (+ beat 8)))))

;; brass (25 s): stabs, then a swell into a held chord with vibrato
(fm-demo-section 25.0 'fm-a 'brass 0.2)
(fm-demo-play 'fm-a 25.0 0.5
              (append (fm-demo-chord 0 '(46 58 62 65) 0.95 0.4 0)
                      (fm-demo-chord 1 '(46 58 62 65) 0.8 0.4 0)
                      (fm-demo-chord 2.5 '(48 60 63 67) 0.9 0.6 0)
                      (fm-demo-chord 3.5 '(51 58 63 67) 0.85 1.2 0)
                      (fm-demo-chord 5 '(53 60 65 69) 0.7 0.4 0)
                      (fm-demo-chord 6 '(46 58 62 65 70) 0.9 5 0)))

;; organ (31.5 s): held gospel chords over a walking left hand
(fm-demo-section 31.5 'fm-b 'organ 0.15)
(fm-demo-play 'fm-b 31.5 0.5
              (append (fm-demo-chord 0 '(60 64 67 72) 0.8 2.9 0)
                      (fm-demo-chord 3 '(60 65 69 72) 0.8 2.9 0)
                      (fm-demo-chord 6 '(59 62 65 67) 0.8 1.9 0)
                      (fm-demo-chord 8 '(60 64 67 72) 0.8 3.5 0)
                      '((0 36 0.8 1.9) (2 40 0.8 0.9) (3 41 0.8 1.9) (5 45 0.8 0.9)
                        (6 43 0.8 1.9) (8 36 0.8 3.5))))

;; clav (37 s): a funky sixteenth-note riff in D minor, damped short
(fm-demo-section 37.0 'fm-a 'clav 0.05)
(define fm-demo-riff
  '((0 50 1.0 0.6) (2 53 0.7 0.4) (3 50 0.6 0.4) (4 55 0.9 0.6) (6 53 0.6 0.4)
    (7 57 0.8 0.4) (8 50 1.0 0.6) (10 60 0.9 0.4) (11 57 0.6 0.4) (12 55 0.8 0.6)
    (14 53 0.7 0.4) (15 52 0.6 0.4)))
(dotimes (bar 2)
  (fm-demo-play 'fm-a (+ 37.0 (* bar 16 0.14)) 0.14 fm-demo-riff))

;; glass (42 s): two slow chords, each left to swell
(fm-demo-section 42.0 'fm-b 'glass 0.35)
(fm-demo-play 'fm-b 42.0 1.0
              (append (fm-demo-chord 0 '(48 55 64 71) 0.7 3.6 0.1)
                      (fm-demo-chord 4 '(45 52 60 67) 0.7 4 0.1)))

(score-end)
