;;; jazz.xtm -- a piano trio with vibraphone

;; Author: Ben Swift
;; Keywords: extempore

;;; Commentary:

;; Sampled instruments: the Salamander grand piano and drum kit, an electric
;; bass and a vibraphone. A ii-V-I-VI in B flat at 132 bpm, swung, with the
;; ride cymbal carrying the time, a walking bass, and a vibraphone which
;; improvises (a different line every time the pattern's random seed
;; changes).
;;
;; This piece needs the sample libraries in the assets folder.
;;
;;   extras/studio/render examples/studio/songs/jazz.xtm /tmp/jazz.wav 45

;;; Code:

(sys:load "libs/studio/studio.xtm")

(score-begin)
(bpm 132)

(track 'drums 'drumkit)
(track 'bass 'bass-guitar)
(track 'piano 'piano)
(track 'vibes 'vibraphone)

(ctl 'drums 'gain 3.0 'reverb 0.12)
(ctl 'bass 'gain 1.1 'lpf 1500)
(ctl 'piano 'gain 1.8 'reverb 0.2 'pan 0.4)
(ctl 'vibes 'gain 1.0 'reverb 0.3 'pan 0.62)
(master 'reverb-size 0.5 'reverb-damping 0.5)

;; swing: the second eighth note of each beat is late, by a third of a beat
(define jazz-swing (swing 1/3 4))

;; C minor 7, F7, B flat major 7 and G7: rootless voicings for the left hand
(define jazz-chords
  '#(<eb3 eb3 d3 f3> <g3 a3 f3 ab3> <bb3 c4 a3 b3> <d4 d4 c4 eb4>))

;; spang-a-lang on the ride, the hi-hat pedal on two and four
(define jazz-time
  (stack (with (sound '(rd (rd rd) rd (rd rd))) (vel '(0.7 0.6 0.45)) jazz-swing)
         (with (sound '(~ ph ~ ph)) (vel 0.5))
         (with (sound '(~ ~ ~ <~ (~ sd)>)) (vel 0.35) jazz-swing)
         (with (sound '(<bd ~> ~ ~ ~)) (vel 0.4))))

;; a walking line: four to the bar, a chord tone on each beat and a step
;; into the next root
(define jazz-walk
  (with (note '(<(c2 eb2 g2 e2) (f2 a2 c3 a2) (bb1 d2 f2 a2) (g2 b2 d2 db2)>))
        (sound 'bass)
        (vel '(0.8 0.65 0.7 0.65))
        (legato 0.9)))

;; comping: the chord on the "and" of two, and sometimes again before the bar
(define jazz-comp
  (with (note jazz-chords)
        (struct '(~ ~ ~ t ~ ~ <~ t> ~))
        (sound 'piano)
        (vel '(0.5 0.4))
        (legato 0.6)
        jazz-swing))

(score-pattern 0 2 (note jazz-chords) (struct '(t ~ ~ t ~ ~ ~ ~)) (sound 'piano) (vel 0.5) (legato 1.5)
               jazz-swing)
(score-pattern 2 24 jazz-time)
(score-pattern 2 24 jazz-walk)
(score-pattern 2 24 jazz-comp)

;; the solo: eighth notes picked at random from the B flat major scale, half
;; of them left out, on the vibraphone and then the piano's right hand
(score-pattern 6 14
               (note (scale 'bb4 'major (segment 8 (irand 9))))
               (sound 'vibes) (degrade-by 0.45) (vel (between 0.4 0.8 rand)) (legato 1.5) jazz-swing)
(score-pattern 14 22
               (note (scale 'bb4 'major (segment 8 (irand 10))))
               (sound 'piano) (degrade-by 0.4) (vel (between 0.45 0.85 rand)) (legato 0.9) jazz-swing)

(score-pattern 24 25 (note '#(bb1 d3 a3 c4 f4)) (sound 'piano) (vel 0.6) (legato 2))
(score-pattern 24 25 (note 'bb1) (sound 'bass) (vel 0.8) (legato 2))
(score-pattern 24 25 (sound '#(bd cr)) (vel 0.6))
(score-pattern 24 25 (note '#(d5 f5 a5)) (sound 'vibes) (vel 0.6) (legato 2))

(score-end)
