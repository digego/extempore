---
// Starlight's own /404 route is disabled in astro.config.ts, because it reads
// its body from a `404` entry in the docs collection and that entry then
// collides with the collection's own `[...slug]` route. Owning the page here
// keeps the Starlight chrome without the duplicate route.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    description: "The page you were looking for doesn't exist.",
    template: 'splash',
    editUrl: false,
  }}
>
  <p>
    That page isn't here. It may have moved, or the link that brought you here may be out of
    date.
  </p>
  <p>
    Try the <a href="/">documentation home page</a>, or use the search box above.
  </p>
  <p>
    If a link on this site brought you here, please <a
      href="https://github.com/digego/extempore/issues">open an issue</a
    >.
  </p>
</StarlightPage>
